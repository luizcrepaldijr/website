---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div>
  {text}
</div>

<style>
  div {
    border-radius: 32px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 8px 16px;
    text-transform: uppercase;
    color: #b6becd;
    font-family: Raleway;
    font-weight: 500;
  }
</style>
