---
interface Props {
    text: string;
}

const { text } = Astro.props;
---

<div>
    {text}
</div>

<style>
    div {
        border-radius: 32px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        padding: 10px 20px;
        color: #b6becd;
        font-family: Raleway;
        font-weight: 500;
        font-size: 18px;
    }

    @media only screen and (max-width: 800px) {
        div {
            font-size: 12px;
        }
    }
</style>
