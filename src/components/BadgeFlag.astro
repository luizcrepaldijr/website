---
import { Image } from "astro:assets";

interface Props {
    text?: string;
    image?: any;
}

const { text = "", image } = Astro.props;
---

<div>
    {image && <Image src={image} alt={text} class="flag-img" />}
    <span>{text}</span>
</div>

<style>
    div {
        display: flex;
        align-items: center;
        gap: 12px;
        width: fit-content;

        border-radius: 32px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        padding: 8px 16px;

        color: var(--neutral-white, #fcfcfd);
        font-family: var(--font-family-body, Raleway);
        font-size: var(--size-16, 16px);
        font-style: normal;
        font-weight: var(--weight-semibold, 600);
        line-height: 140%; /* 22.4px */
    }

    .flag-img {
        width: 28px;
        height: auto;
        border-radius: 2px;
        object-fit: cover;
    }

    @media only screen and (max-width: 800px) {
        div {
            font-size: 14px;
            padding: 6px 14px;
        }
    }
</style>
