---
import { Icon } from "astro-icon/components";
---

<div class="embla">
  <div class="embla__viewport">
    <div class="embla__container">
      <slot />
    </div>
  </div>

  <div class="embla__controls">
    <button class="embla__prev">
      <Icon name="arrow-left" />
    </button>
    <button class="embla__next">
      <Icon name="arrow-right" />
    </button>
  </div>
</div>

<style>
  .embla__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 30px;
    padding-left: 45px;
  }

  button {
    background-color: transparent;
    padding: 0;
    border: none;
    cursor: pointer;
  }

  button [data-icon] {
    font-size: 4vw;
  }

  button:hover [data-icon] {
    opacity: 0.8;
  }

  @media only screen and (max-width: 800px) {
    .embla__controls {
      margin-top: 20px;
      padding: 0;
      gap: 20px;
      justify-content: end;
    }

    button [data-icon] {
      font-size: 12vw;
    }
  }
</style>

<style is:global>
  .embla__viewport {
    overflow: hidden;
  }

  .embla__container {
    display: flex;
    touch-action: pan-y pinch-zoom;
  }

  .embla__slide {
    flex: 0 0 25%;
    min-width: 0;
  }

  @media only screen and (max-width: 767px) {
    .embla__slide {
      flex: 0 0 70%;
    }
  }

  .embla__controls {
    margin-top: 10px;
    display: flex;
    gap: 10px;
  }
</style>

<script>
  import EmblaCarousel from "embla-carousel";
  import Autoplay from "embla-carousel-autoplay";

  // Selecionamos todos para evitar erros se houver mais de um na página
  const nodes = document.querySelectorAll<HTMLElement>(".embla");

  nodes.forEach((wrapperNode) => {
    const viewportNode =
      wrapperNode.querySelector<HTMLElement>(".embla__viewport");
    const prevBtn = wrapperNode.querySelector<HTMLElement>(".embla__prev");
    const nextBtn = wrapperNode.querySelector<HTMLElement>(".embla__next");

    // A verificação 'if (viewportNode)' resolve o erro de "null" do TypeScript
    if (viewportNode) {
      const autoplayOptions = {
        delay: 5000,
        stopOnInteraction: false,
        stopOnMouseEnter: true,
      };

      const emblaApi = EmblaCarousel(
        viewportNode,
        {
          loop: true,
          align: "start",
        },
        [Autoplay(autoplayOptions)],
      );

      prevBtn?.addEventListener("click", () => emblaApi.scrollPrev());
      nextBtn?.addEventListener("click", () => emblaApi.scrollNext());
    }
  });
</script>
