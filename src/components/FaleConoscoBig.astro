---
import { Image } from "astro:assets";
import Logo from "../images/logo-2.webp";
import ButtonArrowAnimation from "./buttons/ButtonArrowAnimation.astro";
import "../styles/components/fale-conosco-big.css";

interface Props {
    title?: string;
    subtitle?: string;
    buttonText?: string;
}

const {
    title = "Pronto para transformar seu desafio em <strong>resultado real</strong>?",
    subtitle = "Fale com nosso time e descubra como a tecnologia pode trabalhar a favor do seu negócio.",
    buttonText = "Falar com um especialista",
} = Astro.props;
---

<div class="falecomtime container">
    <div class="container-boxed">
        <Image src={Logo} alt="Logo Transformatech" class="logo-falecomtime" />
        <h2 set:html={title} />
        <h3 set:html={subtitle} />
        <ButtonArrowAnimation text={buttonText} link="/contato" />
    </div>
</div>

