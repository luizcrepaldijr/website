---
import { Image } from "astro:assets";
import Logo from "../images/logo-2.webp";
import ButtonArrowAnimation from "./buttons/ButtonArrowAnimation.astro";
import "../styles/components/fale-conosco-big.css";

interface Props {
    title?: string;
    subtitle?: string;
    buttonText?: string;
}

const {
    title = "Ready to transform your challenge into <strong>real results</strong>?",
    subtitle = "Talk to our team and discover how technology can work for your business.",
    buttonText = "Talk to an expert",
} = Astro.props;
---

<div class="falecomtime container">
    <div class="container-boxed">
        <Image src={Logo} alt="Logo Transformatech" class="logo-falecomtime" />
        <h2 set:html={title} />
        <h3 set:html={subtitle} />
        <ButtonArrowAnimation text={buttonText} link="/en/contact" />
    </div>
</div>

