---
import { Image } from "astro:assets";
import Logo from "../images/logo-2.webp";
import ButtonArrowAnimation from "./buttons/ButtonArrowAnimation.astro";
import "../styles/components/fale-conosco-big.css";

interface Props {
    title?: string;
    subtitle?: string;
    buttonText?: string;
}

const {
    title = "¿Listo para transformar su desafío en <strong>resultados reales</strong>?",
    subtitle = "Hable con nuestro equipo y descubra cómo la tecnologia puede trabajar a favor de su negocio.",
    buttonText = "Hable con un experto",
} = Astro.props;
---

<div class="falecomtime container">
    <div class="container-boxed">
        <Image src={Logo} alt="Logo Transformatech" class="logo-falecomtime" />
        <h2 set:html={title} />
        <h3 set:html={subtitle} />
        <ButtonArrowAnimation text={buttonText} link="/es/contacto" />
    </div>
</div>
