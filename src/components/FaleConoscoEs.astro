---
import { Image } from "astro:assets";
import Logo from "../images/logo-2.webp";
import ButtonArrowAnimation from "./buttons/ButtonArrowAnimation.astro";

interface Props {
    title?: string;
    subtitle?: string;
    buttonText?: string;
}

const {
    title = "¿Listo para transformar su desafío en <strong>resultados reales</strong>?",
    subtitle = "Hable con nuestro equipo y descubra cómo la tecnología puede trabajar a favor de su negocio.",
    buttonText = "Hable con un experto",
} = Astro.props;
---

<div class="falecomtime container">
    <div class="container-boxed">
        <Image src={Logo} alt="Logo Transformatech" class="logo-falecomtime" />
        <h2 set:html={title} />
        <h3 set:html={subtitle} />
        <ButtonArrowAnimation text={buttonText} link="/es/contacto" />
    </div>
</div>

<style>
    .falecomtime {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        justify-content: center;
        padding: 227px 0 133px;
        background-image: url("/src/images/home/faleconosco/bg.webp");
        background-position: center;
        background-size: contain;
        background-repeat: no-repeat;

        .container-boxed {
            border-radius: 24px;
            border: 9px solid #161b27;
            background: #101828;
            padding: 64px 48px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 16px;

            .logo-falecomtime {
                width: 51px !important;
                height: auto;
            }

            h3 {
                margin-bottom: 24px;
            }
        }
    }

    @media only screen and (max-width: 800px) {
        .falecomtime {
            padding: 80px 20px;
            background-size: 100%;
            background-position: top;

            .container-boxed {
                padding: 40px 15px;
                text-align: center;

                h2 {
                    line-height: 1.4;
                }

                h3 {
                    margin-bottom: 10px;
                }
            }
        }
    }
</style>
