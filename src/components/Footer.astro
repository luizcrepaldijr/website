---
import { Image } from "astro:assets";
import LogoImg from "../images/logo.webp";
import Microsoft from "../images/microsoft.webp";
import { Icon } from "astro-icon/components";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import "../styles/components/footer.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="container">
  <div class="container-boxed">
    <div class="items-menu">
      <div class="item-1">
        <a href={translatePath("/")}>
          <Image src={LogoImg} class="logo" alt="Transformatech Advisors" />
        </a>

        <h3>Integração digital que transforma desafios em evolução.</h3>
        <Image
          src={Microsoft}
          class="microsoft"
          alt="Microsoft Solutions Partner"
        />
      </div>
      <div class="item-2">
        <div class="link-1">
          <h4>{t("footer.useful_links")}</h4>
          <ul>
            <li><a href={translatePath("/")}>{t("nav.home")}</a></li>
            <li>
              <a href={translatePath("/solucoes")}>{t("nav.solutions")}</a>
            </li>
            <li><a href={translatePath("/sobre-nos")}>{t("nav.about")}</a></li>
            <li><a href={translatePath("/cases")}>{t("nav.cases")}</a></li>
          </ul>
        </div>
        <div class="link-2">
          <h4>{t("footer.contact")}</h4>
          <ul>
            <li>
              <Icon name="whatsapp" class="logo-icon whatsapp" /> +55 (11) 98765-4321
            </li>
            <li>
              <Icon name="instagram" class="logo-icon instagram" /> @transformatech
            </li>
            <li>
              <Icon name="linkedin" class="logo-icon linkedin" /> /in/transformatech
            </li>
          </ul>
        </div>
      </div>
      <Image
        src={Microsoft}
        class="microsoft-mobile"
        alt="Microsoft Solutions Partner"
      />
    </div>
    <div class="copy">
      <p>
        {t("footer.copyright")}
      </p>
      <a href="#">{t("footer.privacy")}</a>
    </div>
  </div>
</footer>

