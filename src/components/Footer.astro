---
import { Image } from "astro:assets";
import LogoImg from "../images/logo.webp";
import Microsoft from "../images/microsoft.webp";
import { Icon } from "astro-icon/components";
---

<footer class="container">
  <div class="container-boxed">
    <div class="items-menu">
      <div class="item-1">
        <a href="/">
          <Image src={LogoImg} class="logo" alt="Transformatech Advisors" />
        </a>

        <h3>Integração digital que transforma desafios em evolução.</h3>
        <Image
          src={Microsoft}
          class="microsoft"
          alt="Microsoft Solutions Partner"
        />
      </div>
      <div class="item-2">
        <div class="link-1">
          <h4>Links úteis</h4>
          <ul>
            <li>Início</li>
            <li>Soluções</li>
            <li>Sobre nós</li>
            <li>Cases</li>
          </ul>
        </div>
        <div class="link-2">
          <h4>Contato</h4>
          <ul>
            <li>
              <Icon name="whatsapp" class="logo-icon whatsapp" /> +55 (11) 98765-4321
            </li>
            <li>
              <Icon name="instagram" class="logo-icon instagram" /> @transformatech
            </li>
            <li>
              <Icon name="linkedin" class="logo-icon linkedin" /> /in/transformatech
            </li>
          </ul>
        </div>
      </div>
      <Image
        src={Microsoft}
        class="microsoft-mobile"
        alt="Microsoft Solutions Partner"
      />
    </div>
    <div class="copy">
      <p>
        © Copyright TransformaTech. Todos os direitos reservados. | Designed by
        <b>Lab Culture</b>
      </p>
      <a href="#">Política de Privacidade</a>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 74px 0 42px;
    background: linear-gradient(
        180deg,
        rgba(0, 51, 113, 0) 0%,
        rgba(0, 51, 113, 0.2) 100%
      ),
      var(--neutral-background, #0c111d);

    .items-menu {
      display: flex;
      justify-content: space-between;
      padding-bottom: 58px;
      border-bottom: 1px solid #ffffff80;

      .item-1 {
        display: flex;
        flex-direction: column;
        max-width: 262px;

        .logo {
          width: 80%;
          height: auto;
        }

        h3 {
          font-size: 16px !important;
          line-height: 24px;
          color: var(--neutral-light-gray, #b6becd);
          opacity: 0.7;
          margin: 20px 0 48px 0;
        }

        .microsoft {
          width: 100%;
          height: auto;
        }
      }

      .item-2 {
        display: flex;

        ul {
          list-style: none;
          padding: 0;
        }

        h4 {
          font-size: 18px !important;
          font-weight: 600 !important;
          line-height: 24px;
          color: var(--neutral-text, #fff);
        }

        .logo-icon {
          width: 24px;
          height: 24px;
        }

        li {
          font-size: 16px !important;
          line-height: 24px;
          color: var(--neutral-light-gray, #b6becd);
        }

        .link-1 {
          li {
            padding: 5px 0;
          }
        }

        .link-2 {
          li {
            padding: 10px 0;
            display: flex;
            align-items: center;
            gap: 8px;
          }
        }

        .link-1,
        .link-2 {
          width: 250px !important;
          display: flex;
          flex-direction: column;
          gap: 18px;
        }
      }
    }

    .copy {
      display: flex;
      justify-content: space-between;
      padding-top: 40px;

      p {
        color: var(--neutral-white, #fcfcfd);
      }

      a {
        text-decoration: underline;
      }
    }

    .microsoft-mobile {
      display: none;
    }
  }

  @media only screen and (max-width: 800px) {
    footer {
      padding: 40px 20px;

      .items-menu {
        flex-direction: column;
        gap: 10px;
        padding-bottom: 0;

        .microsoft {
          display: none;
        }

        .item-2 {
          h4 {
            font-size: 16px !important;
            line-height: 1.2;
          }

          .logo-icon {
            width: 18px;
            height: 18px;
          }

          li {
            font-size: 14px !important;
            line-height: 1.2;
            color: var(--neutral-light-gray, #b6becd);
          }
          .link-1,
          .link-2 {
            width: 50% !important;
            gap: 1px;
          }
        }

        .microsoft-mobile {
          display: block;
          width: 166px;
          height: auto;
          margin-bottom: 33px;
        }
      }

      .copy {
        flex-direction: column;
        gap: 16px;
        text-align: center;
        justify-content: center;
        align-items: center;
        padding-top: 20px;

        p {
          font-size: 14px !important;
          line-height: 1.2;
        }

        a {
          font-size: 14px !important;
          line-height: 1.2;
        }
      }
    }
  }
</style>
