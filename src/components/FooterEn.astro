---
import { Image } from "astro:assets";
import LogoImg from "../images/logo.webp";
import Microsoft from "../images/microsoft.webp";
import { Icon } from "astro-icon/components";
import { useTranslatedPath } from "../i18n/utils";
import "../styles/components/footer.css";

const translatePath = useTranslatedPath("en");
---

<footer class="container">
  <div class="container-boxed">
    <div class="items-menu">
      <div class="item-1">
        <a href={translatePath("/")}>
          <Image src={LogoImg} class="logo" alt="Transformatech Advisors" />
        </a>

        <h3>Digital integration that turns challenges into growth.</h3>
        <Image
          src={Microsoft}
          class="microsoft"
          alt="Microsoft Solutions Partner"
        />
      </div>
      <div class="item-2">
        <div class="link-1">
          <h4>Useful links</h4>
          <ul>
            <li><a href={translatePath("/")}>Home</a></li>
            <li>
              <a href={translatePath("/solucoes")}>Solutions</a>
            </li>
            <li><a href={translatePath("/sobre-nos")}>About us</a></li>
            <li><a href={translatePath("/cases")}>Case studies</a></li>
          </ul>
        </div>
        <div class="link-2">
          <h4>Contact</h4>
          <ul>
            <li>
              <a href="mailto:contact@transforma.tech">
                <Icon name="email" class="logo-icon email" /> contact@transforma.tech
              </a>
            </li>
            <li>
              <a href="https://www.instagram.com/transformatechadvisors/" target="_blank" rel="noopener noreferrer">
                <Icon name="instagram" class="logo-icon instagram" /> @transformatechadvisors
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/company/transformatech-advisors" target="_blank" rel="noopener noreferrer">
                <Icon name="linkedin" class="logo-icon linkedin" /> /company/transformatech-advisors
              </a>
            </li>
          </ul>
        </div>
      </div>
      <Image
        src={Microsoft}
        class="microsoft-mobile"
        alt="Microsoft Solutions Partner"
      />
    </div>
    <div class="copy">
      <p>
        © Copyright TransformaTech. All rights reserved. | Designed by Lab
        Culture
      </p>
      <a href="#">Privacy Policy</a>
    </div>
  </div>
</footer>

