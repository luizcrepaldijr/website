---
import Image from "astro/components/Image.astro";
import Accordion from "./Accordion.astro";
import ButtonArrowSquare from "./buttons/ButtonArrowSquare.astro";
import { Icon } from "astro-icon/components";

import TransformacaoDigitalImg from "../images/solucoes/transformacao-digital-solucao.webp";
import Industria40Img from "../images/solucoes/industria-4-0-solucao.webp";
import EngenhariaImg from "../images/solucoes/engenharia-solucao.webp";
import Agricultura40Img from "../images/solucoes/agricultura-4-0-solucao.webp";
import IotImg from "../images/solucoes/iot-solucao.webp";
import RoboticaImg from "../images/home/servicos/robotica.webp";
import RealidadeDigitalImg from "../images/home/servicos/realidade-digital.webp";

const solucoesData = [
    {
        id: "transformacao-digital",
        title: "Transformação digital",
        subtitle:
            'Capacitamos o seu negócio por meio de soluções <span class="br"></span> inteligentes, conectadas e orientadas por dados.',
        description:
            "Ajudamos as organizações a desbloquear todo o potencial de seus dados e tecnologias ao integrar ferramentas inteligentes, automatizar processos e possibilitar insights em tempo real que impulsionam a tomada de decisões estratégicas.",
        video: "/videos/home/transformacao-digital.webm",
        image: TransformacaoDigitalImg,
        accordions: [
            {
                title: "Consultoria",
                description:
                    "Ajudamos empresas de bens de consumo a impulsionar sua transformação digital com foco em impacto real. Com experiência prática em operações industriais, definimos projetos, tecnologias e estratégias que geram resultados concretos, por meio de roadmaps escaláveis e alinhados ao negócio.",
            },
            {
                title: "Integração de inteligência artificial",
                description:
                    "Desenvolvemos soluções baseadas em Inteligência Artificial projetadas para resolver desafios operacionais específicos. Ao combinar nossa experiência no setor com capacidades avançadas de IA, criamos soluções que aumentam a eficiência, impulsionam a produtividade e geram ganhos mensuráveis.",
            },
            {
                title: "Data Analytics e Data Science Aplicada",
                description:
                    "Estruturamos pipelines, modelos analíticos e camadas de visualização que transformam dados brutos em insights acionáveis para operação e tomada de decisão.",
            },
            {
                title: "Treinamento e Bootcamp",
                description:
                    "Capacitação técnica e estratégica para equipes, garantindo autonomia, adoção das soluções implementadas e sustentabilidade da transformação digital.",
            },
        ],
    },
    {
        id: "industria-40",
        title: "Indústria 4.0",
        subtitle:
            'Conectamos o mundo físico e digital para aumentar <span class="br"></span> visibilidade, controle e desempenho industrial.',
        description:
            "Atuamos em ambientes industriais onde a falta de integração entre máquinas, sistemas e dados limita a eficiência operacional. Implementamos soluções de indústria 4.0 que conectam o chão de fábrica ao ambiente digital, permitindo operações mais previsíveis, seguras e orientadas por dados.",
        video: "/videos/home/industria-4-0.webm",
        image: Industria40Img,
        accordions: [
            {
                title: "Infraestrutura de dados e redes OT",
                description:
                    "Projeto e implementação de arquiteturas robustas para coleta e integração de dados industriais, conectando sistemas de operação e gestão de forma segura.",
            },
            {
                title: "Cibersegurança",
                description:
                    "Proteção de redes, dados e ativos críticos, reduzindo riscos operacionais e garantindo a continuidade da produção em ambientes industriais.",
            },
            {
                title: "Programação",
                description:
                    "Desenvolvimento e ajustes de programação necessários para integração e funcionamento adequado dos sistemas industriais.",
            },
            {
                title: "Suporte em campo e remoto",
                description:
                    "Atendimento técnico contínuo para garantir estabilidade operacional, rápida resposta a falhas e manutenção dos sistemas implantados.",
            },
        ],
    },
    {
        id: "engenharia",
        title: "Engenharia",
        subtitle:
            'Transformamos ideias complexas em soluções técnicas <span class="br"></span> viáveis e eficientes.',
        description:
            "Oferecemos serviços de engenharia ponta a ponta para projetos que exigem rigor técnico, planejamento e execução precisa. Atuamos desde a concepção até a implementação, conectando engenharia, tecnologia e operação para reduzir riscos e otimizar resultados.",
        video: "/videos/home/engenharia.webm",
        image: EngenhariaImg,
        accordions: [
            {
                title: "Gerenciamento de projetos",
                description:
                    "Gestão técnica com foco em escopo, prazo, custo e qualidade, garantindo alinhamento entre equipes e execução eficiente.",
            },
            {
                title: "Estudos conceituais e de viabilidade",
                description:
                    "Análises técnicas iniciais para orientar decisões estratégicas e avaliar a viabilidade de projetos, de forma objetiva e aplicada.",
            },
            {
                title: "Estimativas de capital e documentação técnica",
                description:
                    "Elaboração de estimativas de custo e documentação necessária para apoiar decisões de investimento e execução.",
            },
            {
                title: "Modelagem e simulação",
                description:
                    "Modelagem avançada e simulações para testar cenários, antecipar riscos e otimizar soluções antes da implementação física.",
            },
            {
                title: "Projetos elétricos, mecânicos e de automação",
                description:
                    "Projetos completos e integrados, alinhados às necessidades da operação e às tecnologias envolvidas.",
            },
        ],
    },
    {
        id: "agricultura-40",
        title: "Agricultura 4.0",
        subtitle:
            'Ajudamos produtores e operações agrícolas a tomar <span class="br"></span> decisões melhores usando dados reais do campo.',
        description:
            "Aplicamos tecnologia para transformar informações do solo e do ambiente em inteligência prática, permitindo irrigar melhor, reduzir desperdícios, aumentar produtividade e operar de forma mais sustentável e previsível.",
        video: "/videos/home/agricultura-4-0.webm",
        image: Agricultura40Img,
        accordions: [
            {
                title: "Monitoramento inteligente do solo",
                description:
                    "Coleta contínua de dados como umidade em diferentes profundidades, temperatura e condutividade elétrica, oferecendo uma visão precisa das condições reais da lavoura.",
            },
            {
                title: "Eficiência hídrica baseada em dados",
                description:
                    "Apoio à decisão de irrigação na hora certa e na medida exata, reduzindo desperdícios e gerando economia significativa no uso de água.",
            },
            {
                title: "Plataforma integrada de dados agrícolas",
                description:
                    "Visualização em tempo real, histórico de medições, alertas e acompanhamento do desempenho hídrico e produtivo da operação.",
            },
            {
                title: "Conversão de dados técnicos em impacto financeiro",
                description:
                    "Análise do uso de água com conversão em indicadores financeiros, facilitando o controle de custos e o planejamento da operação.",
            },
            {
                title: "Conectividade em áreas remotas",
                description:
                    "Integração com soluções de conectividade via satélite, garantindo monitoramento contínuo mesmo em regiões sem infraestrutura local.",
            },
        ],
    },
    {
        id: "iot",
        title: "IoT (Internet of Things)",
        subtitle:
            'Conectamos ativos, processos e ambientes para gerar inteligência operacional, previsibilidade e eficiência em <span class="br"></span> tempo real.',
        description:
            "Ajudamos empresas a enxergar em tempo real o que acontece na operação, aplicando IoT para transformar sinais físicos em inteligência operacional prática.<br /><br />Possibilitamos antecipar falhas, otimizar recursos, reduzir desperdícios e tomar decisões mais rápidas, seguras e baseadas em dados reais.",
        video: "/videos/iot/iot-hero.webm",
        image: IotImg,
        buttons: [
            { text: "IoT para indústria", link: "/solucoes/iot?panel=ind" },
            { text: "IoT para agricultura", link: "/solucoes/iot?panel=agri" },
        ],
    },
    {
        id: "robotica",
        title: "Robótica",
        subtitle:
            'Elevamos a automação industrial conectando robôs,<span class="br"></span> dados e processos produtivos.',
        description:
            "Desenvolvemos e integramos sistemas robóticos em ambientes industriais para aumentar produtividade, segurança e eficiência operacional. A robótica passa a atuar como uma camada de inteligência na operação, conectando máquinas, pessoas e dados para gerar previsibilidade e evolução contínua dos processos.",
        video: "/videos/home/robotica.webm",
        image: RoboticaImg,
        accordions: [
            {
                title: "Robôs humanoides",
                description:
                    "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
            },
            {
                title: "Robôs quadrúpedes",
                description:
                    "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
            },
            {
                title: "Robôs colaborativos (cobots)",
                description:
                    "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
            },
            {
                title: "Integração com sistemas industriais",
                description:
                    "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
            },
        ],
        buttons: [
            {
                text: "Saiba mais sobre este serviço",
                link: "/solucoes/robotica",
            },
        ],
    },
    {
        id: "realidade-digital",
        title: "Realidade Digital",
        subtitle:
            'Treinamento e execução operacional com ambientes <span class="br"></span> imersivos integrados à indústria.',
        description:
            "Aplicamos tecnologias de realidade virtual, aumentada e mista para criar simulações e orientações digitais diretamente no contexto da operação industrial. Isso permite que equipes aprendam, pratiquem e executem tarefas com mais segurança, eficiência e padronização.",
        video: "/videos/home/realidade-digital.webm",
        image: RealidadeDigitalImg,
        accordions: [
            {
                title: "Treinamento em realidade virtual",
                description:
                    "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
            },
            {
                title: "Orientação com realidade aumentada",
                description:
                    "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
            },
            {
                title: "Realidade mista aplicada à operação",
                description:
                    "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
            },
            {
                title: "Manutenção guiada por instruções visuais",
                description:
                    "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
            },
        ],
        buttons: [
            {
                text: "Saiba mais sobre este serviço",
                link: "/solucoes/realidade-digital",
            },
        ],
    },
];
---

<div class="solucoes-section-wrapper">
    <div class="solucoes-desktop-container">
        <div class="solucoes-desktop-pinned">
            <div class="solucoes-bg-container">
                {
                    solucoesData.map((solucao, index) => (
                        <div class="solucoes-bg-layer" data-index={index}>
                            {solucao.video ? (
                                <video
                                    src={solucao.video}
                                    class="solucoes-bg-video"
                                    autoplay
                                    muted
                                    loop
                                    playsinline
                                />
                            ) : (
                                <Image
                                    src={solucao.image}
                                    alt={solucao.title}
                                    class="solucoes-bg-img"
                                />
                            )}
                            <div class="solucoes-bg-overlay" />
                        </div>
                    ))
                }
            </div>

            <div class="container-boxed solucoes-desktop-content">
                <div class="solucoes-menu">
                    <ul class="solucoes-nav-list">
                        {
                            solucoesData.map((solucao, index) => (
                                <li
                                    class="solucoes-nav-item"
                                    data-index={index}
                                >
                                    <div class="nav-indicator" />
                                    <span>{solucao.title}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="solucoes-panels">
                    {
                        solucoesData.map((solucao, index) => (
                            <div class="solucoes-panel" data-index={index} data-id={solucao.id}>
                                <h2 class="panel-title">{solucao.title}</h2>
                                <h3
                                    class="panel-subtitle"
                                    set:html={solucao.subtitle}
                                />
                                <p
                                    class="panel-desc"
                                    set:html={solucao.description}
                                />

                                {solucao.accordions && (
                                    solucao.id === "robotica" || solucao.id === "realidade-digital" ? (
                                        <ul class="solucoes-list-items">
                                            {solucao.accordions.map((acc) => (
                                                <li class="solucoes-list-item">
                                                    <Icon name="arrow-right-2" class="solucoes-list-icon" />
                                                    <span class="text">{acc.title}</span>
                                                </li>
                                            ))}
                                        </ul>
                                    ) : (
                                        <div class="accordion-wrapper">
                                            {solucao.accordions.map((acc) => (
                                                <Accordion
                                                    title={acc.title}
                                                    description={acc.description}
                                                />
                                            ))}
                                        </div>
                                    )
                                )}

                                {solucao.buttons && (
                                    <div class="buttons-wrapper">
                                        {solucao.buttons.map((btn) => (
                                            <ButtonArrowSquare
                                                text={btn.text}
                                                link={btn.link}
                                            />
                                        ))}
                                    </div>
                                )}
                            </div>
                        ))
                    }
                </div>

                <div class="solucoes-loader">
                    <svg
                        class="progress-ring"
                        width="45"
                        height="45"
                        viewBox="0 0 45 45"
                    >
                        <circle
                            class="progress-ring__circle_bg"
                            stroke="rgba(255,255,255,0.2)"
                            stroke-width="3"
                            fill="transparent"
                            r="21"
                            cx="22.5"
                            cy="22.5"></circle>
                        <circle
                            class="progress-ring__circle"
                            stroke="#FCFCFD"
                            stroke-width="3"
                            fill="transparent"
                            r="21"
                            cx="22.5"
                            cy="22.5"></circle>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="solucoes-mobile container-boxed">
        {
            solucoesData.map((solucao) => (
                <div class="solucoes-item" id={solucao.id}>
                    {solucao.video ? (
                        <video
                            src={solucao.video}
                            class="solucoes-item-video"
                            autoplay
                            muted
                            loop
                            playsinline
                        />
                    ) : (
                        <Image
                            src={solucao.image}
                            alt={solucao.title}
                            class="solucoes-item-img"
                        />
                    )}
                    <div class="content">
                        <h2>{solucao.title}</h2>
                        <h3 set:html={solucao.subtitle} />
                        <p set:html={solucao.description} />

                        {solucao.accordions && (
                            solucao.id === "robotica" || solucao.id === "realidade-digital" ? (
                                <ul class="solucoes-list-items">
                                    {solucao.accordions.map((acc) => (
                                        <li class="solucoes-list-item">
                                            <Icon name="arrow-right-2" class="solucoes-list-icon" />
                                            <span class="text">{acc.title}</span>
                                        </li>
                                    ))}
                                </ul>
                            ) : (
                                <div class="accordion-wrapper">
                                    {solucao.accordions.map((acc) => (
                                        <Accordion
                                            title={acc.title}
                                            description={acc.description}
                                        />
                                    ))}
                                </div>
                            )
                        )}

                        {solucao.buttons && (
                            <div class="accordion-wrapper">
                                {solucao.buttons.map((btn) => (
                                    <ButtonArrowSquare
                                        text={btn.text}
                                        link={btn.link}
                                    />
                                ))}
                            </div>
                        )}
                    </div>
                </div>
            ))
        }
    </div>
</div>

<style>
    .solucoes-desktop-container {
        display: none; /* Escondido no mobile */
    }

    .solucoes-mobile {
        display: flex; /* Escondido apenas via media query no desktop */
        flex-direction: column;
        gap: 80px;
        padding: 60px 20px;
    }

    .solucoes-item-img {
        width: 100%;
        height: auto;
        border-radius: 8px;
        margin-bottom: 24px;
        object-fit: cover;
    }

    .solucoes-item-video {
        width: 100%;
        max-height: 250px;
        border-radius: 8px;
        margin-bottom: 24px;
        object-fit: cover;
        mask-image:
            linear-gradient(
                to right,
                transparent 0%,
                black 15%,
                black 85%,
                transparent 100%
            ),
            linear-gradient(
                to bottom,
                transparent 0%,
                black 15%,
                black 85%,
                transparent 100%
            );
        mask-composite: intersect;
        -webkit-mask-image:
            linear-gradient(
                to right,
                transparent 0%,
                black 15%,
                black 85%,
                transparent 100%
            ),
            linear-gradient(
                to bottom,
                transparent 0%,
                black 15%,
                black 85%,
                transparent 100%
            );
        -webkit-mask-composite: source-in;
    }

    .solucoes-item .content {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .solucoes-item h2 {
        font-size: 32px;
        color: var(--neutral-white);
        font-weight: 600;
        margin: 0;
    }

    .solucoes-item h3 {
        font-size: 20px;
        font-weight: 400;
        color: var(--neutral-light-gray);
        margin: 0;
    }

    .solucoes-item h3 :global(.br) {
        display: none;
    }

    .solucoes-item p {
        font-size: 16px;
        color: var(--neutral-light-gray);
        opacity: 0.8;
    }

    .accordion-wrapper {
        display: flex;
        flex-direction: column;
        gap: 0px;
        margin-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .accordion-wrapper accordion-item {
        transition: all 0.4s ease;
    }

    /* Efeito de escurecer os outros quando um está aberto */
    .accordion-wrapper:has(.active) :global(accordion-item:not(.active)) {
        opacity: 0.6 !important;
    }

    .solucoes-list-items {
        display: flex;
        flex-direction: column;
        gap: 0px;
        margin-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        list-style: none;
        padding: 0;
    }

    .solucoes-list-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
        font-size: clamp(16px, 1.2vw + 4px, 20px);
        font-weight: 300;
        line-height: 1.4;
    }

    @media (max-width: 1440px) {
        .solucoes-list-item {
            font-size: 17px;
        }
    }

    .solucoes-list-icon {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        color: rgba(255, 255, 255, 0.6);
    }

    @media (min-width: 801px) {
        .solucoes-mobile {
            display: none !important;
        }

        .solucoes-desktop-container {
            display: block;
            position: relative;
            background-color: var(--neutral-background-dark, #0b0c10);
        }

        .solucoes-desktop-pinned {
            position: relative;
            height: 100vh;
            width: 100%;
            overflow: hidden;
            display: flex;
            align-items: center;
        }

        .solucoes-bg-container {
            position: absolute;
            top: 0;
            left: 10vw;
            width: 30vw;
            height: 100%;
            z-index: 0;
        }

        .solucoes-bg-layer {
            position: absolute;
            top: 0;
            left: 20%;
            width: 80%;
            height: 100%;
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .solucoes-bg-layer.active {
            opacity: 1;
            z-index: 1;
        }

        .solucoes-bg-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .solucoes-bg-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .solucoes-bg-overlay {
            position: absolute;
            inset: 0;
            background:
                linear-gradient(
                    to right,
                    var(--neutral-background-dark, #0b0c10) 0%,
                    transparent 15%,
                    transparent 70%,
                    var(--neutral-background-dark, #0b0c10) 100%
                ),
                linear-gradient(
                    to bottom,
                    var(--neutral-background-dark, #0b0c10) 0%,
                    transparent 15%,
                    transparent 70%,
                    var(--neutral-background-dark, #0b0c10) 100%
                );
        }

        .solucoes-desktop-content {
            position: absolute; /* Mudado para absolute para conseguirmos centralizar com limites exatos */
            left: 50%;
            transform: translateX(-50%);
            z-index: 2;
            display: flex;
            justify-content: space-between;
            width: clamp(
                1100px,
                90%,
                1620px
            ); /* Exactly matching global container-boxed width */
            padding-inline: clamp(
                15px,
                4vw,
                40px
            ); /* Plus standard padding 30px essentially */
            height: 100vh;
        }

        .solucoes-menu {
            width: 35%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding-bottom: 0;
            padding-top: 20vh;
            padding-left: 4%;
        }

        .solucoes-nav-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .solucoes-nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 18px;
            color: rgba(255, 255, 255, 0.4);
            transition: color 0.3s ease, font-size 0.3s ease;
            position: relative;
            cursor: pointer;
        }

        .nav-indicator {
            width: 0;
            height: 2px;
            background-color: var(--primary-blue, #0056b3);
            transition: width 0.3s ease;
        }

        .solucoes-nav-item.active,
        .solucoes-nav-item:hover {
            color: var(--neutral-white);
            font-weight: 500;
            font-size: 20px;
        }

        .solucoes-nav-item.active .nav-indicator,
        .solucoes-nav-item:hover .nav-indicator {
            width: 30px;
        }

        .solucoes-panels {
            width: 60%;
            position: relative;
            height: 100vh; /* Changed from 100% to 100vh */
            display: flex;
            align-items: center;
            max-width: 600px; /* Constrain max width of the right panel text content to avoid blowing up on ultrawides */
            margin-right: 0px;
            padding-left: 5%;
        }

        .solucoes-panel {
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            transform: translateY(-40%);
            opacity: 0;
            pointer-events: none;
            transition:
                opacity 0.5s ease,
                transform 0.5s ease;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .solucoes-panel.active {
            opacity: 1;
            transform: translateY(-50%);
            pointer-events: auto;
            z-index: 2;
        }

        .panel-title {
            font-size: 40px;
            color: var(--neutral-white);
            font-weight: 300;
            margin: 0;
            margin-bottom: 8px;
        }

        .panel-subtitle {
            font-size: 20px;
            font-weight: 300;
            color: var(--neutral-light-gray);
            margin: 0;
        }

        .panel-subtitle :global(.br) {
            display: block;
            content: "";
        }

        .panel-desc {
            font-size: 16px;
            color: var(--neutral-light-gray);
            opacity: 0.8;
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .buttons-wrapper {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .solucoes-loader {
            position: absolute;
            bottom: 8vh;
            right: 0px;
            z-index: 10;
        }

        .progress-ring {
            transform: rotate(-90deg);
        }

        .progress-ring__circle {
            transition: stroke-dashoffset 0.1s ease;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initSolucoesGSAP() {
        const desktopContainer = document.querySelector(
            ".solucoes-desktop-container",
        );
        if (!desktopContainer || window.innerWidth <= 800) return;

        const pinnedSection = document.querySelector(
            ".solucoes-desktop-pinned",
        );
        const bgLayers = gsap.utils.toArray(".solucoes-bg-layer");
        const navItems = gsap.utils.toArray(".solucoes-nav-item");
        const panels = gsap.utils.toArray(".solucoes-panel");
        const circle = document.querySelector(".progress-ring__circle");

        const totalItems = navItems.length;

        // Configuração do círculo do SVG para o Loader
        let circumference = 0;
        if (circle) {
            const radius = (circle as SVGCircleElement).r.baseVal.value;
            circumference = radius * 2 * Math.PI;
            (circle as SVGCircleElement).style.strokeDasharray =
                `${circumference} ${circumference}`;
            (circle as SVGCircleElement).style.strokeDashoffset =
                `${circumference}`;
        }

        // Primeiro item ativo logo de inicio
        if (bgLayers[0]) (bgLayers[0] as HTMLElement).classList.add("active");
        if (navItems[0]) (navItems[0] as HTMLElement).classList.add("active");
        if (panels[0]) (panels[0] as HTMLElement).classList.add("active");

        // Cria a distância de scroll baseado no total de itens (ex: 70vh cada para demorar bastante o scroll)
        const scrollDistance = totalItems * 80;

        const trigger = ScrollTrigger.create({
            trigger: desktopContainer,
            pin: pinnedSection,
            start: "top top",
            end: `+=${scrollDistance}%`,
            scrub: true,
            onUpdate: (self) => {
                const progress = self.progress; // Retorna valor entre 0 e 1

                // Atualizar o path do Loader
                if (circle) {
                    const offset = circumference - progress * circumference;
                    (circle as SVGCircleElement).style.strokeDashoffset =
                        `${offset}`;
                }

                // Identificar o índice atual baseado no progresso
                let activeIndex = Math.floor(progress * totalItems);
                if (activeIndex >= totalItems) activeIndex = totalItems - 1;

                updateActiveItem(activeIndex);
            },
        });

        navItems.forEach((item, index) => {
            (item as HTMLElement).addEventListener("click", () => {
                const start = trigger.start;
                const end = trigger.end;
                const progress = (index + 0.1) / totalItems;
                const targetScroll = start + progress * (end - start);

                window.scrollTo({
                    top: targetScroll,
                    behavior: "smooth",
                });
            });
        });

        function updateActiveItem(index: number) {
            bgLayers.forEach((el, i) => {
                if (i === index) (el as HTMLElement).classList.add("active");
                else (el as HTMLElement).classList.remove("active");
            });

            navItems.forEach((el, i) => {
                if (i === index) (el as HTMLElement).classList.add("active");
                else (el as HTMLElement).classList.remove("active");
            });

            panels.forEach((el, i) => {
                if (i === index) (el as HTMLElement).classList.add("active");
                else (el as HTMLElement).classList.remove("active");
            });
        }

        // Handle initial hash routing
        const hash = window.location.hash;
        if (hash) {
            const targetId = hash.slice(1);
            const targetPanel = panels.find(
                (panel) => (panel as HTMLElement).dataset.id === targetId
            );
            if (targetPanel) {
                const index = parseInt((targetPanel as HTMLElement).dataset.index || "0", 10);
                setTimeout(() => {
                    const start = trigger.start;
                    const end = trigger.end;
                    const progress = (index + 0.1) / totalItems;
                    const targetScroll = start + progress * (end - start);
                    window.scrollTo({
                        top: targetScroll,
                        behavior: "auto",
                    });
                }, 100);
            }
        }
    }

    document.addEventListener("DOMContentLoaded", initSolucoesGSAP);

    // Tratamento Astro View Transitions
    document.addEventListener("astro:page-load", () => {
        // Garantindo funcionamento se o usuário navegar e regressar pra página
        ScrollTrigger.getAll().forEach((t) => {
            // Em caso de múltiplos ScrollTriggers (Workflow e afins) matar o que tem esse trigger específico evitaria problemas, mas podemos deixar global para testes rápidos se for tranquilo.
            if (t.trigger?.classList.contains("solucoes-desktop-container")) {
                t.kill();
            }
        });
        initSolucoesGSAP();
    });
</script>
