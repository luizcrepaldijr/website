                    "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
            },
            {
                title: "Collaborative robots (cobots)",
                description:
                    "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
            },
            {
                title: "Integration with industrial systems",
                description:
                    "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
