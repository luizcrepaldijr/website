---

<div class="solucoes-section-wrapper">
    <div class="solucoes-desktop-container">
        <div class="solucoes-desktop-pinned">
            <div class="solucoes-bg-container">
                {
                    solucoesData.map((solucao, index) => (
                        <div class="solucoes-bg-layer" data-index={index}>
                            {solucao.video ? (
                                <video
                                    src={solucao.video}
                                    class="solucoes-bg-video"
                                    autoplay
                                    muted
                                    loop
                                    playsinline
                                />
                            ) : (
                                <Image
                                    src={solucao.image}
                                    alt={solucao.title}
                                    class="solucoes-bg-img"
                                />
                            )}
                            <div class="solucoes-bg-overlay" />
                        </div>
                    ))
                }
            </div>

            <div class="container-boxed solucoes-desktop-content">
                <div class="solucoes-menu">
                    <ul class="solucoes-nav-list">
                        {
                            solucoesData.map((solucao, index) => (
                                <li
                                    class="solucoes-nav-item"
                                    data-index={index}
                                >
                                    <div class="nav-indicator" />
                                    <span>{solucao.title}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="solucoes-panels">
                    {
                        solucoesData.map((solucao, index) => (
                            <div class="solucoes-panel" data-index={index} data-id={solucao.id}>
                                <h2 class="panel-title">{solucao.title}</h2>
                                <h3
                                    class="panel-subtitle"
                                    set:html={solucao.subtitle}
                                />
                                <p
                                    class="panel-desc"
                                    set:html={solucao.description}
                                />

                                {solucao.accordions &&
                                    (solucao.id === "robotics" ||
                                    solucao.id === "digital-reality" ? (
                                        <ul class="solucoes-list-items">
                                            {solucao.accordions.map((acc) => (
                                                <li class="solucoes-list-item">
                                                    <Icon
                                                        name="arrow-right-2"
                                                        class="solucoes-list-icon"
                                                    />
                                                    <span class="text">
                                                        {acc.title}
                                                    </span>
                                                </li>
                                            ))}
                                        </ul>
                                    ) : (
                                        <div class="accordion-wrapper">
                                            {solucao.accordions.map((acc) => (
                                                <Accordion
                                                    title={acc.title}
                                                    description={
                                                        acc.description
                                                    }
                                                />
                                            ))}
                                        </div>
                                    ))}

                                {solucao.buttons && (
                                    <div class="buttons-wrapper">
                                        {solucao.buttons.map((btn) => (
                                            <ButtonArrowSquare
                                                text={btn.text}
                                                link={btn.link}
                                            />
                                        ))}
                                    </div>
                                )}
                            </div>
                        ))
                    }
                </div>

                <div class="solucoes-loader">
                    <svg
                        class="progress-ring"
                        width="45"
                        height="45"
                        viewBox="0 0 45 45"
                    >
                        <circle
                            class="progress-ring__circle_bg"
                            stroke="rgba(255,255,255,0.2)"
                            stroke-width="3"
                            fill="transparent"
                            r="21"
                            cx="22.5"
                            cy="22.5"></circle>
                        <circle
                            class="progress-ring__circle"
                            stroke="#FCFCFD"
                            stroke-width="3"
                            fill="transparent"
                            r="21"
                            cx="22.5"
                            cy="22.5"></circle>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="solucoes-mobile container-boxed">
        {
            solucoesData.map((solucao) => (
                <div class="solucoes-item" id={solucao.id}>
                    {solucao.video ? (
                        <video
                            src={solucao.video}
                            class="solucoes-item-video"
                            autoplay
                            muted
                            loop
                            playsinline
                        />
                    ) : (
                        <Image
                            src={solucao.image}
                            alt={solucao.title}
                            class="solucoes-item-img"
                        />
                    )}
                    <div class="content">
                        <h2>{solucao.title}</h2>
                        <h3 set:html={solucao.subtitle} />
                        <p set:html={solucao.description} />

                        {solucao.accordions &&
                            (solucao.id === "robotics" ||
                            solucao.id === "digital-reality" ? (
                                <ul class="solucoes-list-items">
                                    {solucao.accordions.map((acc) => (
                                        <li class="solucoes-list-item">
                                            <Icon
                                                name="arrow-right-2"
                                                class="solucoes-list-icon"
                                            />
                                            <span class="text">
                                                {acc.title}
                                            </span>
                                        </li>
                                    ))}
                                </ul>
                            ) : (
                                <div class="accordion-wrapper">
                                    {solucao.accordions.map((acc) => (
                                        <Accordion
                                            title={acc.title}
                                            description={acc.description}
                                        />
                                    ))}
                                </div>
                            ))}

                        {solucao.buttons && (
                            <div class="accordion-wrapper">
                                {solucao.buttons.map((btn) => (
                                    <ButtonArrowSquare
                                        text={btn.text}
                                        link={btn.link}
                                    />
                                ))}
                            </div>
                        )}
                    </div>
                </div>
            ))
        }
    </div>
</div>


<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initSolucoesGSAP() {
        const desktopContainer = document.querySelector(
            ".solucoes-desktop-container",
        );
        if (!desktopContainer || window.innerWidth <= 800) return;

        const pinnedSection = document.querySelector(
            ".solucoes-desktop-pinned",
        );
        const bgLayers = gsap.utils.toArray(".solucoes-bg-layer");
        const navItems = gsap.utils.toArray(".solucoes-nav-item");
        const panels = gsap.utils.toArray(".solucoes-panel");
        const circle = document.querySelector(".progress-ring__circle");

        const totalItems = navItems.length;

        // Configuração do círculo do SVG para o Loader
        let circumference = 0;
        if (circle) {
            const radius = (circle as SVGCircleElement).r.baseVal.value;
            circumference = radius * 2 * Math.PI;
            (circle as SVGCircleElement).style.strokeDasharray =
                `${circumference} ${circumference}`;
            (circle as SVGCircleElement).style.strokeDashoffset =
                `${circumference}`;
        }

        // Primeiro item ativo logo de inicio
        if (bgLayers[0]) (bgLayers[0] as HTMLElement).classList.add("active");
        if (navItems[0]) (navItems[0] as HTMLElement).classList.add("active");
        if (panels[0]) (panels[0] as HTMLElement).classList.add("active");

        // Cria a distância de scroll baseado no total de itens (ex: 70vh cada para demorar bastante o scroll)
        const scrollDistance = totalItems * 80;

        const trigger = ScrollTrigger.create({
            trigger: desktopContainer,
            pin: pinnedSection,
            start: "top top",
            end: `+=${scrollDistance}%`,
            scrub: true,
            onUpdate: (self) => {
                const progress = self.progress; // Retorna valor entre 0 e 1

                // Atualizar o path do Loader
                if (circle) {
                    const offset = circumference - progress * circumference;
                    (circle as SVGCircleElement).style.strokeDashoffset =
                        `${offset}`;
                }

                // Identificar o índice atual baseado no progresso
                let activeIndex = Math.floor(progress * totalItems);
                if (activeIndex >= totalItems) activeIndex = totalItems - 1;

                updateActiveItem(activeIndex);
            },
        });

        navItems.forEach((item, index) => {
            (item as HTMLElement).addEventListener("click", () => {
                const start = trigger.start;
                const end = trigger.end;
                const progress = (index + 0.1) / totalItems;
                const targetScroll = start + progress * (end - start);

                window.scrollTo({
                    top: targetScroll,
                    behavior: "smooth",
                });
            });
        });

        function updateActiveItem(index: number) {
            bgLayers.forEach((el, i) => {
                if (i === index) (el as HTMLElement).classList.add("active");
                else (el as HTMLElement).classList.remove("active");
            });

            navItems.forEach((el, i) => {
                if (i === index) (el as HTMLElement).classList.add("active");
                else (el as HTMLElement).classList.remove("active");
            });

            panels.forEach((el, i) => {
                if (i === index) (el as HTMLElement).classList.add("active");
                else (el as HTMLElement).classList.remove("active");
            });
        }

        function scrollToHash(hashVal?: string, isSmooth: boolean = true) {
            const currentHash = hashVal || window.location.hash;
            if (!currentHash) return;
            const targetId = currentHash.replace("#", "");
            if (!targetId) return;

            if (window.innerWidth > 800) {
                const targetPanel = panels.find(
                    (panel) => (panel as HTMLElement).dataset.id === targetId
                );
                if (targetPanel) {
                    const index = parseInt((targetPanel as HTMLElement).dataset.index || "0", 10);
                    const start = trigger.start;
                    const end = trigger.end;
                    const progress = (index + 0.1) / totalItems;
                    const targetScroll = start + progress * (end - start);
                    window.scrollTo({
                        top: targetScroll,
                        behavior: isSmooth ? "smooth" : "auto",
                    });
                }
            } else {
                const targetEl = document.getElementById(targetId);
                if (targetEl) {
                    const yOffset = -90;
                    const y = targetEl.getBoundingClientRect().top + window.pageYOffset + yOffset;
                    window.scrollTo({ top: y, behavior: isSmooth ? "smooth" : "auto" });
                }
            }
        }

        // Handle initial hash routing
        if (window.location.hash) {
            setTimeout(() => scrollToHash(undefined, false), 150);
        }

        // Listen for hashchange events
        window.addEventListener("hashchange", () => scrollToHash(undefined, true));

        // Click listener for same-page hash links
        document.addEventListener("click", (e) => {
            const target = e.target as HTMLElement | null;
            const link = target?.closest("a");
            if (!link) return;

            const href = link.getAttribute("href");
            if (!href || !href.includes("#")) return;

            const hashPos = href.indexOf("#");
            const hash = href.slice(hashPos);
            const path = href.slice(0, hashPos);
            const currentPath = window.location.pathname;

            const isSamePage = !path || currentPath.endsWith(path) || path.endsWith(currentPath) || path === currentPath;

            if (isSamePage) {
                e.preventDefault();
                if (window.location.hash !== hash) {
                    history.pushState(null, "", hash);
                }
                scrollToHash(hash, true);
            }
        });
    }

    document.addEventListener("DOMContentLoaded", initSolucoesGSAP);

    // Tratamento Astro View Transitions
    document.addEventListener("astro:page-load", () => {
        // Garantindo funcionamento se o usuário navegar e regressar pra página
        ScrollTrigger.getAll().forEach((t) => {
            // Em caso de múltiplos ScrollTriggers (Workflow e afins) matar o que tem esse trigger específico evitaria problemas, mas podemos deixar global para testes rápidos se for tranquilo.
            if (t.trigger?.classList.contains("solucoes-desktop-container")) {
                t.kill();
            }
        });
        initSolucoesGSAP();
    });
</script>
