---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
    name: string;
    role: string;
    description: string;
    image: any;
    linkedin?: string;
    instagram?: string;
    facebook?: string;
}

const { name, role, description, image, linkedin, instagram, facebook } =
    Astro.props;
---

<div class="team-card-wrapper">
    <div class="team-card">
        <div class="front">
            <Image src={image} alt={name} class="bg-image" />
            <div class="gradient-overlay"></div>
            <div class="content front-content">
                <div class="info">
                    <h3>{name}</h3>
                    <p>{role}</p>
                </div>
                <button class="flip-btn flip-to-back" aria-label="Ver mais">
                    <Icon name="plus" />
                </button>
            </div>
        </div>
        <div class="back">
            <div class="content back-content">
                <div class="header">
                    <div class="info">
                        <h3>{name}</h3>
                        <p>{role}</p>
                    </div>
                    <button class="flip-btn flip-to-front" aria-label="Fechar">
                        <Icon name="close" />
                    </button>
                </div>
                <div class="body">
                    <p class="description">{description}</p>
                </div>
                <div class="footer">
                    {
                        linkedin && (
                            <a
                                href={linkedin}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <Icon name="linkedin-2" class="social-icon" />
                            </a>
                        )
                    }
                    {
                        instagram && (
                            <a
                                href={instagram}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <Icon name="instagram-2" class="social-icon" />
                            </a>
                        )
                    }
                    {
                        facebook && (
                            <a
                                href={facebook}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <Icon name="facebook-2" class="social-icon" />
                            </a>
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const cards = document.querySelectorAll(".team-card-wrapper");

        cards.forEach((card) => {
            const btnToBack = card.querySelector(".flip-to-back");
            const btnToFront = card.querySelector(".flip-to-front");

            if (btnToBack) {
                btnToBack.addEventListener("click", () => {
                    card.classList.add("flipped");
                });
            }

            if (btnToFront) {
                btnToFront.addEventListener("click", () => {
                    card.classList.remove("flipped");
                });
            }
        });
    });
</script>

<style>
    .team-card-wrapper {
        perspective: 1000px;
        width: 100%;
        height: 480px;
        border-radius: 16px;
    }

    .team-card {
        width: 100%;
        height: 100%;
        position: relative;
        transition: transform 0.6s;
        transform-style: preserve-3d;
        border-radius: 16px;
    }

    .team-card-wrapper.flipped .team-card {
        transform: rotateY(180deg);
    }

    .front,
    .back {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        backface-visibility: hidden;
        border-radius: 16px;
        overflow: hidden;
    }

    .front {
        background-color: #0c111d;
    }

    .bg-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        position: absolute;
        top: 0;
        left: 0;
    }

    .gradient-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            rgba(7, 9, 33, 0) 50%,
            #070921 100%
        );
        z-index: 1;
        pointer-events: none;
    }

    .front-content {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 24px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        z-index: 2;
    }

    .flip-btn {
        width: 32px;
        height: 32px;
        min-width: 32px;
        border-radius: 8px;
        background: #fcfcfd;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        border: none;
        transition: background 0.3s;
        color: #070921;
    }

    .flip-btn:hover {
        background: #e0e0e0;
    }

    [data-icon] {
        width: 20px;
        height: 20px;
    }

    .info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    h3 {
        color: #fcfcfd;
        font-size: 18px;
        font-weight: 700;
    }

    p {
        color: #b6becd;
        font-size: 14px;
        font-weight: 400;
    }

    .back {
        transform: rotateY(180deg);
        background: linear-gradient(
                90deg,
                rgba(0, 51, 113, 0.7) 0%,
                #070921 100%
            ),
            #0c111d;
        box-shadow: 0 3.417px 0 0 rgba(255, 255, 255, 0.1) inset,
            0 0 68.333px 10.25px rgba(7, 13, 79, 0.05),
            0 0 136.667px 68.333px rgba(7, 13, 79, 0.05),
            0 0 0 3.417px rgba(255, 255, 255, 0.06) inset;
        padding: 24px;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .back-content {
        display: flex;
        flex-direction: column;
        height: 100%;
        z-index: 2;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .header .info h3 {
        font-size: 18px;
    }

    .header .info p {
        font-size: 14px;
    }

    .body {
        flex-grow: 1;
        overflow-y: auto;
    }

    .description {
        color: #b6becd;
        font-size: 14px;
        line-height: 140%;
        font-weight: 400;
    }

    .footer {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .social-icon {
        width: 28px;
        height: 28px;
        color: #fcfcfd;
        transition: opacity 0.3s;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
        padding: 6px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .social-icon:hover {
        opacity: 0.8;
    }

    .body::-webkit-scrollbar {
        width: 4px;
    }
    .body::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
    }
    .body::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.3);
        border-radius: 4px;
    }

    @media only screen and (max-width: 800px) {
        .team-card-wrapper {
            height: 400px;
        }
    }
</style>
