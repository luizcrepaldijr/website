---
import { Image } from "astro:assets";

import joaoTrifano from "../images/testimonial/joao-trifano.webp";
import unileverLogo from "../images/testimonial/unilever.webp";
import paolaRibeiro from "../images/testimonial/paola-ribeiro.webp";
import citrosucoLogo from "../images/testimonial/citrosuco.webp";
import pauloHenrique from "../images/testimonial/paulo-henrique-matias.webp";

const testimonials = [
    {
        name: "João Trifano",
        job: "Diretor Técnico na Unilever",
        text: "Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting.",
        photo: joaoTrifano,
        companyLogo: unileverLogo,
    },
    {
        name: "Paola Ribeiro",
        job: "Liderança na Citrosuco",
        text: "Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting.",
        photo: paolaRibeiro,
        companyLogo: citrosucoLogo,
    },
    {
        name: "Paulo Henrique Matias",
        job: "Especialista na Unilever",
        text: "Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting.",
        photo: pauloHenrique,
        companyLogo: unileverLogo,
    },
];

const marqueeItems1 = [
    ...testimonials,
    ...testimonials,
    ...testimonials,
    ...testimonials,
];
const marqueeItems2 = [
    ...testimonials.reverse(),
    ...testimonials.reverse(),
    ...testimonials.reverse(),
    ...testimonials.reverse(),
];
---

<div class="testimonials-marquee-container">
    <!-- Top Row: Scrolls to RIGHT -->
    <div class="marquee-wrapper">
        <div class="marquee-track scroll-right">
            {
                marqueeItems1.map((item) => (
                    <div class="testimonial-card">
                        <div class="testimonial-header">
                            <div class="author-info">
                                <Image
                                    src={item.photo}
                                    alt={item.name}
                                    class="author-photo"
                                />
                                <div class="author-text">
                                    <strong>{item.name}</strong>
                                    <span>{item.job}</span>
                                </div>
                            </div>
                            <Image
                                src={item.companyLogo}
                                alt="Company Logo"
                                class="company-logo"
                            />
                        </div>
                        <p>{item.text}</p>
                    </div>
                ))
            }
        </div>
    </div>

    <!-- Bottom Row: Scrolls to LEFT -->
    <div class="marquee-wrapper">
        <div class="marquee-track scroll-left">
            {
                marqueeItems2.map((item) => (
                    <div class="testimonial-card">
                        <div class="testimonial-header">
                            <div class="author-info">
                                <Image
                                    src={item.photo}
                                    alt={item.name}
                                    class="author-photo"
                                />
                                <div class="author-text">
                                    <strong>{item.name}</strong>
                                    <span>{item.job}</span>
                                </div>
                            </div>
                            <Image
                                src={item.companyLogo}
                                alt="Company Logo"
                                class="company-logo"
                            />
                        </div>
                        <p>{item.text}</p>
                    </div>
                ))
            }
        </div>
    </div>
</div>

<style>
    .testimonials-marquee-container {
        display: flex;
        flex-direction: column;
        gap: 24px;
        width: 100%;
        overflow: hidden;
        padding: 40px 0;
    }

    .marquee-wrapper {
        display: flex;
        overflow: hidden;
        width: 100%;
        position: relative;
        mask-image: linear-gradient(
            to right,
            transparent,
            black 10%,
            black 90%,
            transparent
        );
    }

    .marquee-track {
        display: flex;
        gap: 24px;
        width: max-content;
        will-change: transform;
    }

    .scroll-right {
        animation: scrollRight 40s linear infinite;
    }

    .scroll-left {
        animation: scrollLeft 40s linear infinite;
    }

    .marquee-wrapper:hover .marquee-track {
        animation-play-state: paused;
    }

    .testimonial-card {
        background: #0f121d;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 24px;
        width: 500px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        gap: 24px;
        backdrop-filter: blur(10px);
    }

    .testimonial-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    .author-info {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .author-photo {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
    }

    .author-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .author-text strong {
        color: white;
        font-size: 18px;
        font-weight: 600;
    }

    .author-text span {
        color: #98a2b3;
        font-size: 14px;
        font-weight: 400;
    }

    .company-logo {
        height: 35px;
        width: auto;
        object-fit: contain;
    }

    .testimonial-card p {
        color: #d0d5dd;
        font-size: 16px;
        line-height: 1.6;
        font-weight: 300;
        margin: 0;
    }

    @keyframes scrollLeft {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    @keyframes scrollRight {
        0% {
            transform: translateX(-50%);
        }
        100% {
            transform: translateX(0);
        }
    }

    @media only screen and (max-width: 800px) {
        .testimonial-card {
            width: 350px;
            padding: 20px;
        }

        .author-text strong {
            font-size: 16px;
        }

        .author-photo {
            width: 40px;
            height: 40px;
        }

        .company-logo {
            height: 25px;
        }

        .testimonial-card p {
            font-size: 16px;
        }
    }
</style>
