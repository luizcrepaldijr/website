---
interface Props {
  text: string;
  link?: string;
}

const { text, link } = Astro.props;

import ArrowRight from "phosphor-astro/ArrowRight.astro";
---

<a href={link || "#"}>
  {text}
  <ArrowRight class="arrow" />
</a>

<style>
  a {
    border-radius: 999px;
    border: var(--stroke-sm, 1px) solid var(--neutral-white, #fcfcfd);
    position: relative;
    text-align: center;
    font-size: clamp(16px, 1.25vw, 24px) !important;
    padding: clamp(14px, 1.25vw, 20px) clamp(20px, 2vw, 32px) !important;
    background-color: transparent;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  a:hover {
    opacity: 0.8;
  }

  .arrow {
    width: clamp(16px, 1.2vw, 24px) !important;
  }

  @media only screen and (max-width: 800px) {
    a {
      font-size: 16px !important;
      padding: 16px 24px !important;
    }

    .arrow {
      width: 20px !important;
    }
  }
</style>
