---
interface Props {
  text: string;
  link?: string;
}

const { text, link } = Astro.props;
const isContactAction = !link || link === "#" || link.includes("contato");

import ArrowRight from "phosphor-astro/ArrowRight.astro";
---

<a href={link || "#"} data-open-contact-modal={isContactAction ? "true" : undefined}>
  <div class="border-mask">
    <div class="border-glow"></div>
  </div>
  {text}
  <ArrowRight class="arrow" />
</a>

<style>
  a {
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    text-align: center;
    font-size: clamp(16px, 1.25vw, 24px) !important;
    padding: clamp(14px, 1.25vw, 20px) clamp(20px, 2vw, 32px) !important;
    background-color: transparent;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  a:hover {
    opacity: 0.8;
  }

  div.border-mask {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    border-radius: 999px;
    padding: 1px;
    mask: linear-gradient(#0c111d 0 0) content-box,
      linear-gradient(#0c111d 0 0) border-box;
    mask-composite: exclude;
  }

  div.border-glow {
    background: conic-gradient(
      from 0deg,
      transparent 0%,
      #fff 10%,
      #0c111d 15%,
      transparent 20%
    ) !important;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 500px;
    height: 500px;
    transform: translate(-50%, -50%);
    transform-origin: 0 0;
    animation: rotateShine 5s linear infinite;
  }

  .arrow {
    width: clamp(16px, 1.2vw, 24px) !important;
  }

  @keyframes rotateShine {
    0% {
      transform: rotate(0deg) translate(-50%, -50%);
    }
    100% {
      transform: rotate(360deg) translate(-50%, -50%);
    }
  }

  @media only screen and (max-width: 800px) {
    a {
      font-size: 16px !important;
      padding: 16px 24px !important;
    }

    .arrow {
      width: 20px !important;
    }

    div.border-glow {
      width: 100%;
      height: 30vh;
    }
  }
</style>
