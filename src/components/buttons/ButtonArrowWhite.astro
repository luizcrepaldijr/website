---
interface Props {
  text: string;
  link?: string;
}

const { text, link } = Astro.props;
const isContactAction = !link || link === "#" || link.includes("contato");

import ArrowRight from "phosphor-astro/ArrowRight.astro";
---

<a href={link || "#"} data-open-contact-modal={isContactAction ? "true" : undefined}>
  {text}
  <ArrowRight class="arrow" />
</a>

<style>
  a {
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    text-align: center;
    font-size: clamp(14px, 1.1vw, 20px) !important;
    padding: clamp(10px, 1vw, 14px) clamp(16px, 1.5vw, 24px) !important;
    background-color: var(--neutral-white);
    color: var(--neutral-background);
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  a:hover {
    opacity: 0.8;
  }

  .arrow {
    width: clamp(14px, 1.1vw, 20px) !important;
  }

  @media only screen and (max-width: 800px) {
    a {
      font-size: 16px !important;
      padding: 16px 24px !important;
    }

    .arrow {
      width: 20px !important;
    }
  }
</style>
