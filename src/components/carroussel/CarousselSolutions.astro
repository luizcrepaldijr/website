---
import { Icon } from "astro-icon/components";
---

<div class="embla__solutions">
  <div class="embla__solutions__viewport">
    <div class="embla__solutions__container">
      <slot />
    </div>
  </div>

  <div class="embla__solutions__controls">
    <button class="embla__solutions__prev">
      <Icon name="arrow-left" />
    </button>
    <button class="embla__solutions__next">
      <Icon name="arrow-right" />
    </button>
  </div>
</div>

<style>
  .embla__solutions__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 30px;
    padding-left: 45px;
  }

  button {
    background-color: transparent;
    padding: 0;
    border: none;
    cursor: pointer;
  }

  button [data-icon] {
    font-size: clamp(32px, 4vw, 56px);
  }

  button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  button:not(:disabled):hover [data-icon] {
    opacity: 0.8;
  }

  @media only screen and (max-width: 800px) {
    .embla__solutions__controls {
      margin-top: 20px;
      padding: 0;
      gap: 20px;
      justify-content: end;
    }

    button [data-icon] {
      font-size: clamp(40px, 12vw, 60px);
    }
  }
</style>

<style is:global>
  .embla__solutions__viewport {
    overflow: hidden;
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }

  .embla__solutions__container {
    display: flex;
    touch-action: pan-y pinch-zoom;
  }

  .embla__solutions__slide {
    flex: 0 0 22%;
    min-width: 0;
  }

  @media only screen and (max-width: 767px) {
    .embla__solutions__slide {
      flex: 0 0 70%;
    }
  }

  .embla__solutions__controls {
    margin-top: 10px;
    display: flex;
    gap: 10px;
  }
</style>

<script>
  import EmblaCarousel from "embla-carousel";

  // Selecionamos todos para evitar erros se houver mais de um na página
  const nodes = document.querySelectorAll(".embla__solutions");

  nodes.forEach((wrapperNode) => {
    const viewportNode = wrapperNode.querySelector(
      ".embla__solutions__viewport"
    );
    const prevBtn = wrapperNode.querySelector(".embla__solutions__prev");
    const nextBtn = wrapperNode.querySelector(".embla__solutions__next");

    // A verificação 'if (viewportNode)' resolve o erro de "null" do TypeScript
    if (viewportNode) {
      const emblaApi = EmblaCarousel(viewportNode as HTMLElement, {
        loop: false,
        align: "start",
        containScroll: "trimSnaps",
      });

      const updateButtons = () => {
        if (!emblaApi) return;
        if (prevBtn) (prevBtn as HTMLButtonElement).disabled = !emblaApi.canScrollPrev();
        if (nextBtn) (nextBtn as HTMLButtonElement).disabled = !emblaApi.canScrollNext();
      };

      prevBtn?.addEventListener("click", () => emblaApi.scrollPrev());
      nextBtn?.addEventListener("click", () => emblaApi.scrollNext());

      emblaApi.on("select", updateButtons);
      emblaApi.on("init", updateButtons);
    }
  });
</script>
