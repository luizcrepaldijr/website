---
import { Image } from "astro:assets";
import LogoImg from "../../images/logo.webp";
import Menu from "./Menu.astro";
import Language from "./Language.astro";
import Button from "../buttons/Button.astro";
import List from "phosphor-astro/List.astro";
import Close from "phosphor-astro/X.astro";
import { getLangFromUrl, useTranslatedPath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const localizePath = useTranslatedPath(lang);
---

<header>
  <div class="container-boxed header-inner">
    <a href={localizePath("/")}>
      <Image src={LogoImg} class="logo" alt="Transformatech Advisors" />
    </a>
    <List color="white" id="menuToggle" />
    <Close color="white" id="menuClose" />
    <span id="menuContainer">
      <Menu />
      <Language />
      <div class="button-wrapper">
        <Button />
      </div>
    </span>
  </div>
</header>
<div class="overlay"></div>

<style>
  header {
    width: 100%;
    height: 14vh;
    max-height: 150px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 6.75px 7.5px 18.75px 0 rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(12px);
    position: relative;
    z-index: 99999;
  }

  .header-inner {
    display: flex;
    justify-content: center;
    padding: 0 !important;
    height: 100%;
  }

  a {
    padding: 0 60px 0 0;
    width: 15%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid #ffffff40;
  }

  .logo {
    width: 100%;
    max-width: 320px;
    padding: 20px 0;
    height: 100%;
    object-fit: contain;
  }

  .button-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0 0 60px;
    width: 23.53%;
  }

  span {
    width: 85%;
    padding: 0;
    display: flex;
  }

  .overlay {
    display: none;
  }

  #menuToggle,
  #menuClose {
    display: none;
  }

  @media only screen and (max-width: 800px) {
    header {
      height: 14vh;
    }

    .header-inner {
      padding: 0 20px !important;
    }

    .logo {
      max-width: 100%;
    }

    span {
      position: fixed;
      left: -60%;
      width: 60%;
      height: 100vh;
      top: 0;
      bottom: 0;
      flex-direction: column;
      background-color: black;
      transition: left 0.3s ease;
      z-index: 99999;

      padding: 50px 20px;
      justify-content: flex-start;
      gap: 40px;
    }

    .overlay {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0%;
      width: 100%;
      height: 100vh;
      background: rgba(0, 0, 0, 0.7);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      z-index: 99998;
    }

    .overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    span.active {
      left: 0;
    }

    #menuToggle {
      display: block;
      cursor: pointer;
      width: 30px;
    }

    #menuToggle.hidden {
      display: none;
    }

    #menuClose {
      display: none;
      cursor: pointer;
      width: 30px;
    }

    #menuClose.active {
      display: block;
    }

    a {
      border: none;
      width: 220px;
    }

    .header-inner {
      padding: 15px;
      justify-content: space-between;
    }

    .button-wrapper {
      padding: 0;
      width: 100%;
    }

    #menuContainer .button-wrapper {
      display: none;
    }
  }

  @media only screen and (min-width: 1800px) {
    .container-boxed {
      width: 80% !important;
    }

    header {
      height: 14vh;
      max-height: 100%;
    }
  }
</style>

<script>
  const menuToggle = document.getElementById("menuToggle");
  const menuClose = document.getElementById("menuClose");
  const menuContainer = document.getElementById("menuContainer");
  const overlay = document.querySelector(".overlay");

  function toggleMenu() {
    menuContainer?.classList.toggle("active");
    overlay?.classList.toggle("active");
    menuToggle?.classList.toggle("hidden");
    menuClose?.classList.toggle("active");
  }

  menuToggle?.addEventListener("click", toggleMenu);
  menuClose?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);
</script>
