---
import { Image } from "astro:assets";
import LogoImg from "../../images/logo.webp";
import Menu from "./Menu.astro";
import Language from "./Language.astro";
import Button from "../buttons/Button.astro";
import List from "phosphor-astro/List.astro";
---

<header class="container">
    <a href="/">
    <Image src={LogoImg} class="logo" alt="Transformatech Advisors" />
  </a>
  <List color="white" id="menuToggle" />
  <span id="menuContainer">
    <Menu />
    <Language />
    <div>
      <Button />
    </div>
  </span>
</header>
<div class="overlay"></div>

<style>
  header {
    display: flex;
    width: 100%;
    height: 14vh;
    max-height: 150px;
    justify-content: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 6.75px 7.5px 18.75px 0 rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(12px);
  }

  a {
    padding: 0 60px 0 0;
    width: 15%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid #ffffff40;
  }

  .logo {
    width: 100%;
    max-width: 320px;
    padding: 20px 0;
    height: 100%;
    object-fit: contain;
  }

  div {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0 0 60px;
    width: 23.53%;
  }

  span {
    width: 85%;
    padding: 0;
    display: flex;
  }

  .overlay {
    display: none;
  }

  #menuToggle {
    display: none;
  }

  @media only screen and (max-width: 800px) {
    header {
      height: 14vh;
    }
    
    .logo {
      max-width: 100%;
    }

    span {
      position: fixed;
      left: -50%;
      width: 40%;
      height: 100vh;
      top: 0;
      bottom: 0;
      flex-direction: column;
      background-color: black;
      transition: left 0.3s ease;
      z-index: 1000;

      padding: 50px 20px;
      justify-content: flex-start;
      gap: 40px;
    }

    .overlay {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0%;
      width: 100%;
      height: 100vh;
      background: rgba(0, 0, 0, 0.7);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      z-index: 999;
    }

    .overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    span.active {
      left: 0;
    }

    #menuToggle {
      display: block;
      cursor: pointer;
      width: 30px;
    }

    a {
      border: none;
      width: 220px;
    }

    header {
      justify-content: space-between;
    }

    div {
      padding: 0;
      width: 100%;
    }

    .container {
      padding: 15px;
    }

    #menuContainer div {
      display: none;
    }
  }
</style>

<script>
  const menuToggle = document.getElementById("menuToggle");
  const menuContainer = document.getElementById("menuContainer");
  const overlay = document.getElementById("overlay");

  menuToggle?.addEventListener("click", () => {
    menuContainer?.classList.toggle("active");
    overlay?.classList.toggle("active");
  });

  overlay?.addEventListener("click", () => {
    menuContainer?.classList.remove("active");
    overlay?.classList.remove("active");
  });
</script>
