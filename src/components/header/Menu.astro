---
const pathname = Astro.url.pathname;
---

<div class="menulink">
  <a href="/" class={pathname === "/" ? "active" : ""}>Início</a>
  <a href="/solucoes" class={pathname.startsWith("/solucoes") ? "active" : ""}
    >Soluções</a
  >
  <a href="/sobre-nos" class={pathname.startsWith("/sobre-nos") ? "active" : ""}
    >Sobre nós</a
  >
  <a href="/cases" class={pathname.startsWith("/cases") ? "active" : ""}
    >Cases</a
  >
</div>

<style>
  .menulink {
    width: 64.71%;
    padding: 29px 63px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-right: 1px solid #ffffff40;
  }

  a {
    text-transform: uppercase;
    width: 25%;
    font-size: 1vw;
    text-align: center;
    color: var(--neutral-light-gray);
    font-weight: 400;
  }

  a.active {
    font-weight: 700 !important;
    color: var(--neutral-white, #fff);
  }

  @media only screen and (max-width: 800px) {
    .menulink {
      flex-direction: column;
      padding: 0;
      border: none;
      width: 100%;
      gap: 40px;
    }

    a {
      width: 100%;
      font-size: 18px;
    }
  }
</style>
