---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pathname = Astro.url.pathname;

const localizePath = useTranslatedPath(lang);
---

<div class="menulink">
  <a
    href={localizePath("/")}
    class={pathname === localizePath("/") ? "active" : ""}
  >
    {t("nav.home")}
  </a>
  <a
    href={localizePath("/solucoes")}
    class={pathname.startsWith(localizePath("/solucoes")) ? "active" : ""}
  >
    {t("nav.solutions")}
  </a>
  <a
    href={localizePath("/sobre-nos")}
    class={pathname.startsWith(localizePath("/sobre-nos")) ? "active" : ""}
  >
    {t("nav.about")}
  </a>
  <a
    href={localizePath("/cases")}
    class={pathname.startsWith(localizePath("/cases")) ? "active" : ""}
  >
    {t("nav.cases")}
  </a>
</div>

<style>
  .menulink {
    width: 64.71%;
    padding: 29px 63px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-right: 1px solid #ffffff40;
  }

  a {
    text-transform: uppercase;
    width: 25%;
    font-size: 1vw;
    text-align: center;
    color: var(--neutral-light-gray);
    font-weight: 400;
  }

  a.active {
    font-weight: 700 !important;
    color: var(--neutral-white, #fff);
  }

  @media only screen and (max-width: 800px) {
    .menulink {
      flex-direction: column;
      padding: 0;
      border: none;
      width: 100%;
      gap: 40px;
    }

    a {
      width: 100%;
      font-size: 18px;
    }
  }
</style>
