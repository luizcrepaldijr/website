---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import "../styles/pages/cases.css";
import { Image } from "astro:assets";
import Badge from "../components/Badge.astro";
import Badge2 from "../components/Badge2.astro";
import ButtonArrowWhite from "../components/buttons/ButtonArrowWhite.astro";
import FaleConosco from "../components/FaleConosco.astro";

import ParceirosImg from "../images/sobrenos/parceria.webp";
import Unilever from "../images/home/parceirosglobais/unilever.webp";
import Evera from "../images/home/parceirosglobais/evera.webp";
import LivingProof from "../images/home/parceirosglobais/living-proof.webp";
import TecnologiasDesktop from "../images/solucoes/tecnologias-desktop.webp";
import TecnologiasMobile from "../images/solucoes/tecnologias-mobile.webp";

const ptCases = await getCollection("cases", ({ id }) => {
    return id.startsWith("pt/");
});
---

<Layout>
    <!-- HERO -->
    <div class="cases-hero container">
        <div class="container-boxed">
            <div class="content">
                <Badge text="Cases de sucesso" />
                <h2>Resultados que <b>transformam negócios</b></h2>
                <h3>
                    Cases reais que demonstram como aplicamos tecnologia,
                    inteligência e dados para estruturar eficiência, governança
                    e vantagem competitiva.
                </h3>
            </div>

            <div class="hero-img-wrapper">
                <video
                    src="/videos/sobre-nos/parceiros-transformatech.webm"
                    class="hero-img"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={ParceirosImg.src}></video>
            </div>
        </div>
    </div>

    <!-- PARCEIROS GLOBAIS -->
    <div class="parceiros container-boxed">
        <h4><b>Parceiros globais</b> que confiam na Transformatech</h4>
        <div>
            <Image src={Unilever} class="img" alt="Unilever" />
            <Image src={Evera} class="img" alt="Evera" />
            <Image src={LivingProof} class="img" alt="Living Proof" />
        </div>
    </div>

    <!-- CASES LIST -->
    <div class="cases-list container-boxed">
        <h2>Cases de sucesso</h2>
        <p>
            Mais do que implementar soluções, construímos bases sólidas para
            eficiência, escalabilidade e tomada de decisão estratégica.
        </p>

        {
            ptCases.map((entry) => (
                <div class="case-card">
                    <Image
                        src={entry.data.image}
                        alt={entry.data.title}
                        class="case-card-img"
                    />
                    <div class="case-card-content">
                        <div class="case-card-badges">
                            {entry.data.badges.map((badge) => (
                                <Badge2 text={badge} />
                            ))}
                        </div>
                        <h3>{entry.data.title}</h3>
                        <div class="case-card-detail">
                            <strong>Desafio</strong>
                            <p>{entry.data.challenge}</p>
                        </div>
                        <div class="case-card-detail">
                            <strong>Solução</strong>
                            <p>{entry.data.solution}</p>
                        </div>
                        <div class="case-card-detail">
                            <strong>Resultado</strong>
                            <p>{entry.data.result}</p>
                        </div>
                    <div class="case-card-btn">
                        <ButtonArrowWhite 
                            text="Leia mais" 
                            link={`/cases/${entry.id.replace("pt/", "")}`} 
                        />
                    </div>
                    </div>
                </div>
            ))
        }
    </div>

    <!-- TECNOLOGIAS -->
    <div class="cases-tecnologias container-boxed">
        <div class="content-desktop">
            <h3>Especialistas em</h3>
            <h2>20+</h2>
            <h4>tecnologias</h4>
        </div>

        <div class="content-mobile">
            <h3>Especialistas em <br /> <span>20+</span> tecnologias</h3>
        </div>

        <div class="tecnologias-img-wrapper">
            <Image
                src={TecnologiasDesktop}
                alt="Tecnologias Desktop"
                class="tecnologias-img-desktop"
            />
            <Image
                src={TecnologiasMobile}
                alt="Tecnologias Mobile"
                class="tecnologias-img-mobile"
            />
        </div>
    </div>

    <!-- FALE CONOSCO -->
    <FaleConosco
        title="Pronto para transformar seu desafio em resultado real?"
        subtitle="Fale com nosso time e descubra como a tecnologia pode trabalhar a favor do seu negócio."
        buttonText="Conversar sobre meu desafio"
    />
</Layout>
