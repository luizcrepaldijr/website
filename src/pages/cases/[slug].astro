---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { getImage, Image } from "astro:assets";
import "../../styles/pages/individual-cases.css";

import CalendarIcon from "../../icons/calendar.svg";
import TimeIcon from "../../icons/time.svg";
import ThumbsDownIcon from "../../icons/thumbs-down.svg";
import CloseIcon from "../../icons/close-2.svg";
import ThumbsUpIcon from "../../icons/thumbs-up.svg";
import RightArrowIcon from "../../icons/right-arrow.svg";
import ArrowRight2Icon from "../../icons/arrow-right-2.svg";
import MonitoramentoIcon from "../../icons/monitoramento.svg";
import DesperdicioIcon from "../../icons/desperdicio.svg";
import PadronizacaoIcon from "../../icons/padronizacao.svg";
import VisibilidadeIcon from "../../icons/visibilidade.svg";
import EscalabilidadeIcon from "../../icons/escalabilidade.svg";
import BaseIcon from "../../icons/base.svg";
import CheckIcon from "../../icons/check.svg";
import RocketIcon from "../../icons/rocket.svg";

import EliminacaoPlanilhasIcon from "../../icons/eliminacao-planilhas.svg";
import ReducaoRetrabalhoIcon from "../../icons/reducao-retrabalho.svg";
import PadronizacaoApontamentosIcon from "../../icons/padronizacao-apontamentos.svg";
import AgilidadeTratativasIcon from "../../icons/agilidade-tratavias.svg";
import MaiorRastreabilidadeIcon from "../../icons/maior-rastreabilidade.svg";
import EvidenciasVisuaisIcon from "../../icons/evidencias-visuais.svg";
import MelhoriaQualidadeIcon from "../../icons/melhoria-qualidade.svg";
import MaiorEngajamentoIcon from "../../icons/maior-engajamento.svg";
import BaseEstruturadaIcon from "../../icons/base-estruturada.svg";
import FaleConosco from "../../components/FaleConosco.astro";

export async function getStaticPaths() {
    const ptCases = await getCollection("cases", ({ id }) => {
        return id.startsWith("pt/");
    });

    return ptCases.map((entry) => ({
        params: { slug: entry.id.replace("pt/", "") },
        props: { entry },
    }));
}

const allImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/images/**/*.{jpeg,jpg,png,gif,webp,svg}"
);

const resolveImage = async (path: any) => {
    if (!path || typeof path !== "string") return path;
    const normalizedPath = path.replace("../../../", "/src/");
    const loader = allImages[normalizedPath];
    if (loader) {
        const mod = await loader();
        return mod.default;
    }
    return path;
};

const { entry } = Astro.props;

// Pre-resolve all images in the entry data
const resolvedImage = await resolveImage(entry.data.image);
const resolvedHeroMockup = await resolveImage(entry.data.heroMockup);
const resolvedTestimonialPhoto = await resolveImage(
    entry.data.testimonial?.photo
);
const resolvedTestimonialLogo = await resolveImage(
    entry.data.testimonial?.companyLogo
);
const resolvedSolutionImage = await resolveImage(
    entry.data.solutionData?.image
);
const resolvedResultsImage = await resolveImage(entry.data.resultsData?.image);

const { Content } = await render(entry);

const optimizedBackground = await getImage({
    src: resolvedImage,
    format: "webp",
    width: 1920,
    height: 1080,
});

const formattedDate = entry.data.pubDate
    ? new Intl.DateTimeFormat("pt-BR").format(new Date(entry.data.pubDate))
    : "";

const iconMap: Record<string, any> = {
    monitoramento: MonitoramentoIcon,
    desperdicio: DesperdicioIcon,
    padronizacao: PadronizacaoIcon,
    visibilidade: VisibilidadeIcon,
    escalabilidade: EscalabilidadeIcon,
    base: BaseIcon,
    "eliminacao-planilhas": EliminacaoPlanilhasIcon,
    "reducao-retrabalho": ReducaoRetrabalhoIcon,
    "padronizacao-apontamentos": PadronizacaoApontamentosIcon,
    "agilidade-tratavias": AgilidadeTratativasIcon,
    "maior-rastreabilidade": MaiorRastreabilidadeIcon,
    "evidencias-visuais": EvidenciasVisuaisIcon,
    "melhoria-qualidade": MelhoriaQualidadeIcon,
    "maior-engajamento": MaiorEngajamentoIcon,
    "base-estruturada": BaseEstruturadaIcon,
};
---

<Layout>
    <div
        class="case-hero-section"
        style={`background-image: url(${optimizedBackground.src})`}
    >
        <div class="hero-overlay"></div>
        <div class="container-boxed hero-grid">
            <div
                class={entry.data.heroMockup
                    ? "hero-content has-mockup"
                    : "hero-content"}
            >
                <div class="hero-text-container">
                    <img
                        class="hero-img"
                        src={optimizedBackground.src}
                        alt={entry.data.title}
                    />
                    <h1>{entry.data.title}</h1>
                    <h2 class="hero-subtitle">{entry.data.subtitle}</h2>
                    <p class="hero-description">{entry.data.description}</p>

                    {
                        entry.data.stats && (
                            <div class="stats-container">
                                {entry.data.stats.map((stat: any) => (
                                    <div class="stat-card">
                                        <span
                                            class="stat-value"
                                            data-value={stat.value}
                                        >
                                            0
                                        </span>
                                        <p class="stat-label">{stat.label}</p>
                                    </div>
                                ))}
                            </div>
                        )
                    }
                </div>

                {
                    entry.data.heroMockup && (
                        <div class="hero-mockup-container">
                            <div class="macbook-gradient" />
                            <Image
                                src={resolvedHeroMockup}
                                alt="Case Hero Mockup"
                                class="hero-mockup-image"
                                width={1200}
                                height={750}
                            />
                        </div>
                    )
                }
            </div>
        </div>
    </div>

    {
        (entry.data.companyName || entry.data.testimonial) && (
            <div class="case-details-testimonial-section">
                <div class="container-boxed">
                    {entry.data.companyName && (
                        <div class="case-info-bar">
                            <div class="info-item">
                                <strong>EMPRESA</strong>
                                <span>{entry.data.companyName}</span>
                            </div>
                            <div class="info-divider" />
                            <div class="info-item">
                                <strong>LOCALIZAÇÃO</strong>
                                <span>{entry.data.location}</span>
                            </div>
                            <div class="info-divider" />
                            <div class="info-item">
                                <strong>SEGMENTO</strong>
                                <span>{entry.data.segment}</span>
                            </div>
                            <div class="info-divider" />
                            <div class="info-item">
                                <strong>STACK</strong>
                                <span>{entry.data.stack}</span>
                            </div>
                        </div>
                    )}

                    {entry.data.testimonial && (
                        <div class="case-testimonial-wrapper">
                            <div class="case-testimonial-card">
                                <p class="testimonial-text">
                                    {entry.data.testimonial.text}
                                </p>
                                <div class="testimonial-footer">
                                    <div class="author-info">
                                        <Image
                                            src={resolvedTestimonialPhoto}
                                            alt={entry.data.testimonial.author}
                                            class="author-photo"
                                            width={80}
                                            height={80}
                                        />
                                        <div class="author-details">
                                            <strong>
                                                {entry.data.testimonial.author}
                                            </strong>
                                            <span>
                                                {entry.data.testimonial.job}
                                            </span>
                                        </div>
                                    </div>
                                    <Image
                                        src={resolvedTestimonialLogo}
                                        alt="Company Logo"
                                        class="company-logo"
                                        width={120}
                                        height={40}
                                    />
                                </div>
                            </div>
                        </div>
                    )}
                </div>
            </div>
        )
    }

    <div class="case-content-section container-boxed">
        <div class="case-content-grid">
            <aside class="case-sidebar">
                <nav class="sticky-nav">
                    <ul>
                        <li>
                            <a href="#desafio" class="nav-link active"
                                >O desafio</a
                            >
                        </li>
                        {
                            entry.data.approachData && (
                                <li>
                                    <a href="#abordagem" class="nav-link">
                                        Abordagem
                                    </a>
                                </li>
                            )
                        }
                        <li>
                            <a href="#solucao" class="nav-link">A solução</a>
                        </li>
                        <li>
                            <a href="#resultados" class="nav-link">Resultados</a
                            >
                        </li>
                        {
                            entry.data.differentialData && (
                                <li>
                                    <a href="#diferencial" class="nav-link">
                                        Diferencial
                                    </a>
                                </li>
                            )
                        }
                    </ul>
                </nav>
            </aside>
            <main class="case-main-content">
                <div class="meta-info">
                    {
                        formattedDate && (
                            <div class="meta-tag">
                                <Image
                                    src={CalendarIcon}
                                    alt=""
                                    class="meta-icon"
                                />
                                <span>
                                    Publicado em{" "}
                                    <strong>{formattedDate}</strong>
                                </span>
                            </div>
                        )
                    }
                    {
                        entry.data.readingTime && (
                            <div class="meta-tag">
                                <Image
                                    src={TimeIcon}
                                    alt=""
                                    class="meta-icon"
                                />
                                <span>
                                    Tempo de leitura:{" "}
                                    <strong>{entry.data.readingTime}</strong>
                                </span>
                            </div>
                        )
                    }
                </div>

                <section id="intro" class="content-section">
                    {
                        entry.data.introTitle && (
                            <p class="intro-text">{entry.data.introTitle}</p>
                        )
                    }
                    <p
                        class={entry.data.introTitle
                            ? "section-description"
                            : "intro-text"}
                    >
                        {entry.data.introDescription || entry.data.description}
                    </p>
                </section>

                <section id="desafio" class="content-section scroll-section">
                    <h2 class="section-title">O desafio</h2>
                    <p class="section-description">{entry.data.challenge}</p>

                    {
                        (entry.data.problems || entry.data.necessities) && (
                            <div class="challenge-cards-grid">
                                <div class="challenge-card problems-card">
                                    <div class="card-header">
                                        <div class="icon-circle red">
                                            <Image
                                                src={ThumbsDownIcon}
                                                alt=""
                                            />
                                        </div>
                                        <h3>Problemas</h3>
                                    </div>
                                    <ul class="card-list">
                                        {entry.data.problems.map(
                                            (item: string) => (
                                                <li>
                                                    <Image
                                                        src={CloseIcon}
                                                        alt=""
                                                        class="list-icon"
                                                    />
                                                    <span>{item}</span>
                                                </li>
                                            )
                                        )}
                                    </ul>
                                </div>

                                <div class="challenge-card necessities-card">
                                    <div class="card-header">
                                        <div class="icon-circle blue">
                                            <Image src={ThumbsUpIcon} alt="" />
                                        </div>
                                        <h3>Necessidades</h3>
                                    </div>
                                    <ul class="card-list">
                                        {entry.data.necessities.map(
                                            (item: string) => (
                                                <li>
                                                    <Image
                                                        src={RightArrowIcon}
                                                        alt=""
                                                        class="list-icon"
                                                    />
                                                    <span>{item}</span>
                                                </li>
                                            )
                                        )}
                                    </ul>
                                </div>
                            </div>
                        )
                    }
                </section>

                {
                    entry.data.approachData && (
                        <section
                            id="abordagem"
                            class="content-section scroll-section"
                        >
                            <h2 class="section-title">
                                {entry.data.approachData.title}
                            </h2>
                            <div class="approach-content">
                                <p class="section-description">
                                    {entry.data.approachData.description}
                                </p>

                                {entry.data.approachData.subtitle && (
                                    <h3
                                        class="approach-subtitle"
                                        style="margin-top: 2rem; margin-bottom: 1.5rem;"
                                    >
                                        {entry.data.approachData.subtitle}
                                    </h3>
                                )}

                                <ul class="solution-list">
                                    {entry.data.approachData.items.map(
                                        (item: any) => (
                                            <li>
                                                <Image
                                                    src={RightArrowIcon}
                                                    alt=""
                                                    class="solution-list-icon"
                                                />
                                                <span>
                                                    <strong>
                                                        {item.title}:
                                                    </strong>{" "}
                                                    {item.text}
                                                </span>
                                            </li>
                                        )
                                    )}
                                </ul>
                            </div>
                        </section>
                    )
                }

                <section id="solucao" class="content-section scroll-section">
                    <h2 class="section-title">A solução</h2>
                    {
                        entry.data.solutionData ? (
                            <div class="solution-content">
                                <p class="section-description">
                                    {entry.data.solutionData.description}
                                </p>

                                <div class="solution-macbook-container">
                                    <div class="macbook-gradient" />
                                    <Image
                                        src={resolvedSolutionImage}
                                        alt="Platform on MacBook"
                                        class="macbook-image"
                                        width={1200}
                                        height={750}
                                    />
                                </div>

                                {entry.data.solutionData.features && (
                                    <div class="infrastructure-section">
                                        <h3>
                                            {
                                                entry.data.solutionData.features
                                                    .title
                                            }
                                        </h3>
                                        <ul class="solution-list">
                                            {entry.data.solutionData.features.items.map(
                                                (item: string) => (
                                                    <li>
                                                        <Image
                                                            src={
                                                                ArrowRight2Icon
                                                            }
                                                            alt=""
                                                            class="solution-list-icon"
                                                        />
                                                        <span set:html={item} />
                                                    </li>
                                                )
                                            )}
                                        </ul>
                                    </div>
                                )}

                                {entry.data.solutionData.infrastructure && (
                                    <div class="infrastructure-section">
                                        <h3>
                                            {
                                                entry.data.solutionData
                                                    .infrastructure.title
                                            }
                                        </h3>
                                        <p class="section-description">
                                            {
                                                entry.data.solutionData
                                                    .infrastructure.description
                                            }
                                        </p>

                                        <ul class="solution-list">
                                            {entry.data.solutionData.infrastructure.items.map(
                                                (item: string) => (
                                                    <li>
                                                        <Image
                                                            src={
                                                                ArrowRight2Icon
                                                            }
                                                            alt=""
                                                            class="solution-list-icon"
                                                        />
                                                        <span>{item}</span>
                                                    </li>
                                                )
                                            )}
                                        </ul>

                                        {entry.data.solutionData.sensors && (
                                            <div class="sensors-section">
                                                <h3>
                                                    {
                                                        entry.data.solutionData
                                                            .sensors.title
                                                    }
                                                </h3>
                                                <ul class="solution-list">
                                                    {entry.data.solutionData.sensors.items.map(
                                                        (item: string) => (
                                                            <li>
                                                                <Image
                                                                    src={
                                                                        ArrowRight2Icon
                                                                    }
                                                                    alt=""
                                                                    class="solution-list-icon"
                                                                />
                                                                <span>
                                                                    {item}
                                                                </span>
                                                            </li>
                                                        )
                                                    )}
                                                </ul>
                                            </div>
                                        )}

                                        {entry.data.solutionData.callout && (
                                            <div class="solution-callout">
                                                <Image
                                                    src={ArrowRight2Icon}
                                                    alt=""
                                                    class="solution-list-icon"
                                                />
                                                <p
                                                    set:html={
                                                        entry.data.solutionData
                                                            .callout
                                                    }
                                                />
                                            </div>
                                        )}
                                    </div>
                                )}

                                {entry.data.solutionData.monitoring && (
                                    <div class="infrastructure-section">
                                        <h3>
                                            {
                                                entry.data.solutionData
                                                    .monitoring.title
                                            }
                                        </h3>
                                        <p class="section-description">
                                            {
                                                entry.data.solutionData
                                                    .monitoring.description
                                            }
                                        </p>

                                        <ul class="solution-list">
                                            {entry.data.solutionData.monitoring.items.map(
                                                (item: string) => (
                                                    <li>
                                                        <Image
                                                            src={
                                                                ArrowRight2Icon
                                                            }
                                                            alt=""
                                                            class="solution-list-icon"
                                                        />
                                                        <span>{item}</span>
                                                    </li>
                                                )
                                            )}
                                        </ul>

                                        {entry.data.solutionData.monitoring
                                            .additionalTitle && (
                                            <div class="additional-info">
                                                <h3>
                                                    {
                                                        entry.data.solutionData
                                                            .monitoring
                                                            .additionalTitle
                                                    }
                                                </h3>
                                                <ul class="solution-list">
                                                    {entry.data.solutionData.monitoring.additionalItems?.map(
                                                        (item: string) => (
                                                            <li>
                                                                <Image
                                                                    src={
                                                                        ArrowRight2Icon
                                                                    }
                                                                    alt=""
                                                                    class="solution-list-icon"
                                                                />
                                                                <span>
                                                                    {item}
                                                                </span>
                                                            </li>
                                                        )
                                                    )}
                                                </ul>
                                            </div>
                                        )}

                                        <div class="solution-callout">
                                            <Image
                                                src={ArrowRight2Icon}
                                                alt=""
                                                class="solution-list-icon"
                                            />
                                            <p
                                                set:html={
                                                    entry.data.solutionData
                                                        .monitoring.callout
                                                }
                                            />
                                        </div>
                                    </div>
                                )}

                                {entry.data.solutionData.intelligence && (
                                    <div class="infrastructure-section">
                                        <h3>
                                            {
                                                entry.data.solutionData
                                                    .intelligence.title
                                            }
                                        </h3>
                                        <p class="section-description">
                                            {
                                                entry.data.solutionData
                                                    .intelligence.description
                                            }
                                        </p>

                                        <ul class="solution-list">
                                            {entry.data.solutionData.intelligence.items.map(
                                                (item: string) => (
                                                    <li>
                                                        <Image
                                                            src={
                                                                ArrowRight2Icon
                                                            }
                                                            alt=""
                                                            class="solution-list-icon"
                                                        />
                                                        <span>{item}</span>
                                                    </li>
                                                )
                                            )}
                                        </ul>

                                        <div class="solution-callout">
                                            <Image
                                                src={ArrowRight2Icon}
                                                alt=""
                                                class="solution-list-icon"
                                            />
                                            <p
                                                set:html={
                                                    entry.data.solutionData
                                                        .intelligence.callout
                                                }
                                            />
                                        </div>
                                    </div>
                                )}
                            </div>
                        ) : (
                            <p class="section-description">
                                {entry.data.solution}
                            </p>
                        )
                    }
                </section>

                <section id="resultados" class="content-section scroll-section">
                    <h2 class="section-title">Resultados</h2>
                    {
                        entry.data.resultsData ? (
                            <div class="results-content">
                                <p class="section-description">
                                    {entry.data.resultsData.description}
                                </p>

                                <div class="results-macbook-container">
                                    <div class="macbook-gradient" />
                                    <Image
                                        src={resolvedResultsImage}
                                        alt="Results on MacBook"
                                        class="macbook-image"
                                        width={1200}
                                        height={750}
                                    />
                                </div>

                                <p class="impact-title">
                                    {entry.data.resultsData.impactTitle}
                                </p>

                                <div class="impacts-grid">
                                    {entry.data.resultsData.impacts.map(
                                        (impact: any) => (
                                            <div class="impact-card">
                                                <div class="impact-icon-wrapper">
                                                    <Image
                                                        src={
                                                            iconMap[impact.icon]
                                                        }
                                                        alt=""
                                                        class="impact-icon"
                                                        width={40}
                                                        height={40}
                                                    />
                                                </div>
                                                <p class="impact-text">
                                                    {impact.title}
                                                </p>
                                            </div>
                                        )
                                    )}
                                </div>
                            </div>
                        ) : (
                            <p class="section-description">
                                {entry.data.result}
                            </p>
                        )
                    }
                </section>

                <section
                    id="diferencial"
                    class="content-section scroll-section"
                >
                    {
                        entry.data.differentialData ? (
                            <div class="differential-section">
                                <h2 class="section-title">
                                    {entry.data.differentialData.title}
                                </h2>
                                <p class="section-description">
                                    {entry.data.differentialData.description}
                                </p>
                                <p class="sub-description">
                                    {entry.data.differentialData.subDescription}
                                </p>
                                <ul class="differential-list">
                                    {entry.data.differentialData.items.map(
                                        (item: string) => (
                                            <li>
                                                <Image
                                                    src={CheckIcon}
                                                    alt=""
                                                    class="list-check-icon"
                                                />
                                                <span>{item}</span>
                                            </li>
                                        )
                                    )}
                                </ul>

                                <div class="cta-card">
                                    <div class="cta-content">
                                        <Image
                                            src={RocketIcon}
                                            alt=""
                                            class="cta-icon"
                                        />
                                        <p
                                            class="cta-text"
                                            set:html={
                                                entry.data.differentialData.cta
                                                    .text
                                            }
                                        />
                                    </div>
                                    <a
                                        href={
                                            entry.data.differentialData.cta
                                                .buttonLink
                                        }
                                        class="cta-button"
                                    >
                                        {
                                            entry.data.differentialData.cta
                                                .buttonText
                                        }
                                    </a>
                                </div>
                            </div>
                        ) : (
                            entry.data.differential && (
                                <>
                                    <h2 class="section-title">Diferencial</h2>
                                    <p class="section-description">
                                        {entry.data.differential}
                                    </p>
                                </>
                            )
                        )
                    }
                </section>

                <div class="case-body">
                    <Content />
                </div>
            </main>
        </div>
    </div>

    <FaleConosco />

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        gsap.registerPlugin(ScrollTrigger);

        const statsValues = document.querySelectorAll(".stat-value");

        statsValues.forEach((el) => {
            const element = el as HTMLElement;
            const targetValueStr = element.getAttribute("data-value") || "0";
            const numericValue =
                parseFloat(targetValueStr.replace(/[^\d.-]/g, "")) || 0;
            const nonNumeric = targetValueStr.replace(/[\d.,-]/g, "");
            const hasPlus = targetValueStr.startsWith("+");
            const isPercent = targetValueStr.endsWith("%");

            gsap.to(element, {
                innerText: numericValue,
                duration: 2,
                snap: { innerText: 1 },
                scrollTrigger: {
                    trigger: element,
                    start: "top 90%",
                },
                onUpdate: function () {
                    let current = Math.floor(
                        parseFloat((this.targets()[0] as HTMLElement).innerText)
                    );
                    let formatted = current
                        .toString()
                        .replace(/\B(?=(\d{3})+(?!\d))/g, ".");

                    if (hasPlus) formatted = "+" + formatted;
                    if (isPercent) formatted = formatted + "%";
                    else if (nonNumeric && !isPercent)
                        formatted = formatted + nonNumeric;

                    element.innerText = formatted;
                },
            });
        });

        // ScrollSpy logic for sidebar
        const sections = document.querySelectorAll(".scroll-section");
        const navLinks = document.querySelectorAll(".nav-link");

        sections.forEach((section) => {
            ScrollTrigger.create({
                trigger: section,
                start: "top 200px",
                end: "bottom 200px",
                onEnter: () => setActiveLink(section.id),
                onEnterBack: () => setActiveLink(section.id),
            });
        });

        function setActiveLink(id: string) {
            navLinks.forEach((link) => {
                link.classList.remove("active");
                if (link.getAttribute("href") === `#${id}`) {
                    link.classList.add("active");
                }
            });
        }
    </script>
</Layout>
