---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, render } from 'astro:content';
import { Image } from "astro:assets";
import Badge2 from "../../../components/Badge2.astro";

export async function getStaticPaths() {
  const enCases = await getCollection('cases', ({ id }) => {
    return id.startsWith('en/');
  });

  return enCases.map(entry => ({
    params: { slug: entry.id.replace('en/', '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout>
    <div class="case-hero-section">
        <div class="container-boxed hero-grid">
            <div class="hero-content">
                <div class="badges">
                    {entry.data.badges.map((badge: string) => (
                        <Badge2 text={badge} />
                    ))}
                </div>
                <h1>{entry.data.title}</h1>
                <h2 class="hero-subtitle">{entry.data.subtitle}</h2>
                <p class="hero-description">{entry.data.description}</p>
                
                {entry.data.stats && (
                    <div class="stats-container">
                        {entry.data.stats.map((stat: any) => (
                            <div class="stat-card">
                                <span class="stat-value" data-value={stat.value}>0</span>
                                <p class="stat-label">{stat.label}</p>
                            </div>
                        ))}
                    </div>
                )}
            </div>
            <div class="hero-image">
                <Image src={entry.data.image} alt={entry.data.title} class="main-img" />
            </div>
        </div>
    </div>

    <div class="case-content-section container-boxed">
        <div class="case-content-grid">
            <div class="case-info">
                <div class="detail-section">
                    <strong>Challenge</strong>
                    <p>{entry.data.challenge}</p>
                </div>
                <div class="detail-section">
                    <strong>Solution</strong>
                    <p>{entry.data.solution}</p>
                </div>
                <div class="detail-section">
                    <strong>Result</strong>
                    <p>{entry.data.result}</p>
                </div>
            </div>
            <div class="case-body">
                <Content />
            </div>
        </div>
    </div>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        gsap.registerPlugin(ScrollTrigger);

        const statsValues = document.querySelectorAll(".stat-value");
        
        statsValues.forEach((el) => {
            const element = el as HTMLElement;
            const targetValueStr = element.getAttribute("data-value") || "0";
            const numericValue = parseFloat(targetValueStr.replace(/[^\d.-]/g, '')) || 0;
            const nonNumeric = targetValueStr.replace(/[\d.,-]/g, '');
            const hasPlus = targetValueStr.startsWith('+');
            const isPercent = targetValueStr.endsWith('%');

            gsap.to(element, {
                innerText: numericValue,
                duration: 2,
                snap: { innerText: 1 },
                scrollTrigger: {
                    trigger: element,
                    start: "top 90%",
                },
                onUpdate: function() {
                    let current = Math.floor(parseFloat((this.targets()[0] as HTMLElement).innerText));
                    let formatted = current.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                    
                    if (hasPlus) formatted = '+' + formatted;
                    if (isPercent) formatted = formatted + '%';
                    else if (nonNumeric && !isPercent) formatted = formatted + nonNumeric;
                    
                    element.innerText = formatted;
                }
            });
        });
    </script>
</Layout>

<style>
    .case-hero-section {
        padding-top: 150px;
        padding-bottom: 80px;
        background: linear-gradient(to bottom, #0a0c10, #0d1117);
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 60px;
        align-items: center;
    }

    .hero-content h1 {
        font-size: clamp(32px, 4vw, 56px);
        line-height: 1.1;
        margin-top: 24px;
        margin-bottom: 24px;
        color: var(--white);
        font-weight: 700;
    }

    .hero-description {
        font-size: clamp(16px, 1.2vw, 20px);
        color: var(--white-70);
        margin-bottom: 40px;
        max-width: 90%;
        line-height: 1.6;
    }

    .stats-container {
        display: flex;
        gap: 20px;
        margin-top: 40px;
    }

    .stat-card {
        flex: 1;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 32px 24px;
        border-radius: 20px;
        transition: transform 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.05);
    }

    .stat-value {
        display: block;
        font-size: clamp(28px, 2.5vw, 40px);
        font-weight: 700;
        color: var(--white);
        margin-bottom: 8px;
    }

    .stat-label {
        font-size: clamp(13px, 0.9vw, 15px);
        color: var(--white-60);
        line-height: 1.4;
    }

    .hero-image {
        position: relative;
    }

    .main-img {
        width: 100%;
        height: auto;
        border-radius: 24px;
        object-fit: cover;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    .case-content-section {
        padding-bottom: 120px;
    }

    .case-content-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 80px;
    }

    .detail-section {
        margin-bottom: 40px;
        background: rgba(255, 255, 255, 0.02);
        padding: 24px;
        border-radius: 16px;
    }

    .detail-section strong {
        display: block;
        color: var(--primary);
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 12px;
    }

    .detail-section p {
        color: var(--white-80);
        line-height: 1.7;
        font-size: 1.05rem;
    }

    .case-body {
        color: var(--white-90);
        line-height: 1.8;
        font-size: 1.1rem;
    }

    @media (max-width: 1024px) {
        .hero-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .hero-image {
            order: -1;
        }

        .case-content-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .hero-content {
            text-align: left;
        }
        
        .stats-container {
            flex-direction: column;
        }
    }
</style>
