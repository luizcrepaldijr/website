---
import Layout from "../../layouts/Layout.astro";
import "../../styles/pages/home.css";
import FaleConosco from "../../components/FaleConosco.astro";
import { Image } from "astro:assets";
import CuboImg from "../../images/home/hero/cubo.webp";
import ParceirosMarquee from "../../components/ParceirosMarquee.astro";
import SobreNosArk from "../../images/home/sobrenos/sobre-nos-ark.webp";
import TecnologiaAvancada from "../../images/home/sobrenos/tecnologia-avancada.webp";
import { getCollection } from "astro:content";
import PowerBI from "../../images/home/cases/power-bi.webp";
import Python from "../../images/home/cases/python.webp";
import Meta from "../../images/home/cases/meta.webp";
import Azure from "../../images/home/cases/azure.webp";
import ReactAdmin from "../../images/home/cases/react-admin.webp";
import TechIcon from "../../components/TechIcon.astro";

const enCases = await getCollection("cases", ({ id, data }) => {
  return id.startsWith("en/") && data.featured === true;
});
import CurvaImg from "../../images/home/curva/curva.webp";
import ButtonArrowAnimation from "../../components/buttons/ButtonArrowAnimation.astro";
import ButtonArrow from "../../components/buttons/ButtonArrow.astro";
import ButtonArrowWhite from "../../components/buttons/ButtonArrowWhite.astro";
import CarousselSolutions from "../../components/carroussel/CarousselSolutions.astro";
import CarousselCases from "../../components/carroussel/CarousselCases.astro";
import Badge from "../../components/Badge.astro";
import Badge2 from "../../components/Badge2.astro";
import Counter from "../../components/Counter.astro";
---

<Layout>
  <!-- HERO -->
  <div class="hero container-boxed">
    <div class="content">
      <h1>Technology that <b>accelerates</b> your digital transformation</h1>
      <h3>
        We build custom digital solutions to integrate systems, optimize
        processes, and support strategic decision-making.
      </h3>
      <span class="button">
        <ButtonArrowAnimation text="Get started" />
      </span>
    </div>

    <div class="cubo-img-wrapper">
      <video
        src="/videos/cubo-hero.webm"
        class="cuboImg"
        autoplay
        loop
        muted
        playsinline
        poster={CuboImg.src}></video>
    </div>
  </div>

  <!-- PARCEIROS GLOBAIS -->
  <ParceirosMarquee lang="en" class="container-boxed" />

  <!-- SERVIÇOS -->
  <div class="servicos container">
    <div class="container-boxed">
      <div class="servicos-title">
        <span class="text-container">
          <h2>
            End-to-end integrated solutions to strenghten your competitiveness
          </h2>
          <h3>
            We work from planning to execution, connecting technology,
            processes, and data.
          </h3>
        </span>

        <span class="button-container">
          <ButtonArrow text="Explore all services" link="./solutions" />
        </span>
      </div>
      <CarousselSolutions>
        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source
              src="/videos/home/transformacao-digital.webm"
              type="video/mp4"
            />
          </video>

          <h4>Digital Transformation</h4>
          <p>
            We empower your business through intelligent, connected, and
            data-driven solutions.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/home/industria-4-0.webm" type="video/mp4" />
          </video>

          <h4>Industry 4.0</h4>
          <p>
            We connect the physical and digital world to increase visibility,
            control, and industrial performance.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/home/engenharia.webm" type="video/mp4" />
          </video>

          <h4>Engineering</h4>
          <p>
            We transform complex ideas into viable and efficient technical
            solutions.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/home/agricultura-4-0.webm" type="video/mp4" />
          </video>

          <h4>Agriculture 4.0</h4>
          <p>
            We help producers and agricultural operations make better decisions
            using real field data.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/home/Iot.webm" type="video/mp4" />
          </video>

          <h4>IoT</h4>
          <p>
            We connect assets, processes, and environments to generate
            operational intelligence, predictability, and real-time efficiency.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/home/robotica.webm" type="video/mp4" />
          </video>

          <h4>Robotics</h4>
          <p>
            We automate processes with intelligent robotic systems to increase
            productivity, precision, and operational safety.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source
              src="/videos/home/realidade-digital.webm"
              type="video/mp4"
            />
          </video>

          <h4>Digital Reality</h4>
          <p>
            We integrate the physical and digital world through immersive
            experiences that enhance training, operations, and decision-making.
          </p>
        </div>
      </CarousselSolutions>
    </div>
  </div>

  <!-- SOBRE NÓS -->
  <div class="sobre-nos container-boxed">
    <Image class="ark" src={SobreNosArk} alt="" />
    <Badge text="About us" />
    <h2>
      We are a consultancy specialized in digitizing <b>complex operations</b>
    </h2>
    <div class="sobrenos-content">
      <video
        src="/videos/home/transformatech.webm"
        class="tecnologia-avancada"
        autoplay
        loop
        muted
        playsinline
        poster={TecnologiaAvancada.src}></video>
      <div>
        <h4>
          We use advanced technology to transform data into strategic direction.
        </h4>

        <h3>
          We connect engineering, automation, and intelligent analysis
          precisely. Operating in Brazil and the US, we work closely with
          operations to understand real challenges and anticipate needs with
          applied and efficient solutions.
          <br /><br />
          Our culture is practical and results-oriented: every delivery must generate
          measurable impact, reduce risks, and elevate competitiveness. More than
          implementing systems, we act as long-term partners, combining technical
          vision and digital strategy to evolve your operation from end to end.
        </h3>

        <ButtonArrow text="Learn more" link="./about-us" />
      </div>
    </div>
  </div>

  <!-- NUMEROS -->
  <div class="numeros container-boxed">
    <h2>Numbers that reflect our impact</h2>
    <div class="counter-wrapper">
      <Counter prenumber="+" number="400" description="Projects delivered" />
      <Counter prenumber="+" number="10" description="Connected factories" />
      <Counter
        prenumber="+"
        number="200"
        description="Connected data sources"
      />
      <Counter prenumber="+" number="10" description="Cities served" />
    </div>
  </div>

  <!-- CASES -->
  <div class="cases container-boxed">
    <Badge text="Case Studies" />
    <h2>Results that <b>transform</b></h2>
    <h3>Real cases demonstrating how our solutions generate business impact</h3>
    <CarousselCases>
      {
        enCases.map((entry) => (
          <div class="embla__cases__slide">
            <div class="cases-card">
              <Image
                src={entry.data.image}
                alt={entry.data.title}
                class="unilever"
              />
              <div class="cases-card-content">
                <div class="badges">
                  {entry.data.badges.map((badge) => (
                    <Badge2 text={badge} />
                  ))}
                </div>
                <h2>
                  {entry.data.homeTitle || entry.data.title}
                </h2>
                <p>
                  {entry.data.description}
                </p>
                <div class="tecnologias">
                  <h4>Technologies used</h4>
                  <div class="tecnologias-images">
                    {
                      (entry.data.technologies || ["power-bi", "python", "meta", "azure", "react-admin"]).map((tech) => (
                        <TechIcon name={tech} />
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </CarousselCases>
    <ButtonArrow text="View case studies" link="./cases" />
  </div>

  <!-- CURVA -->
  <div class="curva container-boxed">
    <h2 class="typewriter-text">
      Advanced technology integrating data, people and end-to-end processes for
      more competitive businesses.
    </h2>
    <ButtonArrowWhite text="Talk to a specialist" />
    <video
      src="/videos/home/curva.webm"
      class="curva-img"
      autoplay
      loop
      muted
      playsinline
      poster={CurvaImg.src}></video>
  </div>

  <!-- FALE COM O TIME -->
  <FaleConosco
    title="Ready to digitize your business?"
    subtitle="Talk to our team and discover how technology can work for your business."
    buttonText="Talk to a specialist"
  />
</Layout>
