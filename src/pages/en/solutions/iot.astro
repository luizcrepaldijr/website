---
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/pages/iot.css";
import IotHeroFallback from "../../../images/iot/iot-hero.webp";
import LorawanFallback from "../../../images/iot/lorawan.webp";
import IotParaIndustriaFallback from "../../../images/iot/iot-para-industria.webp";
import IotParaIndustria2Fallback from "../../../images/iot/iot-para-industria-2.webp";
import SensorAgroFallback from "../../../images/iot/sensor-agro.webp";
import IotParaAgriculturaFallback from "../../../images/iot/iot-para-agricultura.webp";
import ButtonArrowAnimation from "../../../components/buttons/ButtonArrowAnimation.astro";
import ButtonArrowWhite from "../../../components/buttons/ButtonArrowWhite.astro";
import Badge from "../../../components/Badge.astro";
import { Icon } from "astro-icon/components";
import LogoBigFallback from "../../../images/logo-big.webp";
import Accordion from "../../../components/Accordion.astro";
import CarousselWorkflow from "../../../components/carroussel/CarousselWorkflow.astro";

const wfSteps = [
    {
        title: "Technical assessment of the operation",
        desc: "Deep understanding of processes, machines, and real-world challenges.",
    },
    {
        title: "Sensor strategy",
        desc: "Definition of sensors, measurement points, and the ideal architecture.",
    },
    {
        title: "Data architecture",
        desc: "Gateways, LoRaWAN networks, dashboards, APIs, and integrations.",
    },
    {
        title: "Installation and commissioning",
        desc: "Field execution, testing, and performance validation.",
    },
    {
        title: "Support and continuous evolution",
        desc: "Monitoring, adjustments, maintenance, and expansion as the operation grows.",
    },
];
---

<Layout title="IoT">
    <div class="iot-hero container-boxed">
        <div class="content">
            <h1>
                <b>IoT:</b> transforming data into real decisions
            </h1>
            <h3>
                We connect assets, processes, and physical environments to
                generate operational intelligence, predictability, and
                efficiency in real time.
            </h3>

            <ButtonArrowAnimation text="Request this service" />
        </div>

        <div class="iot-img-wrapper">
            <video
                src="/videos/iot/iot-hero.webm"
                class="iotImg"
                autoplay
                loop
                muted
                playsinline
                poster={IotHeroFallback.src}></video>
        </div>
        <Icon name="arrow-down" class="arrow-down" />
    </div>

    <div class="iot-section-2 container-boxed">
        <div class="content">
            <h2>
                Industry increasingly demands control, predictability, and
                efficiency.
            </h2>
            <h3>
                IoT (Internet of Things) makes it possible to turn production
                processes into intelligent environments that continuously
                capture data and generate immediate insights for
                decision-making.
            </h3>
            <p><b>With IoT it is possible to do:</b></p>
        </div>

        <div class="iot-checklist">
            <div class="iot-checklist-item">
                <Icon name="check" size={24} />
                <span>Continuous monitoring of critical variables</span>
            </div>
            <div class="iot-checklist-item">
                <Icon name="check" size={24} />
                <span>Early detection of failures and anomalies</span>
            </div>
            <div class="iot-checklist-item">
                <Icon name="check" size={24} />
                <span>Greater reliability and predictability</span>
            </div>
            <div class="iot-checklist-item">
                <Icon name="check" size={24} />
                <span>Reduced waste and operational costs</span>
            </div>
        </div>
    </div>

    <div class="lorawan-section container-boxed">
        <div class="lorawan-header">
            <Badge text="Technology" />
            <h2>
                <b></b>We use LoRaWAN technology
            </h2><br />
            <span>as the foundation of our IoT solutions</span>
        </div>
    </div>

    <div class="lorawan-visual">
        <div class="lorawan-label lorawan-label-1 lorawan-anim" data-delay="0">
            <div class="lbl-text">
                Long range and<br />scalability across<br />large areas
            </div>
            <svg
                class="lbl-line line-1"
                viewBox="0 0 100 100"
                preserveAspectRatio="none"
            >
                <line
                    x1="0"
                    y1="0"
                    x2="100"
                    y2="100"
                    stroke="rgba(255,255,255,0.4)"
                    stroke-width="1"
                    stroke-dasharray="4 4"></line>
            </svg>
        </div>

        <div class="lorawan-label lorawan-label-2 lorawan-anim" data-delay="1">
            <div class="lbl-text">
                Low power consumption<br />and extended<br />battery life
            </div>
            <svg
                class="lbl-line line-2"
                viewBox="0 0 2 100"
                preserveAspectRatio="none"
            >
                <line
                    x1="1"
                    y1="0"
                    x2="1"
                    y2="100"
                    stroke="rgba(255,255,255,0.4)"
                    stroke-width="1"
                    stroke-dasharray="4 4"></line>
            </svg>
        </div>

        <div class="lorawan-video-wrapper">
            <video
                src="/videos/iot/lorawan.webm"
                class="lorawan-video"
                autoplay
                loop
                muted
                playsinline
                poster={LorawanFallback.src}></video>
        </div>

        <div class="lorawan-label lorawan-label-3 lorawan-anim" data-delay="2">
            <div class="lbl-text">
                Drastic reduction in<br />wiring and installation<br />costs
            </div>
            <svg
                class="lbl-line line-3"
                viewBox="0 0 2 100"
                preserveAspectRatio="none"
            >
                <line
                    x1="1"
                    y1="0"
                    x2="1"
                    y2="100"
                    stroke="rgba(255,255,255,0.4)"
                    stroke-width="1"
                    stroke-dasharray="4 4"></line>
            </svg>
        </div>

        <div class="lorawan-label lorawan-label-4 lorawan-anim" data-delay="3">
            <div class="lbl-text">
                High reliability even in<br />environments with<br
                />interference
            </div>
            <svg
                class="lbl-line line-4"
                viewBox="0 0 100 100"
                preserveAspectRatio="none"
            >
                <line
                    x1="100"
                    y1="0"
                    x2="0"
                    y2="100"
                    stroke="rgba(255,255,255,0.4)"
                    stroke-width="1"
                    stroke-dasharray="4 4"></line>
            </svg>
        </div>
    </div>

    <p class="lorawan-footer">
        We build complete IoT solutions that integrate sensors, connectivity,
        analytical platforms, and continuous support, transforming raw data into
        actionable insights
    </p>
</Layout>

<!-- ── GLOBAL TABS ── -->
<div class="iot-global-tabs">
    <button class="active" data-panel="ind">IoT for industries</button>
    <button data-panel="agri">IoT for agriculture</button>
</div>

<!-- ── PANEL: INDÚSTRIAS ── -->
<div class="iot-panel" id="panel-ind">
    <div class="iot-industrias-master-scrollarea">
        <div class="iot-ind-pinned-master">
            <div class="iot-ind-pinned-content">
                <!-- Media -->
                <div class="iot-ind-medias">
                    <div class="iot-ind-media media-1">
                        <video
                            src="/videos/iot/iot-para-industria.webm"
                            autoplay
                            loop
                            muted
                            playsinline
                            poster={IotParaIndustriaFallback.src}></video>
                    </div>
                    <!-- Second media uses same video as requested -->
                    <div class="iot-ind-media media-2">
                        <video
                            src="/videos/iot/iot-para-industria-2.webm"
                            autoplay
                            loop
                            muted
                            playsinline
                            poster={IotParaIndustria2Fallback.src}></video>
                    </div>
                </div>

                <!-- Texts -->
                <div class="iot-ind-texts">
                    <div class="iot-ind-text text-1">
                        <h2>IoT for industry</h2>
                        <p>
                            Provides continuous visibility into operations by
                            capturing critical data directly from the shop
                            floor.
                        </p>
                    </div>

                    <div class="iot-ind-text text-2">
                        <h2>
                            Modern industry requires connected, predictable, and
                            efficient processes.
                        </h2>
                        <p>
                            Industrial IoT provides continuous visibility into
                            operations by capturing critical data directly from
                            the shop floor.
                        </p>
                    </div>

                    <div class="iot-ind-text text-3">
                        <h2>What we monitor</h2>
                        <p>Our main industrial applications:</p>
                        <div class="card-checklist">
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Automated process data collection</span>
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Vibration analysis in motors and critical
                                    equipment</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Packaging line monitoring for efficiency
                                    calculation (OEE)</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Data integration with analytics platforms
                                    and internal systems</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Reliable wireless communication via LoRaWAN</span
                                >
                            </div>
                        </div>
                    </div>

                    <div class="iot-ind-text text-4">
                        <h2>Results obtained with Industrial IoT</h2>
                        <p>This data feeds a platform that delivers:</p>
                        <div class="card-checklist">
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Fewer failures and unexpected downtimes</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Significant OEE improvement</span>
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Extended lifespan of critical assets</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >More control, traceability, and easier
                                    auditing</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Decisions based on reliable, real-time data</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── IOT INDÚSTRIAS MOBILE ── -->
    <div class="iot-ind-mobile">
        <!-- Block 1 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-industria.webm"
                class="iot-ind-mobile-video"
                autoplay
                loop
                muted
                playsinline
                poster={IotParaIndustriaFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>IoT for industries</h2>
                <p>
                    Provides continuous visibility into operations by capturing
                    critical data directly from the shop floor.
                </p>
            </div>
        </div>

        <!-- Block 2 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-industria.webm"
                class="iot-ind-mobile-video"
                autoplay
                loop
                muted
                playsinline
                poster={IotParaIndustriaFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>
                    Modern industry requires connected, predictable, and
                    efficient processes.
                </h2>
                <p>
                    Industrial IoT provides continuous visibility into
                    operations by capturing critical data directly from the shop
                    floor.
                </p>
            </div>
        </div>

        <!-- Block 3 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-industria-2.webm"
                class="iot-ind-mobile-video"
                autoplay
                loop
                muted
                playsinline
                poster={IotParaIndustria2Fallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>What we monitor</h2>
                <p>Our main industrial applications:</p>
                <div class="card-checklist">
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Automated process data collection</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Vibration analysis in motors and critical equipment</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Packaging line monitoring for efficiency
                            calculation (OEE)</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Data integration with analytics platforms and
                            internal systems</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Reliable wireless communication via LoRaWAN</span
                        >
                    </div>
                </div>
            </div>
        </div>

        <!-- Block 4 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-industria-2.webm"
                class="iot-ind-mobile-video"
                autoplay
                loop
                muted
                playsinline
                poster={IotParaIndustria2Fallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>Results achieved with Industrial IoT</h2>
                <p>This data feeds a platform that delivers:</p>
                <div class="card-checklist">
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Fewer of failures and unexpected downtimes</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Significant OEE improvement</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Extended lifespan of critical assets</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >More control, traceability, and easier auditing</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Decisions based on reliable, real-time data</span
                        >
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── IOT WORKFLOW ── -->
    <div class="iot-workflow-scrollarea">
        <div class="iot-workflow-pinned">
            <!-- Decorative rings -->
            <div class="wf-ring wf-ring-1"></div>
            <div class="wf-ring wf-ring-2"></div>

            <!-- Rotating logo -->
            <div class="wf-logo-wrapper">
                <img src={LogoBigFallback.src} class="wf-logo" alt="" />
            </div>

            <!-- Right content (desktop) -->
            <div class="wf-content">
                <div class="wf-header">
                    <h2>How we deliver IoT in the Industry</h2>
                    <span class="wf-subtitle">Our workflow</span>
                </div>

                <div class="wf-steps-area">
                    {
                        wfSteps.map((step, i) => (
                            <div class={`wf-step wf-step-${i}`}>
                                <div class="wf-line" />
                                <span class="wf-dot">
                                    <Icon name="dot" size={8} />
                                </span>
                                <h3>{step.title}</h3>
                                <p class="wf-desc">{step.desc}</p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Mobile carousel -->
            <div class="wf-mobile-carousel">
                <div class="wf-mobile-header">
                    <h2>How we deliver IoT in the Industry</h2>
                    <span class="wf-subtitle">OUR WORKFLOW</span>
                </div>
                <CarousselWorkflow
                    steps={wfSteps}
                    logoSrc={LogoBigFallback.src}
                />
            </div>
        </div>
    </div><!-- close iot-workflow-scrollarea -->
</div><!-- close #panel-ind -->

<!-- ── PANEL: AGRICULTURA ── -->
<div class="iot-panel" id="panel-agri">
    <!-- ── IOT AGRICULTURA ── -->
    <div class="iot-agricultura-master-scrollarea">
        <div class="iot-agri-pinned-master">
            <div class="iot-agri-pinned-content">
                <!-- Media -->
                <div class="iot-agri-medias">
                    <div class="iot-agri-media agri-media-1">
                        <video
                            src="/videos/iot/sensor-agro.webm"
                            autoplay
                            loop
                            muted
                            playsinline
                            poster={SensorAgroFallback.src}></video>
                    </div>
                    <div class="iot-agri-media agri-media-2">
                        <video
                            src="/videos/iot/iot-para-agricultura.webm"
                            autoplay
                            loop
                            muted
                            playsinline
                            poster={IotParaAgriculturaFallback.src}></video>
                    </div>
                </div>

                <!-- Texts -->
                <div class="iot-agri-texts">
                    <div class="iot-agri-text agri-text-1">
                        <h2>IoT for agriculture</h2>
                        <p>
                            Water efficiency, productivity, and smarter
                            decisions in the field
                        </p>
                    </div>

                    <div class="iot-agri-text agri-text-2">
                        <h2>
                            Agribusiness faces the challenge of producing more
                            with fewer resources and greater sustainability.
                        </h2>
                        <p>
                            IoT provides farmers to understand the soil in real
                            time and make precise decisions, reducing waste and
                            increasing productivity.
                        </p>
                    </div>

                    <div class="iot-agri-text agri-text-3">
                        <h2>What we monitor</h2>
                        <p>Strategically distributed sensors capture:</p>
                        <div class="card-checklist">
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Soil moisture at different depths</span>
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Soil and ambient temperature</span>
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Electrical conductivity (fertility and
                                    salinity)</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Conditions that directly impact irrigation</span
                                >
                            </div>
                        </div>
                    </div>

                    <div class="iot-agri-text agri-text-4">
                        <h2>What we deliver</h2>
                        <p>This data feeds a platform that delivers:</p>
                        <div class="card-checklist">
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Real-time metrics</span>
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Actionable irrigation recommendations</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Automatic calculation of applied water</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Cost conversion to USD</span>
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Alerts for urgent soil conditions</span>
                            </div>
                        </div>
                    </div>

                    <div class="iot-agri-text agri-text-5">
                        <h2>We provide on-site and remote support</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── IOT AGRICULTURA MOBILE ── -->
    <div class="iot-agri-mobile">
        <!-- Block 1 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/sensor-agro.webm"
                class="iot-ind-mobile-video"
                autoplay
                loop
                muted
                playsinline
                poster={SensorAgroFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>IoT for agriculture</h2>
                <p>
                    Water efficiency, productivity, and smarter decisions in the
                    field
                </p>
            </div>
        </div>

        <!-- Block 2 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/sensor-agro.webm"
                class="iot-ind-mobile-video"
                autoplay
                loop
                muted
                playsinline
                poster={SensorAgroFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>
                    Agribusiness faces the challenge of producing more with
                    fewer resources and greater sustainability.
                </h2>
                <p>
                    IoT provides farmers to understand the soil in real time and
                    make precise decisions, reducing waste and increasing
                    productivity.
                </p>
            </div>
        </div>

        <!-- Block 3 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-agricultura.webm"
                class="iot-ind-mobile-video"
                autoplay
                loop
                muted
                playsinline
                poster={IotParaAgriculturaFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>What we monitor</h2>
                <p>Strategically distributed sensors capture:</p>
                <div class="card-checklist">
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Soil moisture at different depths</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Soil and ambient temperature</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Electrical conductivity (fertility and salinity)</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Conditions that directly impacting irrigation</span
                        >
                    </div>
                </div>
            </div>
        </div>

        <!-- Block 4 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-agricultura.webm"
                class="iot-ind-mobile-video"
                autoplay
                loop
                muted
                playsinline
                poster={IotParaAgriculturaFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>What we deliver</h2>
                <p>This data feeds a platform that delivers:</p>
                <div class="card-checklist">
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Real-time metrics</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Actionable irrigation recommendations</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Automatic calculation of applied water</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Cost conversion into USD</span
                        >
                    </div>
                    <div>
                        <Icon name="arrow-right-2" size={24} /><span
                            >Alerts for urgent soil conditions</span
                        >
                    </div>
                </div>
            </div>
        </div>

        <!-- Block 5: Suporte + accordion (replaces iot-agri-applications on mobile) -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-agricultura.webm"
                class="iot-ind-mobile-video"
                autoplay
                loop
                muted
                playsinline
                poster={IotParaAgriculturaFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>We provide on-site and remote support</h2>
                <div class="iot-agri-mobile-accordion">
                    <Accordion
                        title="Process monitoring"
                        description="Sensors, gateways, solar panels, and antennas."
                    />
                    <Accordion
                        title="Remote sensor monitoring"
                        description="Battery, communication, connectivity, and data quality."
                    />
                    <Accordion
                        title="Ongoing maintenance"
                        description="Adjustments, replacements, and expanding the solution as the farm grows."
                    />
                    <Accordion
                        title="Farmers focus on production."
                        description="Transformatech takes care of the technology."
                    />
                </div>
            </div>
        </div>
    </div>

    <div class="iot-agri-applications">
        <div class="application-item">
            <div class="title">
                <Icon name="arrow-right-2" size={24} />
                <span>Process monitoring</span>
            </div>
            <span class="texto"
