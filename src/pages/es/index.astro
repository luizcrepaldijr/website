---
import Layout from "../../layouts/Layout.astro";
import "../../styles/pages/home.css";
import FaleConosco from "../../components/FaleConosco.astro";
import { Image } from "astro:assets";
import CuboImg from "../../images/home/hero/cubo.webp";
import ParceirosMarquee from "../../components/ParceirosMarquee.astro";
import SobreNosArk from "../../images/home/sobrenos/sobre-nos-ark.webp";
import TecnologiaAvancada from "../../images/home/sobrenos/tecnologia-avancada.webp";
import { getCollection } from "astro:content";
import PowerBI from "../../images/home/cases/power-bi.webp";
import Python from "../../images/home/cases/python.webp";
import Meta from "../../images/home/cases/meta.webp";
import Azure from "../../images/home/cases/azure.webp";
import ReactAdmin from "../../images/home/cases/react-admin.webp";
import TechIcon from "../../components/TechIcon.astro";

const esCases = await getCollection("cases", ({ id, data }) => {
  return id.startsWith("es/") && data.featured === true;
});
import CurvaImg from "../../images/home/curva/curva.webp";
import ButtonArrowAnimation from "../../components/buttons/ButtonArrowAnimation.astro";
import ButtonArrow from "../../components/buttons/ButtonArrow.astro";
import ButtonArrowWhite from "../../components/buttons/ButtonArrowWhite.astro";
import CarousselSolutions from "../../components/carroussel/CarousselSolutions.astro";
import CarousselCases from "../../components/carroussel/CarousselCases.astro";
import Badge from "../../components/Badge.astro";
import Badge2 from "../../components/Badge2.astro";
import Counter from "../../components/Counter.astro";
---

<Layout>
  <!-- HERO -->
  <div class="hero container-boxed">
    <div class="content">
      <h1>Tecnología para <b>impulsar</b> tu transformación digital</h1>
      <h3>
        Desarrollamos soluciones digitales a medida para integrar sistemas,
        optimizar procesos y apoyar decisiones estratégicas.
      </h3>
      <span class="button">
        <ButtonArrowAnimation text="Quiero empezar" />
      </span>
    </div>

    <div class="cubo-img-wrapper">
      <video
        src="/videos/cubo-hero.webm"
        class="cuboImg"
        autoplay
        loop
        muted
        playsinline
        poster={CuboImg.src}></video>
    </div>
  </div>

  <!-- PARCEIROS GLOBAIS -->
  <ParceirosMarquee lang="es" class="container-boxed" />

  <!-- SERVIÇOS -->
  <div class="servicos container">
    <div class="container-boxed">
      <div class="servicos-title">
        <span class="text-container">
          <h2>
            Soluciones integradas, de punta a punta, para impulsar tu
            competitividad
          </h2>
          <h3>
            Actuamos desde la planificación hasta la ejecución, conectando
            tecnología, procesos y datos.
          </h3>
        </span>

        <span class="button-container">
          <ButtonArrow
            text="Explorar todos los servicios"
            link="./soluciones"
          />
        </span>
      </div>
      <CarousselSolutions>
        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source
              src="/videos/home/transformacao-digital.webm"
              type="video/mp4"
            />
          </video>

          <h4>Transformación Digital</h4>
          <p>
            Empoderamos tu negocio a través de soluciones inteligentes,
            conectadas y orientadas por datos.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/home/industria-4-0.webm" type="video/mp4" />
          </video>

          <h4>Industria 4.0</h4>
          <p>
            Conectamos el mundo físico y digital para aumentar la visibilidad,
            el control y el desempeño industrial.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/home/engenharia.webm" type="video/mp4" />
          </video>

          <h4>Ingeniería</h4>
          <p>
            Transformamos ideas complejas en soluciones técnicas viables y
            eficientes.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/home/agricultura-4-0.webm" type="video/mp4" />
          </video>

          <h4>Agricultura 4.0</h4>
          <p>
            Ayudamos a productores y operaciones agrícolas a tomar mejores
            decisiones utilizando datos reales del campo.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/home/Iot.webm" type="video/mp4" />
          </video>

          <h4>IoT</h4>
          <p>
            Conectamos activos, procesos y entornos para generar inteligencia
            operacional, previsibilidad y eficiencia en tiempo real.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/home/robotica.webm" type="video/mp4" />
          </video>

          <h4>Robótica</h4>
          <p>
            Automatizamos procesos con sistemas robóticos inteligentes para
            aumentar la productividad, la precisión y la seguridad operacional.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source
              src="/videos/home/realidade-digital.webm"
              type="video/mp4"
            />
          </video>

          <h4>Realidad Digital</h4>
          <p>
            Integramos el mundo físico y digital a través de experiencias
            inmersivas que mejoran la capacitación, la operación y la toma de
            decisiones.
          </p>
        </div>
      </CarousselSolutions>
    </div>
  </div>

  <!-- SOBRE NÓS -->
  <div class="sobre-nos container-boxed">
    <Image class="ark" src={SobreNosArk} alt="" />
    <Badge text="Sobre nosotros" />
    <h2>
      Somos una consultora especializada en digitalizar <b
        >operaciones complejas</b
      >
    </h2>
    <div class="sobrenos-content">
      <video
        src="/videos/home/transformatech.webm"
        class="tecnologia-avancada"
        autoplay
        loop
        muted
        playsinline
        poster={TecnologiaAvancada.src}></video>
      <div>
        <h4>
          Usamos tecnología avanzada para transformar datos en dirección
          estratégica.
        </h4>

        <h3>
          Conectamos ingeniería, automatización y análisis inteligente de forma
          precisa. Con presencia en Brasil y Estados Unidos, trabajamos cerca de
          la operación para comprender desafíos reales y anticipar necesidades
          con soluciones aplicadas y eficientes.
          <br /><br />
          Nuestra cultura es práctica y orientada a resultados: cada entrega debe
          generar un impacto medible, reducir riesgos y elevar la competitividad.
          Más que implementar sistemas, actuamos como socios a largo plazo, combinando
          visión técnica y estrategia digital para evolucionar tu operación de punta
          a punta.
        </h3>

        <ButtonArrow text="Saber más" link="./sobre-nosotros" />
      </div>
    </div>
  </div>

  <!-- NUMEROS -->
  <div class="numeros container-boxed">
    <h2>Números que reflejan nuestro impacto</h2>
    <div class="counter-wrapper">
      <Counter prenumber="+" number="400" description="Proyectos entregados" />
      <Counter prenumber="+" number="10" description="Fábricas conectadas" />
      <Counter
        prenumber="+"
        number="200"
        description="Fuentes de datos conectadas"
      />
      <Counter prenumber="+" number="10" description="Ciudades atendidas" />
    </div>
  </div>

  <!-- CASES -->
  <div class="cases container-boxed">
    <Badge text="Casos" />
    <h2>Resultados que <b>transforman</b></h2>
    <h3>
      Casos reales que demuestran cómo nuestras soluciones generan impacto en
      los negocios
    </h3>
    <CarousselCases>
      {
        esCases.map((entry) => (
          <div class="embla__cases__slide">
            <div class="cases-card">
              <Image
                src={entry.data.image}
                alt={entry.data.title}
                class="unilever"
              />
              <div class="cases-card-content">
                <div class="badges">
                  {entry.data.badges.map((badge) => (
                    <Badge2 text={badge} />
                  ))}
                </div>
                <h2>
                  {entry.data.homeTitle || entry.data.title}
                </h2>
                <p>
                  {entry.data.description}
                </p>
                <div class="tecnologias">
                  <h4>Tecnologías utilizadas</h4>
                  <div class="tecnologias-images">
                    {
                      (entry.data.technologies || ["power-bi", "python", "meta", "azure", "react-admin"]).map((tech) => (
                        <TechIcon name={tech} />
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </CarousselCases>
    <ButtonArrow text="Ver casos" link="./casos" />
  </div>

  <!-- CURVA -->
  <div class="curva container-boxed">
    <h2 class="typewriter-text">
      Tecnología avanzada que integra datos, personas y procesos de extremo a
      extremo para empresas más competitivas.
    </h2>
    <ButtonArrowWhite text="Hablar con un especialista" />
    <video
      src="/videos/home/curva.webm"
      class="curva-img"
      autoplay
      loop
      muted
      playsinline
      poster={CurvaImg.src}></video>
  </div>

  <!-- FALE COM O TIME -->
  <FaleConosco
    title="¿Listo para digitalizar tu negocio?"
    subtitle="Hable con nuestro equipo y descubra cómo la tecnología puede trabajar a favor de tu negocio."
    buttonText="Hablar con un especialista"
  />
</Layout>
