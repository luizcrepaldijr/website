import m2_2 from "../../images/sobrenos/marquee/marquee-2-img-2.webp";
import m2_3 from "../../images/sobrenos/marquee/marquee-2-img-3.webp";
import m2_4 from "../../images/sobrenos/marquee/marquee-2-img-4.webp";
import m2_5 from "../../images/sobrenos/marquee/marquee-2-img-5.webp";
import m2_6 from "../../images/sobrenos/marquee/marquee-2-img-6.webp";
import Badge from "../../components/Badge.astro";
