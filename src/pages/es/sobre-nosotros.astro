        image: leonardoReigada,
        linkedin: "#",
        instagram: "#",
        facebook: "#",
    },
    {
        name: "Luiz Crepaldi",
        role: "AI & Data Scientist",
        description:
            "Estudiante de ingeniería, trabaja con Inteligencia Artificial aplicada en el desarrollo de soluciones que automatizan procesos, extraen valor de los datos e impulsan la innovación dentro de las empresas.",
        image: luizCrepaldi,
        linkedin: "#",
        instagram: "#",
        facebook: "#",
    },
    {
        name: "Mario Oliveira",
        role: "Business Developer",
        description:
            "Ejecutivo C-level y fundador, con más de 30 años de experiencia en manufactura, ciencias de la vida y tecnología. Lidera transformaciones complejas, conectando innovación, operaciones y crecimiento en entornos altamente regulados.",
        image: marioOliveira,
        linkedin: "#",
        instagram: "#",
        facebook: "#",
    },
    {
        name: "Matheus Braz",
        role: "Software Developer",
        description:
            "Estudiante de Ingeniería de Software y Desarrollador Web en Transformatech Advisors. Apasionado por la programación, la tecnología y la innovación, centrado en crear interfaces modernas, funcionales e intuitivas.",
        image: matheusBraz,
        linkedin: "#",
        instagram: "#",
        facebook: "#",
    },
    {
        name: "Matheus Santana",
        role: "XR Developer",
        description:
            "Desarrollador XR apasionado por aprender, todos los días, lo que aún no sé y por crear cosas que realmente importen y tengan un impacto en la vida de las personas.",
        image: matheusSantana,
        linkedin: "#",
        instagram: "#",
