    {
        name: "Marina Brandt",
        role: "XR Developer",
        description:
            "Tecnóloga en Juegos Digitales con perfil generalista, combino la ingeniería de software y el arte digital para dar vida a mundos virtuales. Especialista en Unity y C#, conecto una sólida arquitectura de código a la creación de assets y VFX, enfocándome en el desarrollo de experiencias innovadoras en XR.",
        image: marinaBrandt,
        linkedin: "#",
        instagram: "#",
        facebook: "#",
    },
    {
