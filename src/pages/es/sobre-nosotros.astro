// Import marquee images
import m1_1 from "../../images/sobrenos/marquee/marquee-1-img-1.webp";
import m1_2 from "../../images/sobrenos/marquee/marquee-1-img-2.webp";
import m1_3 from "../../images/sobrenos/marquee/marquee-1-img-3.webp";
import m1_4 from "../../images/sobrenos/marquee/marquee-1-img-4.webp";
import m1_5 from "../../images/sobrenos/marquee/marquee-1-img-5.webp";
