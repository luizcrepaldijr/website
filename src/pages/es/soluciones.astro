---
import Layout from "../../layouts/Layout.astro";
import SolucoesImg from "../../images/solucoes/solucoes.webp";
import "../../styles/pages/solucoes.css";
import { Icon } from "astro-icon/components";

import TransformacaoDigitalImg from "../../images/solucoes/transformacao-digital-solucao.webp";
import Industria40Img from "../../images/solucoes/industria-4-0-solucao.webp";
import EngenhariaImg from "../../images/solucoes/engenharia-solucao.webp";
import Agricultura40Img from "../../images/solucoes/agricultura-4-0-solucao.webp";
import IotImg from "../../images/solucoes/iot-solucao.webp";
import EsferaImg from "../../images/solucoes/esfera.webp";
import TecnologiasDesktop from "../../images/solucoes/tecnologias-desktop.webp";
import TecnologiasMobile from "../../images/solucoes/tecnologias-mobile.webp";
import Image from "astro/components/Image.astro";
import Accordion from "../../components/Accordion.astro";
import ButtonArrowSquare from "../../components/buttons/ButtonArrowSquare.astro";
import Badge from "../../components/Badge.astro";
import FaleConoscoEs from "../../components/FaleConoscoEs.astro";
import SolucoesSectionEs from "../../components/SolucoesSectionEs.astro";
import "../../styles/pages/iot.css";
import LogoBigFallback from "../../images/logo-big.webp";
import CarousselWorkflow from "../../components/carroussel/CarousselWorkflow.astro";
import FaleConoscoBigEs from "../../components/FaleConoscoBigEs.astro";

const wfSteps = [
    {
        title: "Diagnóstico",
        desc: "Entendemos la realidad del negocio, los desafíos operativos y las oportunidades.",
    },
    {
        title: "Planificación Estratégica",
        desc: "Definimos objetivos, indicadores y prioridades con claridad y alineación.",
    },
    {
        title: "Diseño de la solución",
        desc: "Co-creamos soluciones considerando tecnología, procesos y personas.",
    },
    {
        title: "Implementación",
        desc: "Ejecutamos con enfoque en agilidad, seguridad e integración a sistemas existentes.",
    },
    {
        title: "Monitoreo y Optimización",
        desc: "Acompañamos resultados y ajustamos continuamente.",
    },
    {
        title: "Resultados Sostenibles",
        desc: "Entregamos visibilidad, aprendizaje y base para la evolución continua.",
    },
];
---

<Layout title="Soluciones">
    <div class="hero container-boxed">
        <div class="content">
            <h1>Nuestras soluciones</h1>
            <h3>
                Arquitecturamos la estrategia, conectamos datos y transformamos
                operaciones reales.
            </h3>
        </div>

        <div class="solucoes-img-wrapper">
            <video
                src="/videos/solucoes/solucoes.webm"
                class="solucoesImg"
                autoplay
                loop
                muted
                playsinline
                poster={SolucoesImg.src}></video>
        </div>
    </div>
    <div class="marquee container">
        <div class="marquee-content">
            <h3>Transformación digital</h3>
            <Icon name="dot" />
            <h3>Industria 4.0</h3>
            <Icon name="dot" />
            <h3>Ingeniería</h3>
            <Icon name="dot" />
            <h3>Agricultura 4.0</h3>
            <Icon name="dot" />
            <h3>IoT</h3>
            <Icon name="dot" />
            <h3>Robótica</h3>
            <Icon name="dot" />
        </div>
        <div class="marquee-content" aria-hidden="true">
            <h3>Transformación digital</h3>
            <Icon name="dot" />
            <h3>Industria 4.0</h3>
            <Icon name="dot" />
            <h3>Ingeniería</h3>
            <Icon name="dot" />
            <h3>Agricultura 4.0</h3>
            <Icon name="dot" />
            <h3>IoT</h3>
            <Icon name="dot" />
            <h3>Robótica</h3>
            <Icon name="dot" />
        </div>
    </div>
    <SolucoesSectionEs />
    <div class="comofazemos container-boxed">
        <div class="content">
            <Badge text="Cómo lo hacemos" />
            <h2>
                Entendemos los desafíos de su negocio y
                <b>co-creamos</b> soluciones
            </h2>
            <h3>
                Nuestra metodología combina estrategia, tecnología y ejecución
                ágil para asegurar proyectos técnicamente sólidos, alineados al
                negocio y enfocados en resultados reales.
            </h3>
        </div>

        <div class="comofazemos-img-wrapper">
            <video
                src="/videos/solucoes/esfera.webm"
                class="esferaImg"
                autoplay
                loop
                muted
                playsinline
                poster={EsferaImg.src}></video>
            <a href="#workflow" class="workflow-link">
                Descubre nuestro workflow
                <Icon name="arrow-down" class="workflow-arrow" />
            </a>
        </div>
    </div>

    <!-- ── WORKFLOW ── -->
    <div id="workflow" class="iot-workflow-scrollarea sol-workflow">
        <div class="iot-workflow-pinned">
            <div class="wf-ring wf-ring-1"></div>
            <div class="wf-ring wf-ring-2"></div>

            <div class="wf-logo-wrapper">
                <img src={LogoBigFallback.src} class="wf-logo" alt="" />
            </div>

            <!-- Desktop -->
            <div class="wf-content">
                <div class="wf-header">
                    <h2>Nuestro workflow</h2>
                </div>
                <div class="wf-steps-area">
                    {
                        wfSteps.map((step, i) => (
                            <div class={`wf-step wf-step-${i}`}>
                                <div class="wf-line" />
                                <span class="wf-dot">
                                    <Icon name="dot" size={12} />
                                </span>
                                <h3>{step.title}</h3>
                                <p class="wf-desc">{step.desc}</p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Mobile carousel -->
            <div class="wf-mobile-carousel">
                <div class="wf-mobile-header">
                    <h2>Nuestro workflow</h2>
                </div>
                <CarousselWorkflow
                    steps={wfSteps}
                    logoSrc={LogoBigFallback.src}
                />
            </div>
        </div>
    </div>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        function initWorkflow() {
            ScrollTrigger.getAll()
                .filter((st) =>
                    st.vars?.trigger?.toString?.().includes?.("sol-workflow"),
                )
                .forEach((st) => st.kill());

            const mm = gsap.matchMedia();

            mm.add("(min-width: 801px)", () => {
                const WF_STEPS = 6;
                const WF_DUR = 1;
                const WF_DEG = 360 / WF_STEPS;
                const WF_RADIUS = 380;

                function getX(y: number) {
                    const val = WF_RADIUS ** 2 - y ** 2;
                    return Math.sqrt(Math.max(0, val)) - WF_RADIUS;
                }

                function getRot(y: number) {
                    const ratio = Math.max(
                        -0.99,
                        Math.min(0.99, y / WF_RADIUS),
                    );
                    return Math.asin(ratio) * (180 / Math.PI);
                }

                gsap.set(".sol-workflow .wf-step-0", {
                    y: 0,
                    x: 0,
                    rotation: 0,
                    transformOrigin: "left center",
                });
                gsap.set(".sol-workflow .wf-step-0 .wf-line", { autoAlpha: 1 });
                gsap.set(".sol-workflow .wf-step-0 .wf-dot", { opacity: 1 });
                gsap.set(".sol-workflow .wf-step-0 h3", { opacity: 1 });
                gsap.set(".sol-workflow .wf-step-0 .wf-desc", { autoAlpha: 1 });

                for (let i = 1; i < WF_STEPS; i++) {
                    const qY = i * 78;
                    const qX = getX(qY);
                    const vis = i <= 2;
                    const hOp = i === 1 ? 0.28 : 0.16;
                    gsap.set(`.sol-workflow .wf-step-${i}`, {
                        y: qY,
                        x: qX,
                        rotation: getRot(qY),
                        transformOrigin: "left center",
                        autoAlpha: vis ? 1 : 0,
                    });
                    gsap.set(`.sol-workflow .wf-step-${i} .wf-line`, {
                        autoAlpha: 0,
                    });
                    gsap.set(`.sol-workflow .wf-step-${i} .wf-dot`, {
                        opacity: vis ? 0.35 : 0,
                    });
                    gsap.set(`.sol-workflow .wf-step-${i} h3`, {
                        opacity: vis ? hOp : 0,
                    });
                    gsap.set(`.sol-workflow .wf-step-${i} .wf-desc`, {
                        autoAlpha: 0,
                    });
                }

                const wfTl = gsap.timeline({
                    scrollTrigger: {
                        trigger: ".sol-workflow",
                        start: "top top",
                        end: `+=${(WF_STEPS - 1) * 100}%`,
                        scrub: 1,
                        pin: true,
                        anticipatePin: 1,
                    },
                });

                for (let i = 0; i < WF_STEPS - 1; i++) {
                    const t = i * WF_DUR;

                    wfTl.to(
                        ".sol-workflow .wf-logo",
                        {
                            rotation: (i + 1) * WF_DEG,
                            ease: "none",
                            duration: WF_DUR,
                        },
                        t,
                    );

                    wfTl.to(
                        `.sol-workflow .wf-step-${i} .wf-desc`,
                        { autoAlpha: 0, duration: 0.2 },
                        t,
                    )
                        .to(
                            `.sol-workflow .wf-step-${i} .wf-line`,
                            { autoAlpha: 0, duration: 0.2 },
                            t,
                        )
                        .to(
                            `.sol-workflow .wf-step-${i} .wf-dot`,
                            { opacity: 0, duration: 0.2 },
                            t,
                        )
                        .to(
                            `.sol-workflow .wf-step-${i} h3`,
                            { opacity: 0, duration: 0.2 },
                            t,
                        )
                        .to(
                            `.sol-workflow .wf-step-${i}`,
                            {
                                autoAlpha: 0,
                                y: -55,
                                x: getX(-55),
                                rotation: getRot(-55),
                                duration: 0.35,
                            },
                            t + 0.15,
                        );

                    wfTl.to(
                        `.sol-workflow .wf-step-${i + 1}`,
                        {
                            autoAlpha: 1,
                            y: 0,
                            x: 0,
                            rotation: 0,
                            duration: 0.4,
                        },
                        t + 0.45,
                    )
                        .to(
                            `.sol-workflow .wf-step-${i + 1} .wf-line`,
                            { autoAlpha: 1, duration: 0.3 },
                            t + 0.6,
                        )
                        .to(
                            `.sol-workflow .wf-step-${i + 1} .wf-dot`,
                            { opacity: 1, duration: 0.3 },
                            t + 0.6,
                        )
                        .to(
                            `.sol-workflow .wf-step-${i + 1} h3`,
                            { opacity: 1, duration: 0.3 },
                            t + 0.6,
                        )
                        .to(
                            `.sol-workflow .wf-step-${i + 1} .wf-desc`,
                            { autoAlpha: 1, duration: 0.3 },
                            t + 0.7,
                        );

                    for (let j = i + 2; j < WF_STEPS; j++) {
                        const offset = j - (i + 1);
                        const vis = offset <= 2;
                        const hOp = offset === 1 ? 0.28 : 0.16;
                        const qY = offset * 78;
                        const qX = getX(qY);
                        wfTl.to(
                            `.sol-workflow .wf-step-${j}`,
                            {
                                autoAlpha: vis ? 1 : 0,
                                y: qY,
                                x: qX,
                                rotation: getRot(qY),
                                duration: 0.4,
                            },
                            t + 0.45,
                        )
                            .to(
                                `.sol-workflow .wf-step-${j} .wf-dot`,
                                { opacity: vis ? 0.35 : 0, duration: 0.3 },
                                t + 0.45,
                            )
                            .to(
                                `.sol-workflow .wf-step-${j} h3`,
                                { opacity: vis ? hOp : 0, duration: 0.3 },
                                t + 0.45,
                            );
                    }
                }

                requestAnimationFrame(() => {
                    requestAnimationFrame(() => ScrollTrigger.refresh());
                });
            });
        }

        document.addEventListener("DOMContentLoaded", initWorkflow);
    </script>

    <div class="tecnologias container-boxed">
        <div class="content-desktop">
            <h3>Especialistas en</h3>
            <h2>20+</h2>
            <h4>tecnologías</h4>
        </div>

        <div class="content-mobile">
            <h3>Especialistas en <br /> <span>20+</span> tecnologías</h3>
        </div>

        <div class="tecnologias-img-wrapper">
            <Image
                src={TecnologiasDesktop}
                alt="Tecnologias Desktop"
                class="tecnologias-img-desktop"
            />
            <Image
                src={TecnologiasMobile}
                alt="Tecnologias Mobile"
                class="tecnologias-img-mobile"
            />
        </div>
    </div>

    <FaleConoscoBigEs
        title="¿Listo para digitalizar tu negocio?"
        subtitle="Habla con nuestro equipo y descubre cómo la tecnología puede trabajar a favor de tu negocio."
        buttonText="Hablar con un especialista"
    />
</Layout>
