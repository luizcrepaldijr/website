---
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/pages/iot.css";
import IotHeroFallback from "../../../images/iot/iot-hero.webp";
import LorawanFallback from "../../../images/iot/lorawan.webp";
import IotParaIndustriaFallback from "../../../images/iot/iot-para-industria.webp";
import IotParaIndustria2Fallback from "../../../images/iot/iot-para-industria-2.webp";
import SensorAgroFallback from "../../../images/iot/sensor-agro.webp";
import IotParaAgriculturaFallback from "../../../images/iot/iot-para-agricultura.webp";
import ButtonArrowAnimation from "../../../components/buttons/ButtonArrowAnimation.astro";
import ButtonArrowWhite from "../../../components/buttons/ButtonArrowWhite.astro";
import Badge from "../../../components/Badge.astro";
import { Icon } from "astro-icon/components";
import LogoBigFallback from "../../../images/logo-big.webp";
import LogoAbreviadaTT from "../../../icons/logo-abreviada-tt.svg";
import Ellipse1 from "../../../icons/ellipse-1.svg";
import Ellipse2 from "../../../icons/ellipse-2.svg";
import Accordion from "../../../components/Accordion.astro";
import CarousselWorkflow from "../../../components/carroussel/CarousselWorkflow.astro";

const wfSteps = [
    {
        title: "Diagnóstico técnico de la operación",
        desc: "Comprensión profunda de procesos, máquinas y desafíos reales.",
    },
    {
        title: "Estrategia de sensorización",
        desc: "Definición de sensores, puntos de medición y arquitectura ideal.",
    },
    {
        title: "Diseño de la solución",
        desc: "Co-creamos soluciones considerando tecnología, procesos y personas.",
    },
    {
        title: "Instalación y puesta en marcha",
        desc: "Ejecución en campo, pruebas y validación de rendimiento.",
    },
    {
        title: "Soporte y evolución continua",
        desc: "Monitorización, ajustes, mantenimiento y expansión a medida que la operación crece.",
    },
];
---

<Layout title="IoT">
    <div class="iot-hero container-boxed">
        <div class="content">
            <h1>
                <b>IoT:</b> transformando datos en decisiones reales
            </h1>
            <h3>
                Conectamos activos, procesos y entornos físicos para generar
                inteligencia operativa, previsibilidad y eficiencia en tiempo
                real.
            </h3>

            <ButtonArrowAnimation text="Necesito este servicio" />
        </div>

        <div class="iot-img-wrapper">
            <video
                src="/videos/iot/iot-hero.webm"
                class="iotImg"
                autoplay
                loop
                muted
                playsinline
                poster={IotHeroFallback.src}></video>
        </div>
        <Icon name="arrow-down" class="arrow-down" />
    </div>

    <div class="iot-section-2 container-boxed">
        <div class="content">
            <h2>
                La industria exige cada vez más control, previsibilidad y
                eficiencia.
            </h2>
            <h3>
                El IoT (Internet of Things) permite transformar los procesos
                productivos en entornos inteligentes, capaces de capturar datos
                de forma continua y generar insights inmediatos para la toma de
                decisiones.
            </h3>
            <p><b>Con IoT es posible:</b></p>
        </div>

        <div class="iot-checklist">
            <div class="iot-checklist-item">
                <Icon name="check" size={24} />
                <span>Monitoreo continuo de variables críticas</span>
            </div>
            <div class="iot-checklist-item">
                <Icon name="check" size={24} />
                <span>Detección temprana de fallas y anomalías</span>
            </div>
            <div class="iot-checklist-item">
                <Icon name="check" size={24} />
                <span>Mayor confiabilidad y previsibilidad de procesos</span>
            </div>
            <div class="iot-checklist-item">
                <Icon name="check" size={24} />
                <span>Reducción de desperdicios y costos operativos</span>
            </div>
        </div>
    </div>

    <div class="lorawan-section container-boxed">
        <div class="lorawan-header">
            <Badge text="Tecnología" />
            <h2>
                Utilizamos tecnología <b>LoRaWAN</b><br />
                <span>como base para nuestras soluciones de IoT</span>
            </h2>
        </div>

        <div class="lorawan-visual">
            <div
                class="lorawan-label lorawan-label-1 lorawan-anim"
                data-delay="0"
            >
                <div class="lbl-text">
                    Largo alcance y<br />escalabilidad en áreas<br /> extensas
                </div>
                <svg
                    class="lbl-line line-1"
                    viewBox="0 0 100 100"
                    preserveAspectRatio="none"
                >
                    <line
                        x1="0"
                        y1="0"
                        x2="100"
                        y2="100"
                        stroke="rgba(255,255,255,0.4)"
                        stroke-width="1"
                        stroke-dasharray="4 4"></line>
                </svg>
            </div>

            <div
                class="lorawan-label lorawan-label-2 lorawan-anim"
                data-delay="1"
            >
                <div class="lbl-text">
                    Bajo consumo de<br />energía y vida útil<br />elevada
                </div>
                <svg
                    class="lbl-line line-2"
                    viewBox="0 0 2 100"
                    preserveAspectRatio="none"
                >
                    <line
                        x1="1"
                        y1="0"
                        x2="1"
                        y2="100"
                        stroke="rgba(255,255,255,0.4)"
                        stroke-width="1"
                        stroke-dasharray="4 4"></line>
                </svg>
            </div>

            <div class="lorawan-video-wrapper">
                <video
                    src="/videos/iot/lorawan.webm"
                    class="lorawan-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={LorawanFallback.src}></video>
            </div>

            <div
                class="lorawan-label lorawan-label-3 lorawan-anim"
                data-delay="2"
            >
                <div class="lbl-text">
                    Reducción drástica de<br />cableado y costes de<br />
                    instalación
                </div>
                <svg
                    class="lbl-line line-3"
                    viewBox="0 0 2 100"
                    preserveAspectRatio="none"
                >
                    <line
                        x1="1"
                        y1="0"
                        x2="1"
                        y2="100"
                        stroke="rgba(255,255,255,0.4)"
                        stroke-width="1"
                        stroke-dasharray="4 4"></line>
                </svg>
            </div>

            <div
                class="lorawan-label lorawan-label-4 lorawan-anim"
                data-delay="3"
            >
                <div class="lbl-text">
                    Alta confiabilidad <br />incluso en entornos con<br
                    />interferencias
                </div>
                <svg
                    class="lbl-line line-4"
                    viewBox="0 0 100 100"
                    preserveAspectRatio="none"
                >
                    <line
                        x1="100"
                        y1="0"
                        x2="0"
                        y2="100"
                        stroke="rgba(255,255,255,0.4)"
                        stroke-width="1"
                        stroke-dasharray="4 4"></line>
                </svg>
            </div>
        </div>

        <p class="lorawan-footer">
            Creamos soluciones completas de IoT que integran sensores,
            conectividad, plataformas analíticas y soporte continuo,
            transformando datos brutos en información procesable
        </p>
    </div>

    <!-- ── GLOBAL TABS ── -->
    <div id="iot-tabs-anchor"></div>
    <div class="iot-global-tabs">
        <button class="active" data-panel="ind">IoT para industrias</button>
        <button data-panel="agri">IoT para agricultura</button>
    </div>

    <!-- ── PANEL: INDÚSTRIAS ── -->
    <div class="iot-panel" id="panel-ind">
        <div class="iot-industrias-master-scrollarea">
            <div class="iot-ind-pinned-master">
                <div class="iot-ind-pinned-content">
                    <!-- Media -->
                    <div class="iot-ind-medias">
                        <div class="iot-ind-media media-1">
                            <video
                                src="/videos/iot/iot-para-industria.webm"
                                autoplay
                                loop
                                muted
                                playsinline
                                poster={IotParaIndustriaFallback.src}></video>
                        </div>
                        <!-- Second media uses same video as requested -->
                        <div class="iot-ind-media media-2">
                            <video
                                src="/videos/iot/iot-para-industria-2.webm"
                                autoplay
                                loop
                                muted
                                playsinline
                                poster={IotParaIndustria2Fallback.src}></video>
                        </div>
                    </div>

                    <!-- Texts -->
                    <div class="iot-ind-texts">
                        <div class="iot-ind-text text-1">
                            <h2>IoT para industria</h2>
                            <p>
                                Permite observar la operación de forma continua,
                                capturando datos críticos directamente desde el
                                piso de planta.
                            </p>
                        </div>

                        <div class="iot-ind-text text-2">
                            <h2>
                                La industria moderna exige procesos conectados,
                                predecibles y eficientes.
                            </h2>
                            <p>
                                El IoT industrial permite observar la operación
                                de forma continua, capturando datos críticos
                                directamente desde el piso de planta.
                            </p>
                        </div>

                        <div class="iot-ind-text text-3">
                            <h2>Qué monitoreamos</h2>
                            <p>
                                Nuestras principales aplicaciones en la
                                industria:
                            </p>
                            <div class="card-checklist">
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Recolección automática de datos del
                                        proceso</span
                                    >
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Análisis de vibración en motores y
                                        equipos críticos</span
                                    >
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Monitoreo de líneas de empaque para el
                                        cálculo de eficiencia (OEE)</span
                                    >
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Integración de datos en plataformas
                                        analíticas y sistemas internos</span
                                    >
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Comunicación inalámbrica confiable vía
                                        LoRaWAN</span
                                    >
                                </div>
                            </div>
                        </div>

                        <div class="iot-ind-text text-4">
                            <h2>Resultados obtenidos con IoT Industrial</h2>
                            <p>
                                Estos datos alimentan una plataforma que
                                entrega:
                            </p>
                            <div class="card-checklist">
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Reducción de fallas y paradas
                                        inesperadas</span
                                    >
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span>Mejora significativa del OEE</span>
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Aumento de la vida útil de los activos
                                        críticos</span
                                    >
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Más control, trazabilidad y facilidad
                                        de auditoría</span
                                    >
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Decisiones basadas en datos fiables y
                                        en tiempo real</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── IOT INDÚSTRIAS MOBILE ── -->
        <div class="iot-ind-mobile">
            <!-- Block 1 -->
            <div class="iot-ind-mobile-block">
                <video
                    src="/videos/iot/iot-para-industria.webm"
                    class="iot-ind-mobile-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={IotParaIndustriaFallback.src}></video>
                <div class="iot-ind-mobile-text">
                    <h2>IoT para industria</h2>
                    <p>
                        Permite observar la operación de forma continua,
                        capturando datos críticos directamente desde el piso de
                        planta.
                    </p>
                </div>
            </div>

            <!-- Block 2 -->
            <div class="iot-ind-mobile-block">
                <video
                    src="/videos/iot/iot-para-industria.webm"
                    class="iot-ind-mobile-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={IotParaIndustriaFallback.src}></video>
                <div class="iot-ind-mobile-text">
                    <h2>
                        La industria moderna exige procesos conectados,
                        predecibles y eficientes.
                    </h2>
                    <p>
                        El IoT industrial permite observar la operación de forma
                        continua, capturando datos críticos directamente desde
                        el piso de planta.
                    </p>
                </div>
            </div>

            <!-- Block 3 -->
            <div class="iot-ind-mobile-block">
                <video
                    src="/videos/iot/iot-para-industria-2.webm"
                    class="iot-ind-mobile-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={IotParaIndustria2Fallback.src}></video>
                <div class="iot-ind-mobile-text">
                    <h2>Qué monitoreamos</h2>
                    <p>Nuestras principales aplicaciones en la industria:</p>
                    <div class="card-checklist">
                        <div>
                            <Icon name="arrow-right-2" size={24} /><span
                                >Recolección automática de datos del proceso</span
                            >
                        </div>
                        <div>
                            <Icon name="arrow-right-2" size={24} /><span
                                >Análisis de vibración en motores y equipos
                                críticos</span
                            >
                        </div>
                        <div>
                            <Icon name="arrow-right-2" size={24} /><span
                                >Monitoreo de líneas de empaque para el cálculo
                                de eficiencia (OEE)</span
                            >
                        </div>
                        <div>
                            <Icon name="arrow-right-2" size={24} /><span
                                >Integración de datos en plataformas analíticas
                                y sistemas internos</span
                            >
                        </div>
                        <div>
                            <Icon name="arrow-right-2" size={24} /><span
                                >Comunicación inalámbrica confiable vía LoRaWAN</span
                            >
                        </div>
                    </div>
                </div>
            </div>

            <!-- Block 4 -->
            <div class="iot-ind-mobile-block">
                <video
                    src="/videos/iot/iot-para-industria-2.webm"
                    class="iot-ind-mobile-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={IotParaIndustria2Fallback.src}></video>
                <div class="iot-ind-mobile-text">
                    <h2>Resultados obtenidos con IoT Industrial</h2>
                    <p>Estos datos alimentan una plataforma que entrega:</p>
                    <div class="card-checklist">
                        <div>
                            <Icon name="arrow-right-2" size={24} /><span
                                >Reducción de fallas y paradas inesperadas</span
                            >
                        </div>
                        <div>
                            <Icon name="arrow-right-2" size={24} /><span
                                >Mejora significativa del OEE</span
                            >
                        </div>
                        <div>
                            <Icon name="arrow-right-2" size={24} /><span
                                >Aumento de la vida útil de los activos críticos</span
                            >
                        </div>
                        <div>
                            <Icon name="arrow-right-2" size={24} /><span
                                >Más control, trazabilidad y facilidad de
                                auditoría</span
                            >
                        </div>
                        <div>
                            <Icon name="arrow-right-2" size={24} /><span
                                >Decisiones basadas en datos fiables y en tiempo
                                real</span
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── IOT WORKFLOW ── -->
        <div class="iot-workflow-scrollarea">
            <div class="iot-workflow-pinned">
                <!-- Ellipse rings -->
                <div class="wf-ellipse-wrapper">
                    <img src={Ellipse1.src} class="wf-ellipse-1" alt="" />
                    <img src={Ellipse2.src} class="wf-ellipse-2" alt="" />
                </div>

                <!-- Rotating logo -->
                <div class="wf-logo-wrapper">
                    <img src={LogoAbreviadaTT.src} class="wf-logo" alt="" />
                </div>

                <!-- Right content (desktop) -->
                <div class="wf-content">
                    <div class="wf-header">
                        <h2>Cómo entregamos IoT en la Industria</h2>
                        <span class="wf-subtitle">Nosso flujo de trabajo</span>
                    </div>

                    <div class="wf-steps-area">
                        {
                            wfSteps.map((step, i) => (
                                <div class={`wf-step wf-step-${i}`}>
                                    <div class="wf-line" />
                                    <span class="wf-dot">
                                        <Icon name="dot" size={8} />
                                    </span>
                                    <h3>{step.title}</h3>
                                    <p class="wf-desc">{step.desc}</p>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <!-- Mobile carousel -->
                <div class="wf-mobile-carousel">
                    <div class="wf-mobile-header">
                        <h2>Cómo entregamos IoT en la Industria</h2>
                        <span class="wf-subtitle">Nuestro flujo de trabajo</span
                        >
                    </div>
                    <CarousselWorkflow
                        steps={wfSteps}
                        logoSrc={LogoBigFallback.src}
                    />
                </div>
            </div>
        </div><!-- close iot-workflow-scrollarea -->
    </div><!-- close #panel-ind -->

    <!-- ── PANEL: AGRICULTURA ── -->
    <div class="iot-panel" id="panel-agri">
        <!-- ── IOT AGRICULTURA ── -->
        <div class="iot-agricultura-master-scrollarea">
            <div class="iot-agri-pinned-master">
                <div class="iot-agri-pinned-content">
                    <!-- Media -->
                    <div class="iot-agri-medias">
                        <div class="iot-agri-media agri-media-1">
                            <video
                                src="/videos/iot/sensor-agro.webm"
                                autoplay
                                loop
                                muted
                                playsinline
                                poster={SensorAgroFallback.src}></video>
                        </div>
                        <div class="iot-agri-media agri-media-2">
                            <video
                                src="/videos/iot/iot-para-agricultura.webm"
                                autoplay
                                loop
                                muted
                                playsinline
                                poster={IotParaAgriculturaFallback.src}></video>
                        </div>
                    </div>

                    <!-- Texts -->
                    <div class="iot-agri-texts">
                        <div class="iot-agri-text agri-text-1">
                            <h2>IoT para agricultura</h2>
                            <p>
                                Eficiencia hídrica, productividad y decisiones
                                inteligentes en el campo
                            </p>
                        </div>

                        <div class="iot-agri-text agri-text-2">
                            <h2>
                                El agronegocio enfrenta el desafío de producir
                                más, con menos recursos y mayor sostenibilidad.
                            </h2>
                            <p>
                                El IoT permite al productor entender el suelo en
                                tiempo real y tomar decisiones precisas,
                                reduciendo desperdicios y aumentando la
                                productividad.
                            </p>
                        </div>

                        <div class="iot-agri-text agri-text-3">
                            <h2>Qué monitoreamos</h2>
                            <p>
                                Sensores distribuidos estratégicamente capturan:
                            </p>
                            <div class="card-checklist">
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Humedad del suelo en diferentes
                                        profundidades</span
                                    >
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Temperatura del suelo y del ambiente</span
                                    >
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Conductividad eléctrica (fertilidad y
                                        salinidad)</span
                                    >
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Condiciones que repercuten directamente
                                        en el riego</span
                                    >
                                </div>
                            </div>
                        </div>

                        <div class="iot-agri-text agri-text-4">
                            <h2>Qué entregamos</h2>
                            <p>
                                Estos datos alimentan una plataforma que
                                entrega:
                            </p>
                            <div class="card-checklist">
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span>Indicadores en tiempo real</span>
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Recomendaciones objetivas de riego</span
                                    >
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Cálculo automático del agua aplicada</span
                                    >
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span>Conversión del consumo en USD</span>
                                </div>
                                <div>
                                    <Icon name="arrow-right-2" size={24} />
                                    <span
                                        >Alertas sobre las necesidades
                                        inmediatas del suelo</span
                                    >
                                </div>
                            </div>
                        </div>

                        <div class="iot-agri-text agri-text-5">
                            <h2>Ofrecemos soporte en el campo y a distancia</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── IOT AGRICULTURA MOBILE ── -->
        <div class="iot-agri-mobile">
            <!-- Block 1 -->
            <div class="iot-ind-mobile-block">
                <video
                    src="/videos/iot/sensor-agro.webm"
                    class="iot-ind-mobile-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={SensorAgroFallback.src}></video>
                <div class="iot-ind-mobile-text">
                    <h2>IoT para agricultura</h2>
                    <p>
                        Eficiencia hídrica, productividad y decisiones
                        inteligentes en el campo
                    </p>
                </div>
            </div>

            <!-- Block 2 -->
            <div class="iot-ind-mobile-block">
                <video
                    src="/videos/iot/sensor-agro.webm"
                    class="iot-ind-mobile-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={SensorAgroFallback.src}></video>
                <div class="iot-ind-mobile-text">
                    <h2>
                        El agronegocio enfrenta el desafío de producir más, con
                        menos recursos y mayor sostenibilidad.
                    </h2>
                    <p>
                        El IoT permite al productor entender el suelo en tiempo
                        real y tomar decisiones precisas, reduciendo
                        desperdicios y aumentando la productividad.
                    </p>
                </div>
            </div>

            <!-- Block 3 -->
            <div class="iot-ind-mobile-block">
                <video
                    src="/videos/iot/iot-para-agricultura.webm"
                    class="iot-ind-mobile-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={IotParaAgriculturaFallback.src}></video>
                <div class="iot-ind-mobile-text">
                    <h2>Qué monitoreamos</h2>
                    <p>Sensores distribuidos estratégicamente capturan:</p>
                    <div class="card-checklist">
                        <div>
                            <Icon name="arrow-right-2" size={24} /><span
