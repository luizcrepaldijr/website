---
import ButtonArrowAnimation from "../../../components/buttons/ButtonArrowAnimation.astro";
import ButtonArrowWhite from "../../../components/buttons/ButtonArrowWhite.astro";
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/pages/realidade-digital.css";
import CuboImg from "../../../images/home/hero/cubo.webp";
import VideoThumb from "../../../images/realidade-digital/video-thumb.webp";
import MagicBox from "../../../images/realidade-digital/magic-box.webp";
import MetaQuest from "../../../images/realidade-digital/meta-quest.webp";
import VRImg from "../../../images/realidade-digital/realidade-virtual.webp";
import ARImg from "../../../images/realidade-digital/realidade-aumentada.webp";
import MRImg from "../../../images/realidade-digital/realidade-mista.webp";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
---

<Layout title="Realidad Digital">
    <div class="hero container-boxed">
        <div class="content">
            <h1>
                <b>Realidad Digital:</b> la nueva forma de entrenar y evolucionar
                la industria
            </h1>
            <h3>
                Entrenamiento, soporte y ejecución operacional con realidad
                virtual, aumentada y mixta, integrados al entorno real de la
                industria.
            </h3>

            <ButtonArrowAnimation text="Necesito este servicio" />
        </div>

        <div class="cubo-img-wrapper">
            <video
                src="/videos/cubo-hero.webm"
                class="cuboImg"
                autoplay
                loop
                muted
                playsinline
                poster={CuboImg.src}></video>
        </div>
    </div>

    <div class="ambientes-virtuais container-boxed">
        <div class="content">
            <h2>
                Combinamos entornos virtuales inmersivos para entrenar equipos
                con mayor seguridad y eficiencia.
            </h2>
            <h3>
                Creamos simulaciones realistas de máquinas, procesos y
                escenarios operacionales, permitiendo que los equipos practiquen
                procedimientos tantas veces como sea necesario y ganen confianza
                antes de la ejecución real.
            </h3>
        </div>

        <div class="youtube-wrapper" id="video-container">
            <div id="video-placeholder" class="video-placeholder">
                <img
                    src={VideoThumb.src}
                    alt="Miniatura del video"
                    class="video-thumb-custom"
                />
                <button class="play-button" aria-label="Play Video">
                    <span class="play-icon"></span>
                </button>
            </div>
        </div>
    </div>

    <div class="realidade-digital-section container-boxed">
        <div class="rd-top-row">
            <div class="rd-content">
                <div class="rd-badge">
                    <span>Tecnología</span>
                    <Image
                        src={MagicBox}
                        alt="Magic Box"
                        class="rd-badge-img"
                    />
                </div>

                <h2>
                    El equipo visualiza en realidad virtual cómo debe ejecutarse
                    cada actividad directamente sobre el equipo real.
                </h2>
                <h3>
                    El colaborador recibe orientaciones paso a paso en el propio
                    contexto de trabajo, haciendo que el aprendizaje sea más
                    intuitivo, imersivo y práctico.
                </h3>
                <p><b>Con Realidad Digital es posible:</b></p>
            </div>

            <div class="rd-video-wrapper">
                <video
                    src="/videos/realidade-digital/oculos.webm"
                    class="rd-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={MetaQuest.src}></video>
                <div class="rd-meta-quest-label">
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm-1.5 14.5c-1.381 0-2.5-1.567-2.5-3.5s1.119-3.5 2.5-3.5c.692 0 1.317.39 1.775 1.013L12 11.5l.225-.987C12.683 9.89 13.308 9.5 14 9.5c1.381 0 2.5 1.567 2.5 3.5s-1.119 3.5-2.5 3.5c-.692 0-1.317-.39-1.775-1.013L12 14.5l-.225.987c-.458.623-1.083 1.013-1.775 1.013z"
                            fill="white"></path>
                    </svg>
                    <span>Meta Quest 3</span>
                </div>
            </div>
        </div>

        <div class="rd-checklist">
            <div class="rd-checklist-item">
                <Icon name="check" size={24} />
                <span>Visualización clara de cómo ejecutar cada tarea</span>
            </div>
            <div class="rd-checklist-item">
                <Icon name="check" size={24} />
                <span>Aprendizaje práctico durante la ejecución</span>
            </div>
            <div class="rd-checklist-item">
                <Icon name="check" size={24} />
                <span>Ejecución correcta y estandarizada</span>
            </div>
            <div class="rd-checklist-item">
                <Icon name="check" size={24} />
                <span>Más seguridad en el entorno operativo</span>
            </div>
        </div>
    </div>

    <div class="rd-abordagem-integrada container-boxed">
        <div class="rd-abordagem-header">
            <h2>Utilizamos un enfoque integrado de Realidad Digital</h2>
            <h3>
                Integramos tecnologías de Realidad Digital para acompañar toda
                la jornada de aprendizaje hasta la ejecución operativa.
            </h3>
        </div>

        <div class="rd-cards-grid">
            <div class="rd-card">
                <video
                    src="/videos/realidade-digital/realidade-virtual.webm"
                    class="rd-card-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={VRImg.src}></video>
                <div class="rd-card-overlay"></div>
                <div class="rd-card-bottom">
                    <h4>Realidad Virtual (VR)</h4>
                    <p>
                        Las simulaciones digitales permiten practicar
                        procedimientos y flujos de trabajo en entornos
                        controlados, preparando a los equipos antes de la
                        ejecución real, sin riesgos y sin impacto en la
                        operación.
                    </p>
                </div>
            </div>
            <div class="rd-card">
                <video
                    src="/videos/realidade-digital/realidade-aumentada.webm"
                    class="rd-card-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={ARImg.src}></video>
                <div class="rd-card-overlay"></div>
                <div class="rd-card-bottom">
                    <h4>Realidad Aumentada (AR)</h4>
                    <p>
                        La información y las instrucciones digitales aparecen
                        directamente sobre el entorno físico, orientando la
                        ejecución de las actividades en el momento en que
                        ocurren.
                    </p>
                </div>
            </div>
            <div class="rd-card">
                <Image src={MRImg} alt="Realidad Mixta" class="rd-card-img" />
                <div class="rd-card-overlay"></div>
                <div class="rd-card-bottom">
                    <h4>Realidad Mixta</h4>
                    <p>
                        Los elementos digitales interactúan con el entorno real,
                        combinando visualización, datos y contexto para apoyar
                        las decisiones y la ejecución de tareas más complejas.
                    </p>
                </div>
            </div>
        </div>

        <div class="rd-btn-container">
            <ButtonArrowAnimation text="Necesito este servicio" />
        </div>
    </div>

    <div class="rd-operacao-industrial container-boxed">
        <div class="rd-op-header">
            <h2>Realidad Digital aplicada a la operación industrial</h2>
        </div>

        <div class="rd-op-cards-container">
            <div class="rd-op-card">
                <div class="rd-op-card-content">
                    <h3>Seguridad</h3>
                    <p>
                        Entrenamiento seguro en entornos simulados, permitiendo
                        que los equipos practiquen procedimientos críticos antes
                        de actuar en la planta.
                    </p>
                </div>
                <div class="rd-op-card-img-wrapper">
                    <video
                        src="/videos/realidade-digital/segurança-vr.webm"
                        class="rd-op-card-img"
                        autoplay
                        loop
                        muted
                        playsinline></video>
                </div>
            </div>

            <div class="rd-op-card">
                <div class="rd-op-card-content">
                    <h3>Changeover</h3>
                    <p>
                        Cambios de setup más rápidos y estandarizados, con
                        orientación digital que reduce errores y tiempo de
                        inactividad.
                    </p>
                </div>
                <div class="rd-op-card-img-wrapper">
                    <video
                        src="/videos/realidade-digital/changeover.webm"
                        class="rd-op-card-img"
                        autoplay
                        loop
                        muted
                        playsinline></video>
                </div>
            </div>

            <div class="rd-op-card">
                <div class="rd-op-card-content">
                    <h3>Mantenimiento</h3>
                    <p>
                        Mantenimiento guiado por instrucciones visuales
                        interactivas, combinando información digital y el
                        contexto real para una ejecución precisa.
                    </p>
                </div>
                <div class="rd-op-card-img-wrapper">
                    <video
                        src="/videos/realidade-digital/manutenção.webm"
                        class="rd-op-card-img"
                        autoplay
                        loop
                        muted
                        playsinline></video>
                </div>
            </div>

            <div class="rd-op-card">
                <div class="rd-op-card-content">
                    <h3>Soporte Remoto</h3>
                    <p>
                        Soporte remoto en tiempo real visualizando al
                        especialista local para resolver problemas con más
                        agilidad.
                    </p>
                </div>
                <div class="rd-op-card-img-wrapper">
                    <video
                        src="/videos/realidade-digital/suporte-remoto.webm"
                        class="rd-op-card-img"
                        autoplay
                        loop
                        muted
                        playsinline></video>
                </div>
            </div>
        </div>
    </div>

    <div class="rd-pronto-transformar container-boxed">
        <div class="content">
            <h2>
                ¿Listo para transformar la forma en que su equipo aprende y
                ejecuta?
            </h2>
            <h3>
                Traiga los desafíos de su operación. Ayudamos a transformar la
                capacitación técnica en un rendimiento real en el día a día.
            </h3>
            <span class="button">
                <ButtonArrowWhite
                    text="Llevar la realidad digital a mi negocio"
                />
            </span>
        </div>

        <div class="cubo-img-wrapper">
            <video
                src="/videos/cubo-hero.webm"
                class="cuboImg"
                autoplay
                loop
                muted
                playsinline
                poster={CuboImg.src}></video>
        </div>
    </div>
</Layout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        let mm = gsap.matchMedia();

        mm.add("(min-width: 801px)", () => {
            const cards = gsap.utils.toArray(".rd-op-card") as HTMLElement[];

            cards.forEach((card, index) => {
                if (index < cards.length - 1) {
                    gsap.to(card, {
                        scale: 1 - 0.05 * (cards.length - 1 - index),
                        ease: "none",
                        scrollTrigger: {
                            trigger: cards[index + 1],
                            start: `top bottom-=200`,
                            end: `top top+=${100 + (index + 1) * 30}`,
                            scrub: true,
                            invalidateOnRefresh: true,
                        },
                    });
                }
            });
        });

        mm.add("(min-width: 801px) and (max-width: 2399px)", () => {
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: ".hero",
                    start: "top top",
                    end: "+=150%",
                    scrub: 1,
                    pin: true,
                },
            });

            tl.to(".hero .content", { opacity: 0, y: -100, duration: 1 })
                .to(".arrow-down", { opacity: 0, duration: 0.2 }, "<")
                .to(
                    ".hero .cubo-img-wrapper",
                    { y: "10vh", x: "12vw", scale: 0.8, duration: 1 },
                    "<"
                )
                .fromTo(
                    ".ambientes-virtuais",
                    { opacity: 0, marginTop: "5vh" },
                    { opacity: 1, marginTop: "-50vh", duration: 0.8 },
                    "-=0.8"
                );
        });

        mm.add("(min-width: 2400px)", () => {
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: ".hero",
                    start: "top top",
                    end: "+=150%",
                    scrub: 1,
                    pin: true,
                },
            });

            tl.to(".hero .content", { opacity: 0, y: -80, duration: 1 })
                .to(".arrow-down", { opacity: 0, duration: 0.2 }, "<")
                .to(
                    ".hero .cubo-img-wrapper",
                    { y: "0vh", x: 350, scale: 0.7, duration: 1 },
                    "<"
                )
                .fromTo(
                    ".ambientes-virtuais",
                    { opacity: 0, marginTop: "5vh" },
                    { opacity: 1, marginTop: "-40vh", duration: 0.8 },
                    "-=0.8"
                );
        });

        mm.add("(max-width: 800px)", () => {
            const tlMobile = gsap.timeline({
                scrollTrigger: {
                    trigger: ".hero",
                    start: "top top",
                    end: "+=120%",
                    scrub: 1,
                    pin: true,
                },
            });

            tlMobile
                .to(".hero .content", { opacity: 0, y: -50, duration: 1 })
                .to(".arrow-down", { opacity: 0, duration: 0.2 }, "<")
                .to(".hero .cubo-img-wrapper", { y: "-10vh", duration: 1 }, "<")
                .fromTo(
                    ".ambientes-virtuais",
                    { opacity: 0, marginTop: "5vh" },
                    { opacity: 1, marginTop: "-20vh", duration: 0.8 },
                    "-=0.8"
                );
        });
    });

    const container = document.getElementById("video-container");
    const placeholder = document.getElementById("video-placeholder");

    placeholder?.addEventListener("click", () => {
        if (container) {
            container.innerHTML = `
                <iframe
                    width="100%"
                    height="100%"
                    src="https://www.youtube.com/embed/ScMzIvxBSi4?autoplay=1"
                    title="YouTube video player"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen>
                </iframe>
            `;
        }
    });
</script>
