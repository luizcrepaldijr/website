---
import Layout from "../layouts/Layout.astro";
import "../styles/pages/home/home.css";
import { Image } from "astro:assets";
import CuboImg from "../images/home/hero/cubo.webp";
import Unilever from "../images/home/parceirosglobais/unilever.webp";
import Evera from "../images/home/parceirosglobais/evera.webp";
import LivingProof from "../images/home/parceirosglobais/living-proof.webp";
import SobreNosArk from "../images/home/sobrenos/sobre-nos-ark.webp";
import TecnologiaAvancada from "../images/home/sobrenos/tecnologia-avancada.webp";
import Logo from "../images/logo-2.webp";
import OperacaoUnilever from "../images/home/cases/operacao-unilever.webp";
import PowerBI from "../images/home/cases/power-bi.webp";
import Python from "../images/home/cases/python.webp";
import Meta from "../images/home/cases/meta.webp";
import Azure from "../images/home/cases/azure.webp";
import ReactAdmin from "../images/home/cases/react-admin.webp";
import CurvaImg from "../images/home/curva/curva.webp";
import ButtonArrowAnimation from "../components/buttons/ButtonArrowAnimation.astro";
import ButtonArrow from "../components/buttons/ButtonArrow.astro";
import ButtonArrowWhite from "../components/buttons/ButtonArrowWhite.astro";
import CarousselSolutions from "../components/carroussel/CarousselSolutions.astro";
import CarousselCases from "../components/carroussel/CarousselCases.astro";
import Badge from "../components/Badge.astro";
import Badge2 from "../components/Badge2.astro";
import Counter from "../components/Counter.astro";
import TestimonialsMarquee from "../components/TestimonialsMarquee.astro";
---

<Layout>
  <!-- HERO -->
  <div class="hero container-boxed">
    <div class="content">
      <h1>Tecnologia para <b>impulsionar</b> sua transformação digital</h1>
      <h3>
        Desenvolvemos soluções digitais sob medida para integrar sistemas,
        otimizar processos e apoiar decisões estratégicas.
      </h3>
      <span class="button">
        <ButtonArrowAnimation text="Quero começar" />
      </span>
    </div>

    <div class="cubo-img-wrapper">
      <Image src={CuboImg} class="cuboImg" alt="cubo girando" />
    </div>
  </div>

  <!-- PARCEIROS GLOBAIS -->
  <div class="parceiros container-boxed">
    <h4><b>Parceiros globais</b> que confiam na Transformatech</h4>
    <div>
      <Image src={Unilever} class="img" alt="Unilever" />
      <Image src={Evera} class="img" alt="Evera" />
      <Image src={LivingProof} class="img" alt="Living Proof" />
    </div>
  </div>

  <!-- SERVIÇOS -->
  <div class="servicos container">
    <div class="container-boxed">
      <div class="servicos-title">
        <span class="text-container">
          <h2>
            Soluções integradas, de ponta a ponta, para elevar sua
            competitividade
          </h2>
          <h3>
            Atuamos do planejamento à execução, conectando tecnologia, processos
            e dados.
          </h3>
        </span>

        <span class="button-container">
          <ButtonArrow text="Conhecer todos serviços" />
        </span>
      </div>
      <CarousselSolutions>
        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/transformacao-digital.webm" type="video/mp4" />
          </video>

          <h4>Transformação Digital</h4>
          <p>
            Capacitamos o seu negócio por meio de soluções inteligentes,
            conectadas e orientadas por dados.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/transformacao-digital.webm" type="video/mp4" />
          </video>

          <h4>Transformação Digital</h4>
          <p>
            Capacitamos o seu negócio por meio de soluções inteligentes,
            conectadas e orientadas por dados.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/transformacao-digital.webm" type="video/mp4" />
          </video>

          <h4>Transformação Digital</h4>
          <p>
            Capacitamos o seu negócio por meio de soluções inteligentes,
            conectadas e orientadas por dados.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/transformacao-digital.webm" type="video/mp4" />
          </video>

          <h4>Transformação Digital</h4>
          <p>
            Capacitamos o seu negócio por meio de soluções inteligentes,
            conectadas e orientadas por dados.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/transformacao-digital.webm" type="video/mp4" />
          </video>

          <h4>Transformação Digital</h4>
          <p>
            Capacitamos o seu negócio por meio de soluções inteligentes,
            conectadas e orientadas por dados.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/transformacao-digital.webm" type="video/mp4" />
          </video>

          <h4>Transformação Digital</h4>
          <p>
            Capacitamos o seu negócio por meio de soluções inteligentes,
            conectadas e orientadas por dados.
          </p>
        </div>

        <div class="embla__solutions__slide solucoes-card">
          <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/transformacao-digital.webm" type="video/mp4" />
          </video>

          <h4>Transformação Digital</h4>
          <p>
            Capacitamos o seu negócio por meio de soluções inteligentes,
            conectadas e orientadas por dados.
          </p>
        </div>
      </CarousselSolutions>
    </div>
  </div>

  <!-- SOBRE NÓS -->
  <div class="sobre-nos container-boxed">
    <Image class="ark" src={SobreNosArk} alt="" />
    <Badge text="Sobre nós" />
    <h2>
      Somos uma consultoria especializada em digitalizar <b
        >operações complexas</b
      >
    </h2>
    <div class="sobrenos-content">
      <Image src={TecnologiaAvancada} alt="" class="tecnologia-avancada" />
      <div>
        <h4>
          Usamos tecnologia avançada para transformar dados em direção
          estratégica.
        </h4>

        <h3>
          Conectamos engenharia, automação e análise inteligente de forma
          precisa. Com atuação no Brasil e nos Estados Unidos, trabalhamos
          próximos à operação para entender desafios reais e antecipar
          necessidades com soluções aplicadas e eficientes.
          <br /><br />
          Nossa cultura é prática e orientada a resultado: cada entrega precisa gerar
          impacto mensurável, reduzir riscos e elevar competitividade. Mais do que
          implementar sistemas, atuamos como parceiros de longo prazo, combinando
          visão técnica e estratégia digital para evoluir a sua operação de ponta
          a ponta.
        </h3>

        <ButtonArrow text="Saiba mais" />
      </div>
    </div>
  </div>

  <!-- NUMEROS -->
  <div class="numeros container-boxed">
    <h2>Números que refletem nosso impacto</h2>
    <div class="counter-wrapper">
      <Counter prenumber="+" number="400" description="Projetos entregues" />
      <Counter prenumber="+" number="10" description="Fábricas conectadas" />
      <Counter
        prenumber="+"
        number="200"
        description="Fontes de dados conectadas"
      />
      <Counter prenumber="+" number="10" description="Cidades atendidas" />
    </div>
  </div>

  <!-- CASES -->
  <div class="cases container-boxed">
    <Badge text="Cases" />
    <h2>Resultados que <b>transformam</b></h2>
    <h3>
      Casos reais que demonstram como nossas soluções geram impactos nos
      negócios
    </h3>
    <CarousselCases>
      <div class="embla__cases__slide">
        <div class="cases-card">
          <Image
            src={OperacaoUnilever}
            alt="Operação Unilever"
            class="unilever"
          />
          <div class="cases-card-content">
            <div class="badges">
              <Badge2 text="Transformação digital" />
              <Badge2 text="Indústria" />
            </div>
            <h2>
              Como ajudamos a reduzir 42% do retrabalho na operação da Unilever
            </h2>
            <p>
              Digitalizamos fluxos críticos e ativamos alertas inteligentes em
              uma linha de produção da Unilever, eliminando falhas manuais e
              aumentando a eficiência em poucas semanas.
            </p>
            <div class="tecnologias">
              <h4>Tecnologias utilizadas</h4>
              <div class="tecnologias-images">
                <Image
                  src={PowerBI}
                  alt="Power BI"
                  class="powerbi tecnologia-img"
                />
                <Image
                  src={Python}
                  alt="Python"
                  class="python tecnologia-img"
                />
                <Image src={Meta} alt="Meta" class="meta tecnologia-img" />
                <Image src={Azure} alt="Azure" class="azure tecnologia-img" />
                <Image
                  src={ReactAdmin}
                  alt="React Admin"
                  class="react-admin tecnologia-img"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="embla__cases__slide">
        <div class="cases-card">
          <Image
            src={OperacaoUnilever}
            alt="Operação Unilever"
            class="unilever"
          />
          <div class="cases-card-content">
            <div class="badges">
              <Badge2 text="Transformação digital" />
              <Badge2 text="Indústria" />
            </div>
            <h2>
              Como ajudamos a reduzir 42% do retrabalho na operação da Unilever
            </h2>
            <p>
              Digitalizamos fluxos críticos e ativamos alertas inteligentes em
              uma linha de produção da Unilever, eliminando falhas manuais e
              aumentando a eficiência em poucas semanas.
            </p>
            <div class="tecnologias">
              <h4>Tecnologias utilizadas</h4>
              <div class="tecnologias-images">
                <Image
                  src={PowerBI}
                  alt="Power BI"
                  class="powerbi tecnologia-img"
                />
                <Image
                  src={Python}
                  alt="Python"
                  class="python tecnologia-img"
                />
                <Image src={Meta} alt="Meta" class="meta tecnologia-img" />
                <Image src={Azure} alt="Azure" class="azure tecnologia-img" />
                <Image
                  src={ReactAdmin}
                  alt="React Admin"
                  class="react-admin tecnologia-img"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="embla__cases__slide">
        <div class="cases-card">
          <Image
            src={OperacaoUnilever}
            alt="Operação Unilever"
            class="unilever"
          />
          <div class="cases-card-content">
            <div class="badges">
              <Badge2 text="Transformação digital" />
              <Badge2 text="Indústria" />
            </div>
            <h2>
              Como ajudamos a reduzir 42% do retrabalho na operação da Unilever
            </h2>
            <p>
              Digitalizamos fluxos críticos e ativamos alertas inteligentes em
              uma linha de produção da Unilever, eliminando falhas manuais e
              aumentando a eficiência em poucas semanas.
            </p>
            <div class="tecnologias">
              <h4>Tecnologias utilizadas</h4>
              <div class="tecnologias-images">
                <Image
                  src={PowerBI}
                  alt="Power BI"
                  class="powerbi tecnologia-img"
                />
                <Image
                  src={Python}
                  alt="Python"
                  class="python tecnologia-img"
                />
                <Image src={Meta} alt="Meta" class="meta tecnologia-img" />
                <Image src={Azure} alt="Azure" class="azure tecnologia-img" />
                <Image
                  src={ReactAdmin}
                  alt="React Admin"
                  class="react-admin tecnologia-img"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </CarousselCases>
    <ButtonArrow text="Conhecer cases" />
  </div>

  <!-- CURVA -->
  <div class="curva container-boxed">
    <h2>
      Tecnologia avançada integrando dados, pessoas e processos de ponta a ponta
      para negócios mais competitivos.
    </h2>
    <ButtonArrowWhite text="Falar com um especialista" />
    <Image src={CurvaImg} alt="Curva" class="curva-img" />
  </div>

  <!-- DEPOIMENTOS -->
  <div class="depoimentos container-boxed">
    <Badge text="Depoimentos" />
    <h2>O que dizem nossos clientes</h2>
    <h3>
      Feedbacks reais de quem já acelerou sua transformação digital com a gente.
    </h3>

    <TestimonialsMarquee />
  </div>

  <!-- FALE COM O TIME -->
  <div class="falecomtime container">
    <div class="container-boxed">
      <Image src={Logo} alt="Logo Transformatech" class="logo-falecomtime" />
      <h2>Pronto para digitalizar seu negócio?</h2>
      <h3>
        Fale com nosso time e descubra como a tecnologia pode trabalhar a favor
        do seu negócio.
      </h3>
      <ButtonArrowAnimation text="Falar com um especialista" />
    </div>
  </div>
</Layout>
