---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import CuboImg from "../images/cubo.webp";
import Unilever from "../images/unilever.webp";
import Evera from "../images/evera.webp";
import LivingProof from "../images/living-proof.webp";
import ButtonArrow from "../components/ButtonArrow.astro";
---

<Layout>
  <div class="hero container">
    <div class="content">
      <h1>Tecnologia para <b>impulsionar</b> sua transformação digital</h1>
      <h3>
        Desenvolvemos soluções digitais sob medida para integrar sistemas,
        otimizar processos e apoiar decisões estratégicas.
      </h3>
      <span class="button">
        <ButtonArrow text="Quero começar" />
      </span>
    </div>

    <Image src={CuboImg} class="cuboImg" alt="cubo girando" />
  </div>

  <div class="parceiros container">
      <h2>Parceiros globais que confiam na Transformatech</h2>
      <div>
        <Image src={Unilever} class="img" alt="Unilever" />
        <Image src={Evera} class="img" alt="Evera" />
        <Image src={LivingProof} class="img" alt="Living Proof"/>
      </div>
  </div>
</Layout>

<style>
  h3 {
    font-weight: 400;
    font-size: clamp(16px, 2.5vw, 24px);
    line-height: 1.4;
  }

  h2 {
    font-weight: 400;
    font-size: clamp(18px, 3vw, 28px);
    line-height: 1.4;
  }

  .hero {
    min-height: 80vh;
    padding: 40px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;

    .content {
      display: flex;
      gap: 32px;
      flex-direction: column;
      width: 50%;
      max-width: 900px;

      h1 {
        font-weight: 400;
        font-size: clamp(28px, 4vw, 80px);
        line-height: 1.2;
      }

      span {
        width: max-content;
      }
    }

    .cuboImg {
      width: 38%;
      max-width: 1000px;
      height: auto;
    }
  }

  .parceiros {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    gap: 30px;

    div {
      display: flex;
      align-items: center;
      gap: 20px;
      width: 100%;
      max-width: 200px;

      .img {
        flex: 1;
        max-width: 100%;    
      }
    }
  }

  @media only screen and (max-width: 800px) {
    .hero {
      flex-direction: column;
      align-items: center;
      padding: 40px 15px;
    }

    .hero .content {
      max-width: 100%;
      width: 100%;
      text-align: center;
      align-items: center;
      gap: 24px;
    }

    .hero .cuboImg {
      width: 80%;
      height: auto;
    }

    span {
      width: 80% !important;
    }
  }
</style>
