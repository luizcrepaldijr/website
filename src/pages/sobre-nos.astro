        role: "Business Developer",
        description:
            "Executivo C-level e fundador, com mais de 30 anos de experiência em manufatura, life sciences e tecnologia. Atua na liderança de transformações complexas, conectando inovação, operação e crescimento em ambientes altamente regulados.",
        image: marioOliveira,
        linkedin: "#",
        instagram: "#",
        facebook: "#",
    },
    {
        name: "Matheus Braz",
        role: "Software Developer",
        description:
