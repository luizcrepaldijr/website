    },
    {
        name: "Luiz Crepaldi",
        role: "AI & Data Scientist",
        description:
            "Engenheiro em formação, atua com Inteligência Artificial aplicada no desenvolvimento de soluções que automatizam processos, extraem valor de dados e impulsionam a inovação dentro das empresas.",
        image: luizCrepaldi,
        linkedin: "#",
