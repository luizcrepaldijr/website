---
import Layout from "../layouts/Layout.astro";
import SolucoesImg from "../images/solucoes/solucoes.webp";
import "../styles/pages/solucoes.css";
import { Icon } from "astro-icon/components";

import TransformacaoDigitalImg from "../images/solucoes/transformacao-digital-solucao.webp";
import Industria40Img from "../images/solucoes/industria-4-0-solucao.webp";
import EngenhariaImg from "../images/solucoes/engenharia-solucao.webp";
import Agricultura40Img from "../images/solucoes/agricultura-4-0-solucao.webp";
import IotImg from "../images/solucoes/iot-solucao.webp";
import EsferaImg from "../images/solucoes/esfera.webp";
import TecnologiasDesktop from "../images/solucoes/tecnologias-desktop.webp";
import TecnologiasMobile from "../images/solucoes/tecnologias-mobile.webp";
import TecnologiasMarquee from "../components/TecnologiasMarquee.astro";
import Image from "astro/components/Image.astro";
import Accordion from "../components/Accordion.astro";
import ButtonArrowSquare from "../components/buttons/ButtonArrowSquare.astro";
import Badge from "../components/Badge.astro";
import FaleConosco from "../components/FaleConosco.astro";
import SolucoesSection from "../components/SolucoesSection.astro";
import "../styles/pages/iot.css";
import LogoBigFallback from "../images/logo-big.webp";
import LogoAbreviadaTT from "../icons/logo-abreviada-tt.svg";
import Ellipse1 from "../icons/ellipse-1.svg";
import Ellipse2 from "../icons/ellipse-2.svg";
import CarousselWorkflow from "../components/carroussel/CarousselWorkflow.astro";
import FaleConoscoBig from "../components/FaleConoscoBig.astro";

const wfSteps = [
    {
        title: "Diagnóstico",
        desc: "Entendemos a realidade do negócio, os desafios operacionais e as oportunidades.",
    },
    {
        title: "Planejamento Estratégico",
        desc: "Definimos objetivos, indicadores e prioridades com clareza e alinhamento.",
    },
    {
        title: "Desenho da solução",
        desc: "Co-criamos soluções considerando tecnologia, processos e pessoas.",
    },
    {
        title: "Implementação",
        desc: "Executamos com foco em agilidade, segurança e integração aos sistemas existentes.",
    },
    {
        title: "Monitoramento e Otimização",
        desc: "Acompanhamos resultados e ajustamos continuamente.",
    },
    {
        title: "Resultados Sustentáveis",
        desc: "Entregamos visibilidade, aprendizado e base para evolução contínua.",
    },
];
---

<Layout>
    <div class="hero container-boxed">
        <div class="content">
            <h1>Nossas soluções</h1>
            <h3>
                Arquitetamos estratégia, conectamos dados e transformamos
                operações reais.
            </h3>
        </div>

        <div class="solucoes-img-wrapper">
            <video
                src="/videos/solucoes/solucoes.webm"
                class="solucoesImg"
                autoplay
                loop
                muted
                playsinline
                poster={SolucoesImg.src}></video>
        </div>
    </div>
    <div class="marquee container">
        <div class="marquee-content">
            <h3>Transformação digital</h3>
            <Icon name="dot" />
            <h3>Indústria 4.0</h3>
            <Icon name="dot" />
            <h3>Engenharia</h3>
            <Icon name="dot" />
            <h3>Agricultura 4.0</h3>
            <Icon name="dot" />
            <h3>IoT</h3>
            <Icon name="dot" />
            <h3>Robótica</h3>
            <Icon name="dot" />
        </div>
        <div class="marquee-content" aria-hidden="true">
            <h3>Transformação digital</h3>
            <Icon name="dot" />
            <h3>Indústria 4.0</h3>
            <Icon name="dot" />
            <h3>Engenharia</h3>
            <Icon name="dot" />
            <h3>Agricultura 4.0</h3>
            <Icon name="dot" />
            <h3>IoT</h3>
            <Icon name="dot" />
            <h3>Robótica</h3>
            <Icon name="dot" />
        </div>
    </div>
    <SolucoesSection />
    <div class="comofazemos container-boxed">
        <div class="content">
            <Badge text="Como fazemos" />
            <h2>
                Entendemos os desafios do seu negócio e
                <b>cocriamos</b> soluções
            </h2>
            <h3>
                Nossa metodologia combina estratégia, tecnologia e execução ágil
                para garantir<br />projetos tecnicamente sólidos, alinhados ao
                negócio e focados em resultados reais.
            </h3>
        </div>

        <div class="comofazemos-img-wrapper">
            <video
                src="/videos/solucoes/esfera.webm"
                class="esferaImg"
                autoplay
                loop
                muted
                playsinline
                poster={EsferaImg.src}></video>
            <a href="#workflow" class="workflow-link">
                Conheça nosso workflow
                <Icon name="arrow-down" class="workflow-arrow" />
            </a>
        </div>
    </div>

    <!-- ── WORKFLOW ── -->
    <div id="workflow" class="iot-workflow-scrollarea sol-workflow">
        <div class="iot-workflow-pinned">
            <div class="wf-ellipse-wrapper">
                <img src={Ellipse1.src} class="wf-ellipse-1" alt="" />
                <img src={Ellipse2.src} class="wf-ellipse-2" alt="" />
            </div>

            <div class="wf-logo-wrapper">
                <img src={LogoAbreviadaTT.src} class="wf-logo" alt="" />
            </div>

            <!-- Desktop -->
            <div class="wf-content">
                <div class="wf-header">
                    <h2>Nosso workflow</h2>
                </div>
                <div class="wf-steps-area">
                    {
                        wfSteps.map((step, i) => (
                            <div class={`wf-step wf-step-${i}`}>
                                <div class="wf-line" />
                                <span class="wf-dot">
                                    <Icon name="dot" size={12} />
                                </span>
                                <h3>{step.title}</h3>
                                <p class="wf-desc">{step.desc}</p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Mobile carousel -->
            <div class="wf-mobile-carousel">
                <div class="wf-mobile-header">
                    <h2>Nosso workflow</h2>
                </div>
                <CarousselWorkflow
                    steps={wfSteps}
                    logoSrc={LogoBigFallback.src}
                />
            </div>
        </div>
    </div>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        function initWorkflow() {
            ScrollTrigger.getAll()
                .filter((st) =>
                    st.vars?.trigger?.toString?.().includes?.("sol-workflow"),
                )
                .forEach((st) => st.kill());

            const mm = gsap.matchMedia();

            mm.add("(min-width: 801px)", () => {
                const WF_STEPS = 6;
                const WF_DUR = 1;
                const WF_DEG = 360 / WF_STEPS; // 60° per step
                const WF_RADIUS = 380;

                function getX(y: number) {
                    const val = WF_RADIUS ** 2 - y ** 2;
                    return Math.sqrt(Math.max(0, val)) - WF_RADIUS;
                }

                function getRot(y: number) {
                    const ratio = Math.max(
                        -0.99,
                        Math.min(0.99, y / WF_RADIUS),
                    );
                    return Math.asin(ratio) * (180 / Math.PI);
                }

                gsap.set(".sol-workflow .wf-step-0", {
                    y: 0,
                    x: 0,
                    rotation: 0,
                    transformOrigin: "left center",
                });
                gsap.set(".sol-workflow .wf-step-0 .wf-line", { autoAlpha: 1 });
                gsap.set(".sol-workflow .wf-step-0 .wf-dot", { opacity: 1 });
                gsap.set(".sol-workflow .wf-step-0 h3", { opacity: 1 });
                gsap.set(".sol-workflow .wf-step-0 .wf-desc", { autoAlpha: 1 });

                for (let i = 1; i < WF_STEPS; i++) {
                    const qY = i * 78;
                    const qX = getX(qY);
                    const vis = i <= 2;
                    const hOp = i === 1 ? 0.28 : 0.16;
                    gsap.set(`.sol-workflow .wf-step-${i}`, {
                        y: qY,
                        x: qX,
                        rotation: getRot(qY),
                        transformOrigin: "left center",
                        autoAlpha: vis ? 1 : 0,
                    });
                    gsap.set(`.sol-workflow .wf-step-${i} .wf-line`, {
                        autoAlpha: 0,
                    });
                    gsap.set(`.sol-workflow .wf-step-${i} .wf-dot`, {
                        opacity: vis ? 0.35 : 0,
                    });
                    gsap.set(`.sol-workflow .wf-step-${i} h3`, {
                        opacity: vis ? hOp : 0,
                    });
                    gsap.set(`.sol-workflow .wf-step-${i} .wf-desc`, {
                        autoAlpha: 0,
                    });
                }

                const wfTl = gsap.timeline({
                    scrollTrigger: {
                        trigger: ".sol-workflow",
                        start: "top top",
                        end: `+=${(WF_STEPS - 1) * 100}%`,
                        scrub: 1,
                        pin: true,
                        anticipatePin: 1,
                    },
                });

                for (let i = 0; i < WF_STEPS - 1; i++) {
                    const t = i * WF_DUR;

                    wfTl.to(
                        ".sol-workflow .wf-logo",
                        {
                            rotation: (i + 1) * WF_DEG,
                            ease: "none",
                            duration: WF_DUR,
                        },
                        t,
                    );

                    wfTl.to(
                        `.sol-workflow .wf-step-${i} .wf-desc`,
                        { autoAlpha: 0, duration: 0.2 },
                        t,
                    )
                        .to(
                            `.sol-workflow .wf-step-${i} .wf-line`,
                            { autoAlpha: 0, duration: 0.2 },
                            t,
                        )
                        .to(
                            `.sol-workflow .wf-step-${i} .wf-dot`,
                            { opacity: 0, duration: 0.2 },
                            t,
                        )
                        .to(
                            `.sol-workflow .wf-step-${i} h3`,
                            { opacity: 0, duration: 0.2 },
                            t,
                        )
                        .to(
                            `.sol-workflow .wf-step-${i}`,
                            {
                                autoAlpha: 0,
                                y: -55,
                                x: getX(-55),
                                rotation: getRot(-55),
                                duration: 0.35,
                            },
                            t + 0.15,
                        );

                    wfTl.to(
                        `.sol-workflow .wf-step-${i + 1}`,
                        {
                            autoAlpha: 1,
                            y: 0,
                            x: 0,
                            rotation: 0,
                            duration: 0.4,
                        },
                        t + 0.45,
                    )
                        .to(
                            `.sol-workflow .wf-step-${i + 1} .wf-line`,
                            { autoAlpha: 1, duration: 0.3 },
                            t + 0.6,
                        )
                        .to(
                            `.sol-workflow .wf-step-${i + 1} .wf-dot`,
                            { opacity: 1, duration: 0.3 },
                            t + 0.6,
                        )
                        .to(
                            `.sol-workflow .wf-step-${i + 1} h3`,
                            { opacity: 1, duration: 0.3 },
                            t + 0.6,
                        )
                        .to(
                            `.sol-workflow .wf-step-${i + 1} .wf-desc`,
                            { autoAlpha: 1, duration: 0.3 },
                            t + 0.7,
                        );

                    for (let j = i + 2; j < WF_STEPS; j++) {
                        const offset = j - (i + 1);
                        const vis = offset <= 2;
                        const hOp = offset === 1 ? 0.28 : 0.16;
                        const qY = offset * 78;
                        const qX = getX(qY);
                        wfTl.to(
                            `.sol-workflow .wf-step-${j}`,
                            {
                                autoAlpha: vis ? 1 : 0,
                                y: qY,
                                x: qX,
                                rotation: getRot(qY),
                                duration: 0.4,
                            },
                            t + 0.45,
                        )
                            .to(
                                `.sol-workflow .wf-step-${j} .wf-dot`,
                                { opacity: vis ? 0.35 : 0, duration: 0.3 },
                                t + 0.45,
                            )
                            .to(
                                `.sol-workflow .wf-step-${j} h3`,
                                { opacity: vis ? hOp : 0, duration: 0.3 },
                                t + 0.45,
                            );
                    }
                }

                requestAnimationFrame(() => {
                    requestAnimationFrame(() => ScrollTrigger.refresh());
                });
            });
        }

        document.addEventListener("DOMContentLoaded", initWorkflow);
    </script>

    <div class="tecnologias container-boxed">
        <div class="content-desktop">
            <h3>Especialistas em</h3>
            <h2>20+</h2>
            <h4>tecnologias</h4>
        </div>

        <div class="content-mobile">
            <h3>Especialistas em <br /> <span>20+</span> tecnologias</h3>
        </div>

        <TecnologiasMarquee />
    </div>

    <FaleConoscoBig
        title="Pronto para digitalizar o seu negócio?"
        subtitle="Fale com nossa equipe e descubra como a tecnologia pode trabalhar a favor do seu negócio."
        buttonText="Falar com um especialista"
    />
</Layout>
