---
import Layout from "../layouts/Layout.astro";
import SolucoesImg from "../images/solucoes/solucoes.webp";
import "../styles/pages/solucoes.css";
import { Icon } from "astro-icon/components";

import TransformacaoDigitalImg from "../images/solucoes/transformacao-digital-solucao.webp";
import Industria40Img from "../images/solucoes/industria-4-0-solucao.webp";
import EngenhariaImg from "../images/solucoes/engenharia-solucao.webp";
import Agricultura40Img from "../images/solucoes/agricultura-4-0-solucao.webp";
import IotImg from "../images/solucoes/iot-solucao.webp";
import EsferaImg from "../images/solucoes/esfera.webp";
import Image from "astro/components/Image.astro";
import Accordion from "../components/Accordion.astro";
import ButtonArrowSquare from "../components/buttons/ButtonArrowSquare.astro";
import Badge from "../components/Badge.astro";
---

<Layout>
    <div class="hero container-boxed">
        <div class="content">
            <h1>Nossas soluções</h1>
            <h3>
                Arquitetamos estratégia, conectamos dados e transformamos
                operações reais.
            </h3>
        </div>

        <div class="solucoes-img-wrapper">
            <video
                src="/videos/solucoes.webm"
                class="solucoesImg"
                autoplay
                loop
                muted
                playsinline
                poster={SolucoesImg.src}></video>
        </div>
    </div>
    <div class="marquee container">
        <div class="marquee-content">
            <h3>Transformação digital</h3>
            <Icon name="dot" />
            <h3>Indústria 4.0</h3>
            <Icon name="dot" />
            <h3>Engenharia</h3>
            <Icon name="dot" />
            <h3>Agricultura 4.0</h3>
            <Icon name="dot" />
            <h3>IoT</h3>
            <Icon name="dot" />
            <h3>Robótica</h3>
            <Icon name="dot" />
        </div>
        <div class="marquee-content" aria-hidden="true">
            <h3>Transformação digital</h3>
            <Icon name="dot" />
            <h3>Indústria 4.0</h3>
            <Icon name="dot" />
            <h3>Engenharia</h3>
            <Icon name="dot" />
            <h3>Agricultura 4.0</h3>
            <Icon name="dot" />
            <h3>IoT</h3>
            <Icon name="dot" />
            <h3>Robótica</h3>
            <Icon name="dot" />
        </div>
    </div>
    <div class="solucoes-list container-boxed">
        <div class="solucoes-item">
            <Image
                src={TransformacaoDigitalImg}
                alt="Transformacao Digital"
                class="solucoes-item-img"
            />

            <div class="content">
                <h2>Transformação digital</h2>

                <h3>
                    Capacitamos o seu negócio por meio de soluções inteligentes,
                    conectadas e orientadas por dados.
                </h3>
                <p>
                    Ajudamos as organizações a desbloquear todo o potencial de
                    seus dados e tecnologias ao integrar ferramentas
                    inteligentes, automatizar processos e possibilitar insights
                    em tempo real que impulsionam a tomada de decisões
                    estratégicas.
                </p>

                <div class="accordion-wrapper">
                    <Accordion
                        title="Consultoria"
                        description="Ajudamos empresas de bens de consumo a impulsionar sua transformação digital com foco em impacto real. Com experiência prática em operações industriais, definimos projetos, tecnologias e estratégias que geram resultados concretos, por meio de roadmaps escaláveis e alinhados ao negócio."
                    />
                    <Accordion
                        title="Integração de inteligência artificial"
                        description="Desenvolvemos soluções baseadas em Inteligência Artificial projetadas para resolver desafios operacionais específicos. Ao combinar nossa experiência no setor com capacidades avançadas de IA, criamos soluções que aumentam a eficiência, impulsionam a produtividade e geram ganhos mensuráveis."
                    />
                    <Accordion
                        title="Data Analytics & Applied Data Science"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                    <Accordion
                        title="Treinamento & Bootcamp"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                </div>
            </div>
        </div>
        <div class="solucoes-item">
            <Image
                src={Industria40Img}
                alt="Industria 4.0"
                class="solucoes-item-img"
            />

            <div class="content">
                <h2>Industria 4.0</h2>

                <h3>
                    Conectamos o mundo físico e digital para aumentar
                    visibilidade, controle e desempenho industrial.
                </h3>
                <p>
                    Atuamos em ambientes industriais onde a falta de integração
                    entre máquinas, sistemas e dados limita a eficiência
                    operacional. Implementamos soluções de Industry 4.0 que
                    conectam o chão de fábrica ao ambiente digital, permitindo
                    operações mais previsíveis, seguras e orientadas por dados.
                </p>

                <div class="accordion-wrapper">
                    <Accordion
                        title="Infraestrutura de dados e redes OT"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                    <Accordion
                        title="Cibersegurança"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                    <Accordion
                        title="Programação"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                    <Accordion
                        title="Suporte em campo e remoto"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                </div>
            </div>
        </div>
        <div class="solucoes-item">
            <Image
                src={EngenhariaImg}
                alt="Engenharia"
                class="solucoes-item-img"
            />

            <div class="content">
                <h2>Engenharia</h2>

                <h3>
                    Transformamos ideias complexas em soluções técnicas viáveis
                    e eficientes.
                </h3>
                <p>
                    Oferecemos serviços de engenharia ponta a ponta para
                    projetos que exigem rigor técnico, planejamento e execução
                    precisa. Atuamos desde a concepção até a implementação,
                    conectando engenharia, tecnologia e operação para reduzir
                    riscos e otimizar resultados.
                </p>

                <div class="accordion-wrapper">
                    <Accordion
                        title="Gerenciamento de projetos"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                    <Accordion
                        title="Estudos conceituais e de viabilidade"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                    <Accordion
                        title="Estimativas de capital e documentação técnica"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                    <Accordion
                        title="Modelagem e simulação"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                    <Accordion
                        title="Projetos elétricos, mecânicos e de automação"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                </div>
            </div>
        </div>
        <div class="solucoes-item">
            <Image
                src={Agricultura40Img}
                alt="Agricultura 4.0"
                class="solucoes-item-img"
            />

            <div class="content">
                <h2>Agricultura 4.0</h2>

                <h3>
                    Ajudamos produtores e operações agrícolas a tomar decisões
                    melhores usando dados reais do campo.
                </h3>
                <p>
                    Aplicamos tecnologia para transformar informações do solo e
                    do ambiente em inteligência prática, permitindo irrigar
                    melhor, reduzir desperdícios, aumentar produtividade e
                    operar de forma mais sustentável e previsível.
                </p>

                <div class="accordion-wrapper">
                    <Accordion
                        title="Gerenciamento de projetos"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                    <Accordion
                        title="Estudos conceituais e de viabilidade"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                    <Accordion
                        title="Estimativas de capital e documentação técnica"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                    <Accordion
                        title="Modelagem e simulação"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                    <Accordion
                        title="Projetos elétricos, mecânicos e de automação"
                        description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quod."
                    />
                </div>
            </div>
        </div>
        <div class="solucoes-item">
            <Image src={IotImg} alt="IoT" class="solucoes-item-img" />

            <div class="content">
                <h2>IoT</h2>

                <h3>
                    Conectamos ativos, processos e ambientes para gerar
                    inteligência operacional, previsibilidade e eficiência em
                    tempo real.
                </h3>
                <p>
                    Ajudamos empresas a enxergar em tempo real o que acontece na
                    operação, aplicando IoT para transformar sinais físicos em
                    inteligência operacional prática.
                    <br /><br />
                    Possibilitamos antecipar falhas, otimizar recursos, reduzir desperdícios
                    e tomar decisões mais rápidas, seguras e baseadas em dados reais.
                </p>

                <ButtonArrowSquare text="IoT para indústria" />
                <ButtonArrowSquare text="IoT para agricultura" />
            </div>
        </div>
    </div>
    <div class="comofazemos container-boxed">
        <div class="content">
            <Badge text="Como fazemos" />
            <h2>
                Entendemos os desafios do seu negócio e
                <b>cocriamos</b> soluções
            </h2>
            <h3>
                Nossa metodologia combina estratégia, tecnologia e execução ágil
                para garantir projetos tecnicamente sólidos, alinhados ao
                negócio e focados em resultados reais.
            </h3>
        </div>

        <div class="comofazemos-img-wrapper">
            <video
                src="/videos/esfera.webm"
                class="esferaImg"
                autoplay
                loop
                muted
                playsinline
                poster={EsferaImg.src}></video>
        </div>
    </div>
</Layout>
