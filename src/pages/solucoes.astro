---
import Layout from "../layouts/Layout.astro";
import SolucoesImg from "../images/solucoes/solucoes.webp";
import "../styles/pages/solucoes.css";
import { Icon } from "astro-icon/components";
---

<Layout>
    <div class="hero container-boxed">
        <div class="content">
            <h1>Nossas soluções</h1>
            <h3>
                Arquitetamos estratégia, conectamos dados e transformamos
                operações reais.
            </h3>
        </div>

        <div class="solucoes-img-wrapper">
            <video
                src="/videos/solucoes.webm"
                class="solucoesImg"
                autoplay
                loop
                muted
                playsinline
                poster={SolucoesImg.src}></video>
        </div>
    </div>
    <div class="marquee container">
        <div class="marquee-content">
            <h3>Transformação digital</h3>
            <Icon name="dot" />
            <h3>Indústria 4.0</h3>
            <Icon name="dot" />
            <h3>Engenharia</h3>
            <Icon name="dot" />
            <h3>Agricultura 4.0</h3>
            <Icon name="dot" />
            <h3>IoT</h3>
            <Icon name="dot" />
            <h3>Robótica</h3>
            <Icon name="dot" />
        </div>
        <div class="marquee-content" aria-hidden="true">
            <h3>Transformação digital</h3>
            <Icon name="dot" />
            <h3>Indústria 4.0</h3>
            <Icon name="dot" />
            <h3>Engenharia</h3>
            <Icon name="dot" />
            <h3>Agricultura 4.0</h3>
            <Icon name="dot" />
            <h3>IoT</h3>
            <Icon name="dot" />
            <h3>Robótica</h3>
            <Icon name="dot" />
        </div>
    </div>
</Layout>
