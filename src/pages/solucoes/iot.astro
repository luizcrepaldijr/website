        <div class="application-item">
            <div class="title">
                <Icon name="arrow-right-2" size={24} />
                <span>O produtor cuida da produção.</span>
            </div>
            <span class="texto">A Transformatech cuida da tecnologia.</span>
        </div>
    </div>
    </div><!-- close #panel-agri -->

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const section = document.querySelector(".lorawan-section");
            if (!section) return;

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            const labels =
                                entry.target.querySelectorAll(".lorawan-anim");
                            labels.forEach((label) => {
                                const delay =
                                    parseInt(
                                        (label as HTMLElement).dataset.delay ??
                                            "0"
                                    ) *
                                        600 +
                                    500;
                                setTimeout(() => {
                                    label.classList.add("visible");
                                }, delay);
                            });
                            observer.unobserve(entry.target);
                        }
                    });
                },
                { threshold: 0.25 }
            );

            observer.observe(section);
        });
    </script>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        let heroMm: gsap.MatchMedia | null = null;
        let scrollerMm: gsap.MatchMedia | null = null;
        let activePanel: "ind" | "agri" = "ind";
        let pendingRaf1: number | null = null;
        let pendingRaf2: number | null = null;

        function cancelPendingReinit() {
            if (pendingRaf1 !== null) { cancelAnimationFrame(pendingRaf1); pendingRaf1 = null; }
            if (pendingRaf2 !== null) { cancelAnimationFrame(pendingRaf2); pendingRaf2 = null; }
        }

        // ── Tab switching — only reinit panel scrollers, never touch hero ──
        document.querySelectorAll<HTMLButtonElement>(".iot-global-tabs button").forEach((btn) => {
            btn.addEventListener("click", () => {
                const panel = btn.dataset.panel as "ind" | "agri";
                if (panel === activePanel) return;
                activePanel = panel;

                document.querySelectorAll<HTMLButtonElement>(".iot-global-tabs button").forEach((b) => {
                    b.classList.toggle("active", b === btn);
                });

                // Kill scrollers synchronously so pin spacers are removed before layout recalculates
                cancelPendingReinit();
                if (scrollerMm) { scrollerMm.kill(); scrollerMm = null; }

                document.getElementById("panel-ind")!.style.display = panel === "ind" ? "block" : "none";
                document.getElementById("panel-agri")!.style.display = panel === "agri" ? "block" : "none";

                // scrollIntoView now sees the correct layout (spacers already gone)
                document.querySelector(".iot-global-tabs")!.scrollIntoView({ behavior: "instant" });

                // Re-register scrollers after layout settles
                pendingRaf1 = requestAnimationFrame(() => {
                    pendingRaf2 = requestAnimationFrame(() => {
                        pendingRaf1 = null;
                        pendingRaf2 = null;
                        reinitScrollers();
                    });
                });
            });
        });

        // ── Kill only panel scrollers, recreate for active panel ──
        function reinitScrollers() {
            if (scrollerMm) { scrollerMm.kill(); scrollerMm = null; }

            scrollerMm = gsap.matchMedia();
            scrollerMm.add("(min-width: 801px)", () => {
                _registerScrollers();
            });

            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    ScrollTrigger.refresh();
                });
            });
        }

        // ── Full init: hero (once) + scrollers ──
        function initAnimations() {
            if (heroMm) { heroMm.kill(); heroMm = null; }
            if (scrollerMm) { scrollerMm.kill(); scrollerMm = null; }
            ScrollTrigger.getAll().forEach((st) => st.kill());
            gsap.globalTimeline.clear();

            heroMm = gsap.matchMedia();

            heroMm.add("(min-width: 801px) and (max-width: 2399px)", () => {
                const tl = gsap.timeline({
                    scrollTrigger: {
                        trigger: ".iot-hero",
                        start: "top top",
                        end: "+=150%",
                        scrub: 1,
                        pin: true,
                    },
                });
                tl.to(".iot-hero .content", { opacity: 0, y: -100, duration: 1 })
                    .to(".arrow-down", { opacity: 0, duration: 0.2 }, "<")
                    .to(".iot-hero .iot-img-wrapper", { y: "20vh", x: "22vw", scale: 0.75, duration: 1 }, "<")
                    .fromTo(".iot-section-2", { opacity: 0, y: "55vh" }, { opacity: 1, y: "0vh", duration: 0.8 }, "-=0.8");
            });

            heroMm.add("(min-width: 2400px)", () => {
                const tl = gsap.timeline({
                    scrollTrigger: {
                        trigger: ".iot-hero",
                        start: "top top",
                        end: "+=150%",
                        scrub: 1,
                        pin: true,
                    },
                });
                tl.to(".iot-hero .content", { opacity: 0, y: -80, duration: 1 })
                    .to(".arrow-down", { opacity: 0, duration: 0.2 }, "<")
                    .to(".iot-hero .iot-img-wrapper", { y: "0vh", x: "12vw", scale: 0.85, duration: 1 }, "<")
                    .fromTo(".iot-section-2", { opacity: 0, y: "45vh" }, { opacity: 1, y: "0vh", duration: 0.8 }, "-=0.8");
            });

            heroMm.add("(max-width: 800px)", () => {
                const tlMobile = gsap.timeline({
                    scrollTrigger: {
                        trigger: ".iot-hero",
                        start: "top top",
                        end: "+=120%",
                        scrub: 1,
                        pin: true,
                    },
                });
                tlMobile
                    .to(".iot-hero .content", { opacity: 0, y: -50, duration: 1 })
                    .to(".arrow-down", { opacity: 0, duration: 0.2 }, "<")
                    .to(".iot-hero .iot-img-wrapper", { y: "-10vh", duration: 1 }, "<")
                    .fromTo(".iot-section-2", { opacity: 0, y: "10vh" }, { opacity: 1, y: "0vh", duration: 0.8 }, "-=0.8");
            });

            reinitScrollers();
        }

        function _registerScrollers() {
            if (activePanel === "ind") {
                // ── Clear residual GSAP styles from any previous run ──
                gsap.set(".media-1, .media-2, .text-1, .text-2, .text-3, .text-4", { clearProps: "all" });
                gsap.set(".wf-logo", { clearProps: "all" });
                for (let i = 0; i < 5; i++) {
                    gsap.set(
                        [`.wf-step-${i}`, `.wf-step-${i} .wf-line`, `.wf-step-${i} .wf-dot`,
                         `.wf-step-${i} h3`, `.wf-step-${i} .wf-desc`],
                        { clearProps: "all" }
                    );
                }

                // ── Indústrias animation ──
                gsap.set(".text-2, .text-3, .text-4, .media-2", { autoAlpha: 0 });

                const indTl = gsap.timeline({
                    scrollTrigger: {
                        trigger: ".iot-industrias-master-scrollarea",
                        start: "top top",
                        end: "+=300%",
                        scrub: 1,
                        pin: true,
                        anticipatePin: 1,
                    },
                });

                indTl
                    .to(".media-1", { xPercent: -100, duration: 1 })
                    .fromTo(".text-1", { autoAlpha: 1, x: 0 }, { autoAlpha: 0, x: -50, duration: 0.5 }, "<")
                    .fromTo(".text-2", { autoAlpha: 0, x: 50 }, { autoAlpha: 1, x: 0, duration: 0.5 }, "<0.5")
                    .to(".media-1", { autoAlpha: 0, duration: 0.5 })
                    .to(".text-2", { autoAlpha: 0, x: -50, duration: 0.5 }, "<")
                    .fromTo(".media-2", { autoAlpha: 0, xPercent: 0 }, { autoAlpha: 1, duration: 0.5 }, "<0.5")
                    .fromTo(".text-3", { autoAlpha: 0, x: 50 }, { autoAlpha: 1, x: 0, duration: 0.5 }, "<0.5")
                    .to(".media-2", { xPercent: -100, duration: 1 })
                    .to(".text-3", { autoAlpha: 0, x: -50, duration: 0.5 }, "<")
                    .fromTo(".text-4", { autoAlpha: 0, x: 50 }, { autoAlpha: 1, x: 0, duration: 0.5 }, "<0.5");

                // ── Workflow animation ──
                const WF_STEPS = 5;
                const WF_DUR   = 1;
                const WF_DEG   = 360 / WF_STEPS;

                gsap.set(".wf-step-0", { y: 0 });
                gsap.set(".wf-step-0 .wf-line", { autoAlpha: 1 });
                gsap.set(".wf-step-0 .wf-dot",  { opacity: 1 });
                gsap.set(".wf-step-0 h3",        { opacity: 1 });
                gsap.set(".wf-step-0 .wf-desc",  { autoAlpha: 1 });

                for (let i = 1; i < WF_STEPS; i++) {
                    const qY  = i * 78;
                    const vis = i <= 2;
                    const hOp = i === 1 ? 0.28 : 0.16;
                    gsap.set(`.wf-step-${i}`,         { y: qY, autoAlpha: vis ? 1 : 0 });
                    gsap.set(`.wf-step-${i} .wf-line`, { autoAlpha: 0 });
                    gsap.set(`.wf-step-${i} .wf-dot`,  { opacity: vis ? 0.35 : 0 });
                    gsap.set(`.wf-step-${i} h3`,       { opacity: vis ? hOp : 0 });
                    gsap.set(`.wf-step-${i} .wf-desc`, { autoAlpha: 0 });
                }

                const wfTl = gsap.timeline({
                    scrollTrigger: {
                        trigger: ".iot-workflow-scrollarea",
                        start: "top top",
                        end: `+=${(WF_STEPS - 1) * 100}%`,
                        scrub: 1,
                        pin: true,
                        anticipatePin: 1,
                    },
                });

                for (let i = 0; i < WF_STEPS - 1; i++) {
                    const t = i * WF_DUR;
                    wfTl.to(".wf-logo", { rotation: (i + 1) * WF_DEG, ease: "none", duration: WF_DUR }, t);
                    wfTl
                        .to(`.wf-step-${i} .wf-desc`, { autoAlpha: 0, duration: 0.2 }, t)
                        .to(`.wf-step-${i} .wf-line`,  { autoAlpha: 0, duration: 0.2 }, t)
                        .to(`.wf-step-${i} .wf-dot`,   { opacity: 0, duration: 0.2 }, t)
                        .to(`.wf-step-${i} h3`,        { opacity: 0, duration: 0.2 }, t)
                        .to(`.wf-step-${i}`,           { autoAlpha: 0, y: -55, duration: 0.35 }, t + 0.15);
                    wfTl
                        .to(`.wf-step-${i + 1}`,           { autoAlpha: 1, y: 0, duration: 0.4 }, t + 0.45)
                        .to(`.wf-step-${i + 1} .wf-line`,  { autoAlpha: 1, duration: 0.3 }, t + 0.6)
                        .to(`.wf-step-${i + 1} .wf-dot`,   { opacity: 1, duration: 0.3 }, t + 0.6)
                        .to(`.wf-step-${i + 1} h3`,        { opacity: 1, duration: 0.3 }, t + 0.6)
                        .to(`.wf-step-${i + 1} .wf-desc`,  { autoAlpha: 1, duration: 0.3 }, t + 0.7);
                    for (let j = i + 2; j < WF_STEPS; j++) {
                        const offset = j - (i + 1);
                        const vis    = offset <= 2;
                        const hOp   = offset === 1 ? 0.28 : 0.16;
                        const qY    = offset * 78;
                        wfTl
                            .to(`.wf-step-${j}`,         { autoAlpha: vis ? 1 : 0, y: qY, duration: 0.4 }, t + 0.45)
                            .to(`.wf-step-${j} .wf-dot`, { opacity: vis ? 0.35 : 0, duration: 0.3 }, t + 0.45)
                            .to(`.wf-step-${j} h3`,      { opacity: vis ? hOp : 0, duration: 0.3 }, t + 0.45);
                    }
                }
            }

            if (activePanel === "agri") {
                // ── Clear residual GSAP styles from any previous run ──
                gsap.set(
                    ".agri-media-1, .agri-media-2, .agri-text-1, .agri-text-2, .agri-text-3, .agri-text-4, .agri-text-5",
                    { clearProps: "all" }
                );

                // ── Agricultura animation ──
                gsap.set(".agri-text-2, .agri-text-3, .agri-text-4, .agri-text-5, .agri-media-2", { autoAlpha: 0 });

                const agriTl = gsap.timeline({
                    scrollTrigger: {
                        trigger: ".iot-agricultura-master-scrollarea",
                        start: "top top",
                        end: "+=400%",
                        scrub: 1,
                        pin: true,
                        anticipatePin: 1,
                    },
                });

                agriTl
                    .to(".agri-media-1", { xPercent: -100, duration: 1 })
                    .fromTo(".agri-text-1", { autoAlpha: 1, x: 0 }, { autoAlpha: 0, x: -50, duration: 0.5 }, "<")
                    .fromTo(".agri-text-2", { autoAlpha: 0, x: 50 }, { autoAlpha: 1, x: 0, duration: 0.5 }, "<0.5")
                    .to(".agri-media-1", { autoAlpha: 0, duration: 0.5 })
                    .to(".agri-text-2", { autoAlpha: 0, x: -50, duration: 0.5 }, "<")
                    .fromTo(".agri-media-2", { autoAlpha: 0, xPercent: 0 }, { autoAlpha: 1, duration: 0.5 }, "<0.5")
                    .fromTo(".agri-text-3", { autoAlpha: 0, x: 50 }, { autoAlpha: 1, x: 0, duration: 0.5 }, "<0.5")
                    .to(".agri-media-2", { xPercent: -100, duration: 1 })
                    .to(".agri-text-3", { autoAlpha: 0, x: -50, duration: 0.5 }, "<")
                    .fromTo(".agri-text-4", { autoAlpha: 0, x: 50 }, { autoAlpha: 1, x: 0, duration: 0.5 }, "<0.5")
                    .to(".agri-text-4", { autoAlpha: 0, y: -30, duration: 0.5 })
                    .to(".agri-media-2", { xPercent: -50, left: "50%", scale: 1.2, duration: 1 }, "<")
                    .fromTo(".agri-text-5", { autoAlpha: 0, y: 100 }, { autoAlpha: 1, y: 0, duration: 0.8 }, "-=0.5")
                    .to(".agri-media-2", { autoAlpha: 0, duration: 0.5 }, "+=0.3")
                    .to(".agri-text-5", { autoAlpha: 0, duration: 0.5 }, "<");
            }
        }

        // Roda na primeira carga E em cada navegação via View Transitions
        document.addEventListener("DOMContentLoaded", initAnimations);
    </script>
</Layout>
