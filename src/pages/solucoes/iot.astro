            <span class="texto"
                >Sensores, gateways, painéis solares e antenas.</span
            >
        </div>
        <div class="application-item">
            <div class="title">
                <Icon name="arrow-right-2" size={24} />
                <span>Monitoramento remoto dos sensores</span>
            </div>
            <span class="texto"
                >Bateria, comunicação, conectividade e qualidade dos dados.</span
            >
        </div>
        <div class="application-item">
            <div class="title">
                <Icon name="arrow-right-2" size={24} />
                <span>Manutenção contínua</span>
