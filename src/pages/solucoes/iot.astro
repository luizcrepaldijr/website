---
import Layout from "../../layouts/Layout.astro";
import "../../styles/pages/iot.css";
import IotHeroFallback from "../../images/iot/iot-hero.webp";
import LorawanFallback from "../../images/iot/lorawan.webp";
import IotParaIndustriaFallback from "../../images/iot/iot-para-industria.webp";
import IotParaIndustria2Fallback from "../../images/iot/iot-para-industria-2.webp";
import SensorAgroFallback from "../../images/iot/sensor-agro.webp";
import IotParaAgriculturaFallback from "../../images/iot/iot-para-agricultura.webp";
import ButtonArrowAnimation from "../../components/buttons/ButtonArrowAnimation.astro";
import ButtonArrowWhite from "../../components/buttons/ButtonArrowWhite.astro";
import Badge from "../../components/Badge.astro";
import { Icon } from "astro-icon/components";
import LogoBigFallback from "../../images/logo-big.webp";
import Accordion from "../../components/Accordion.astro";
import CarousselWorkflow from "../../components/carroussel/CarousselWorkflow.astro";

const wfSteps = [
    { title: "Diagnóstico técnico da operação",   desc: "Entendimento profundo de processos, máquinas e desafios reais." },
    { title: "Estratégia de sensoriamento",       desc: "Definição de sensores, pontos de medição e arquitetura ideal." },
    { title: "Arquitetura de dados",              desc: "Gateways, redes LoRaWAN, dashboards, APIs e integrações." },
    { title: "Instalação e comissionamento",      desc: "Execução em campo, testes e validação de desempenho." },
    { title: "Suporte e evolução contínua",       desc: "Monitoramento, ajustes, manutenção e expansão conforme a operação cresce." },
];
---

<Layout title="IoT">
    <div class="iot-hero container-boxed">
        <div class="content">
            <h1>
                <b>IoT:</b> transformando dados em decisões reais
            </h1>
            <h3>
                Conectamos ativos, processos e ambientes físicos para gerar
                inteligência operacional, previsibilidade e eficiência em tempo
                real.
            </h3>

            <ButtonArrowAnimation text="Preciso desse serviço" />
        </div>

        <div class="iot-img-wrapper">
            <video
                src="/videos/iot/iot-hero.webm"
                class="iotImg"
                autoplay
                loop
                muted
                playsinline
                poster={IotHeroFallback.src}></video>
        </div>
        <Icon name="arrow-down" class="arrow-down" />
    </div>

    <div class="iot-section-2 container-boxed">
        <div class="content">
            <h2>
                A indústria exige cada vez mais controle, previsibilidade e
                eficiência.
            </h2>
            <h3>
                O IoT (Internet of Things) permite transformar processos
                produtivos em ambientes inteligentes, capazes de capturar dados
                continuamente e gerar insights imediatos para a tomada de
                decisão.
            </h3>
            <p><b>Com IoT é possível:</b></p>
        </div>

        <div class="iot-checklist">
            <div class="iot-checklist-item">
                <Icon name="check" size={24} />
                <span>Monitoramento contínuo de variáveis críticas</span>
            </div>
            <div class="iot-checklist-item">
                <Icon name="check" size={24} />
                <span>Detecção precoce de falhas e anomalias</span>
            </div>
            <div class="iot-checklist-item">
                <Icon name="check" size={24} />
                <span>Maior confiabilidade e previsibilidade de processos</span>
            </div>
            <div class="iot-checklist-item">
                <Icon name="check" size={24} />
                <span>Redução de desperdícios e custos operacionais</span>
            </div>
        </div>
    </div>

    <div class="lorawan-section container-boxed">
        <div class="lorawan-header">
            <Badge text="Tecnologia" />
            <h2>
                Utilizamos tecnologia <b>LoRaWAN</b><br />
                <span>como base para nossas soluções de IoT</span>
            </h2>
        </div>

        <div class="lorawan-visual">
            <div
                class="lorawan-label lorawan-label-1 lorawan-anim"
                data-delay="0"
            >
                <div class="lbl-text">
                    Longo alcance e<br />escalabilidade em<br />áreas extensas
                </div>
                <svg
                    class="lbl-line line-1"
                    viewBox="0 0 100 100"
                    preserveAspectRatio="none"
                >
                    <line
                        x1="0"
                        y1="0"
                        x2="100"
                        y2="100"
                        stroke="rgba(255,255,255,0.4)"
                        stroke-width="1"
                        stroke-dasharray="4 4"></line>
                </svg>
            </div>

            <div
                class="lorawan-label lorawan-label-2 lorawan-anim"
                data-delay="1"
            >
                <div class="lbl-text">
                    Baixo consumo de<br />energia e vida útil<br />elevada
                </div>
                <svg
                    class="lbl-line line-2"
                    viewBox="0 0 2 100"
                    preserveAspectRatio="none"
                >
                    <line
                        x1="1"
                        y1="0"
                        x2="1"
                        y2="100"
                        stroke="rgba(255,255,255,0.4)"
                        stroke-width="1"
                        stroke-dasharray="4 4"></line>
                </svg>
            </div>

            <div class="lorawan-video-wrapper">
                <video
                    src="/videos/iot/lorawan.webm"
                    class="lorawan-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={LorawanFallback.src}></video>
            </div>

            <div
                class="lorawan-label lorawan-label-3 lorawan-anim"
                data-delay="2"
            >
                <div class="lbl-text">
                    Redução drástica de<br />cabeamento e custos<br />de
                    instalação
                </div>
                <svg
                    class="lbl-line line-3"
                    viewBox="0 0 2 100"
                    preserveAspectRatio="none"
                >
                    <line
                        x1="1"
                        y1="0"
                        x2="1"
                        y2="100"
                        stroke="rgba(255,255,255,0.4)"
                        stroke-width="1"
                        stroke-dasharray="4 4"></line>
                </svg>
            </div>

            <div
                class="lorawan-label lorawan-label-4 lorawan-anim"
                data-delay="3"
            >
                <div class="lbl-text">
                    Alta confiabilidade até<br />em ambientes com<br
                    />interferências
                </div>
                <svg
                    class="lbl-line line-4"
                    viewBox="0 0 100 100"
                    preserveAspectRatio="none"
                >
                    <line
                        x1="100"
                        y1="0"
                        x2="0"
                        y2="100"
                        stroke="rgba(255,255,255,0.4)"
                        stroke-width="1"
                        stroke-dasharray="4 4"></line>
                </svg>
            </div>
        </div>

        <p class="lorawan-footer">
            Criamos soluções completas de IoT que integram sensores,
            conectividade, plataformas analíticas e suporte contínuo,
            transformando dados brutos em insights acionáveis
        </p>
    </div>

    <!-- ── GLOBAL TABS ── -->
    <div class="iot-global-tabs">
        <button class="active" data-panel="ind">IoT para indústrias</button>
        <button data-panel="agri">IoT para agricultura</button>
    </div>

    <!-- ── PANEL: INDÚSTRIAS ── -->
    <div class="iot-panel" id="panel-ind">

    <div class="iot-industrias-master-scrollarea">
        <div class="iot-ind-pinned-master">
            <div class="iot-ind-pinned-content">
                <!-- Media -->
                <div class="iot-ind-medias">
                    <div class="iot-ind-media media-1">
                        <video
                            src="/videos/iot/iot-para-industria.webm"
                            autoplay
                            loop
                            muted
                            playsinline
                            poster={IotParaIndustriaFallback.src}></video>
                    </div>
                    <!-- Second media uses same video as requested -->
                    <div class="iot-ind-media media-2">
                        <video
                            src="/videos/iot/iot-para-industria-2.webm"
                            autoplay
                            loop
                            muted
                            playsinline
                            poster={IotParaIndustria2Fallback.src}></video>
                    </div>
                </div>

                <!-- Texts -->
                <div class="iot-ind-texts">
                    <div class="iot-ind-text text-1">
                        <h2>IoT para indústrias</h2>
                        <p>
                            Permite observar a operação de forma contínua,
                            capturando dados críticos diretamente do chão de
                            fábrica.
                        </p>
                    </div>

                    <div class="iot-ind-text text-2">
                        <h2>
                            A indústria moderna exige processos conectados,
                            previsíveis e eficientes.
                        </h2>
                        <p>
                            O IoT industrial permite observar a operação de
                            forma contínua, capturando dados críticos
                            diretamente do chão de fábrica.
                        </p>
                    </div>

                    <div class="iot-ind-text text-3">
                        <h2>O que monitoramos</h2>
                        <p>Nossas principais aplicações na indústria:</p>
                        <div class="card-checklist">
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Coleta automática de dados de processo</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Análise de vibração em motores e
                                    equipamentos críticos</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Monitoramento de linhas de embalagem para
                                    cálculo de eficiência (OEE)</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Integração de dados em plataformas
                                    analíticas e sistemas internos</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Comunicação sem fio confiável via LoRaWAN</span
                                >
                            </div>
                        </div>
                    </div>

                    <div class="iot-ind-text text-4">
                        <h2>Resultados obtidos com IoT Industrial</h2>
                        <p>Esses dados alimentam uma plataforma que entrega:</p>
                        <div class="card-checklist">
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Redução de falhas e paradas inesperadas</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Melhoria significativa do OEE</span>
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Aumento da vida útil de ativos críticos</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Mais controle, rastreabilidade e facilidade
                                    de auditoria</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Decisões baseadas em dados confiáveis e em
                                    tempo real</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── IOT INDÚSTRIAS MOBILE ── -->
    <div class="iot-ind-mobile">
        <!-- Block 1 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-industria.webm"
                class="iot-ind-mobile-video"
                autoplay loop muted playsinline
                poster={IotParaIndustriaFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>IoT para indústrias</h2>
                <p>Permite observar a operação de forma contínua, capturando dados críticos diretamente do chão de fábrica.</p>
            </div>
        </div>

        <!-- Block 2 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-industria.webm"
                class="iot-ind-mobile-video"
                autoplay loop muted playsinline
                poster={IotParaIndustriaFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>A indústria moderna exige processos conectados, previsíveis e eficientes.</h2>
                <p>O IoT industrial permite observar a operação de forma contínua, capturando dados críticos diretamente do chão de fábrica.</p>
            </div>
        </div>

        <!-- Block 3 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-industria-2.webm"
                class="iot-ind-mobile-video"
                autoplay loop muted playsinline
                poster={IotParaIndustria2Fallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>O que monitoramos</h2>
                <p>Nossas principais aplicações na indústria:</p>
                <div class="card-checklist">
                    <div><Icon name="arrow-right-2" size={24} /><span>Coleta automática de dados de processo</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Análise de vibração em motores e equipamentos críticos</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Monitoramento de linhas de embalagem para cálculo de eficiência (OEE)</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Integração de dados em plataformas analíticas e sistemas internos</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Comunicação sem fio confiável via LoRaWAN</span></div>
                </div>
            </div>
        </div>

        <!-- Block 4 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-industria-2.webm"
                class="iot-ind-mobile-video"
                autoplay loop muted playsinline
                poster={IotParaIndustria2Fallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>Resultados obtidos com IoT Industrial</h2>
                <p>Esses dados alimentam uma plataforma que entrega:</p>
                <div class="card-checklist">
                    <div><Icon name="arrow-right-2" size={24} /><span>Redução de falhas e paradas inesperadas</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Melhoria significativa do OEE</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Aumento da vida útil de ativos críticos</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Mais controle, rastreabilidade e facilidade de auditoria</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Decisões baseadas em dados confiáveis e em tempo real</span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── IOT WORKFLOW ── -->
    <div class="iot-workflow-scrollarea">
        <div class="iot-workflow-pinned">
            <!-- Decorative rings -->
            <div class="wf-ring wf-ring-1"></div>
            <div class="wf-ring wf-ring-2"></div>

            <!-- Rotating logo -->
            <div class="wf-logo-wrapper">
                <img src={LogoBigFallback.src} class="wf-logo" alt="" />
            </div>

            <!-- Right content (desktop) -->
            <div class="wf-content">
                <div class="wf-header">
                    <h2>Como entregamos IoT na Indústria</h2>
                    <span class="wf-subtitle">Nosso workflow</span>
                </div>

                <div class="wf-steps-area">
                    {wfSteps.map((step, i) => (
                        <div class={`wf-step wf-step-${i}`}>
                            <div class="wf-line"></div>
                            <span class="wf-dot"><Icon name="dot" size={8} /></span>
                            <h3>{step.title}</h3>
                            <p class="wf-desc">{step.desc}</p>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Mobile carousel -->
            <div class="wf-mobile-carousel">
                <div class="wf-mobile-header">
                    <h2>Como entregamos IoT na Indústria</h2>
                    <span class="wf-subtitle">NOSSO WORKFLOW</span>
                </div>
                <CarousselWorkflow steps={wfSteps} logoSrc={LogoBigFallback.src} />
            </div>
        </div>
    </div><!-- close iot-workflow-scrollarea -->

    <div class="iot-controle container">
        <div class="container-boxed">
            <div class="content">
                <h2>Pronto para operar com <b>controle em tempo real?</b></h2>
                <h3>
                    Traga os desafios da sua indústria ou do seu campo. Nós
                    ajudamos a transformar dados em controle, eficiência e
                    previsibilidade.
                </h3>
                <span class="button">
                    <ButtonArrowWhite text="Levar IoT para o meu negócio" />
                </span>
            </div>
            <div class="parceiros-img-wrapper">
                <video
                    src="/videos/iot/iot-hero.webm"
                    class="parceiros-img"
                    autoplay
                    loop
                    muted
                    playsinline></video>
            </div>
        </div>
    </div>
    </div><!-- close #panel-ind -->

    <!-- ── PANEL: AGRICULTURA ── -->
    <div class="iot-panel" id="panel-agri">

    <!-- ── IOT AGRICULTURA ── -->
    <div class="iot-agricultura-master-scrollarea">
        <div class="iot-agri-pinned-master">
            <div class="iot-agri-pinned-content">
                <!-- Media -->
                <div class="iot-agri-medias">
                    <div class="iot-agri-media agri-media-1">
                        <video
                            src="/videos/iot/sensor-agro.webm"
                            autoplay
                            loop
                            muted
                            playsinline
                            poster={SensorAgroFallback.src}></video>
                    </div>
                    <div class="iot-agri-media agri-media-2">
                        <video
                            src="/videos/iot/iot-para-agricultura.webm"
                            autoplay
                            loop
                            muted
                            playsinline
                            poster={IotParaAgriculturaFallback.src}></video>
                    </div>
                </div>

                <!-- Texts -->
                <div class="iot-agri-texts">
                    <div class="iot-agri-text agri-text-1">
                        <h2>IoT para agricultura</h2>
                        <p>
                            Eficiência hídrica, produtividade e decisões
                            inteligentes no campo
                        </p>
                    </div>

                    <div class="iot-agri-text agri-text-2">
                        <h2>
                            O agronegócio enfrenta o desafio de produzir mais,
                            com menos recursos e maior sustentabilidade.
                        </h2>
                        <p>
                            O IoT permite ao produtor entender o solo em tempo
                            real e tomar decisões precisas, reduzindo
                            desperdícios e aumentando produtividade.
                        </p>
                    </div>

                    <div class="iot-agri-text agri-text-3">
                        <h2>O que monitoramos</h2>
                        <p>Sensores distribuídos estrategicamente capturam:</p>
                        <div class="card-checklist">
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Umidade do solo em diferentes profundidades</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Temperatura do solo e do ambiente</span>
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Condutividade elétrica (fertilidade e
                                    salinidade)</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Condições que impactam diretamente a
                                    irrigação</span
                                >
                            </div>
                        </div>
                    </div>

                    <div class="iot-agri-text agri-text-4">
                        <h2>O que entregamos</h2>
                        <p>Esses dados alimentam uma plataforma que entrega:</p>
                        <div class="card-checklist">
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Indicadores em tempo real</span>
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Recomendações objetivas de irrigação</span
                                >
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Cálculo automático da água aplicada</span>
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span>Conversão do consumo em USD</span>
                            </div>
                            <div>
                                <Icon name="arrow-right-2" size={24} />
                                <span
                                    >Alertas sobre necessidades imediatas do
                                    solo</span
                                >
                            </div>
                        </div>
                    </div>

                    <div class="iot-agri-text agri-text-5">
                        <h2>Oferecemos suporte no campo e à distância</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── IOT AGRICULTURA MOBILE ── -->
    <div class="iot-agri-mobile">
        <!-- Block 1 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/sensor-agro.webm"
                class="iot-ind-mobile-video"
                autoplay loop muted playsinline
                poster={SensorAgroFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>IoT para agricultura</h2>
                <p>Eficiência hídrica, produtividade e decisões inteligentes no campo</p>
            </div>
        </div>

        <!-- Block 2 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/sensor-agro.webm"
                class="iot-ind-mobile-video"
                autoplay loop muted playsinline
                poster={SensorAgroFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>O agronegócio enfrenta o desafio de produzir mais, com menos recursos e maior sustentabilidade.</h2>
                <p>O IoT permite ao produtor entender o solo em tempo real e tomar decisões precisas, reduzindo desperdícios e aumentando produtividade.</p>
            </div>
        </div>

        <!-- Block 3 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-agricultura.webm"
                class="iot-ind-mobile-video"
                autoplay loop muted playsinline
                poster={IotParaAgriculturaFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>O que monitoramos</h2>
                <p>Sensores distribuídos estrategicamente capturam:</p>
                <div class="card-checklist">
                    <div><Icon name="arrow-right-2" size={24} /><span>Umidade do solo em diferentes profundidades</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Temperatura do solo e do ambiente</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Condutividade elétrica (fertilidade e salinidade)</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Condições que impactam diretamente a irrigação</span></div>
                </div>
            </div>
        </div>

        <!-- Block 4 -->
        <div class="iot-ind-mobile-block">
            <video
                src="/videos/iot/iot-para-agricultura.webm"
                class="iot-ind-mobile-video"
                autoplay loop muted playsinline
                poster={IotParaAgriculturaFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>O que entregamos</h2>
                <p>Esses dados alimentam uma plataforma que entrega:</p>
                <div class="card-checklist">
                    <div><Icon name="arrow-right-2" size={24} /><span>Indicadores em tempo real</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Recomendações objetivas de irrigação</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Cálculo automático da água aplicada</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Conversão do consumo em USD</span></div>
                    <div><Icon name="arrow-right-2" size={24} /><span>Alertas sobre necessidades imediatas do solo</span></div>
                </div>
