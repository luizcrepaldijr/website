                autoplay loop muted playsinline
                poster={IotParaAgriculturaFallback.src}></video>
            <div class="iot-ind-mobile-text">
                <h2>Oferecemos suporte no campo e à distância</h2>
                <div class="iot-agri-mobile-accordion">
                    <Accordion title="Instalação completa" description="Sensores, gateways, painéis solares e antenas." />
                    <Accordion title="Monitoramento remoto dos sensores" description="Bateria, comunicação, conectividade e qualidade dos dados." />
                    <Accordion title="Manutenção contínua" description="Ajustes, substituições e expansão da solução conforme a fazenda cresce." />
                    <Accordion title="O produtor cuida da produção." description="A Transformatech cuida da tecnologia." />
                </div>
            </div>
        </div>
    </div>

    <div class="iot-agri-applications">
        <div class="application-item">
            <div class="title">
                <Icon name="arrow-right-2" size={24} />
                <span>Instalação completa</span>
