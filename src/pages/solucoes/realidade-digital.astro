---
import ButtonArrowAnimation from "../../components/buttons/ButtonArrowAnimation.astro";
import ButtonArrowWhite from "../../components/buttons/ButtonArrowWhite.astro";
import Layout from "../../layouts/Layout.astro";
import "../../styles/pages/realidade-digital.css";
import CuboImg from "../../images/home/hero/cubo.webp";
import VideoThumb from "../../images/realidade-digital/video-thumb.webp";
import MagicBox from "../../images/realidade-digital/magic-box.webp";
import MetaQuest from "../../images/realidade-digital/meta-quest.webp";
import VRImg from "../../images/realidade-digital/realidade-virtual.webp";
import ARImg from "../../images/realidade-digital/realidade-aumentada.webp";
import MRImg from "../../images/realidade-digital/realidade-mista.webp";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
---

<Layout title="Realidade Digital">
    <div class="hero container-boxed">
        <div class="content">
            <h1>
                <b>Realidade Digital:</b> a nova forma de treinar e evoluir a indústria
            </h1>
            <h3>
                Treinamento, suporte e execução operacional com realidade
                virtual, aumentada e mista, integrados ao ambiente real da
                indústria.
            </h3>

            <ButtonArrowAnimation text="Preciso desse serviço" />
        </div>

        <div class="cubo-img-wrapper">
            <video
                src="/videos/cubo-hero.webm"
                class="cuboImg"
                autoplay
                loop
                muted
                playsinline
                poster={CuboImg.src}></video>
        </div>
    </div>

    <div class="ambientes-virtuais container-boxed">
        <div class="content">
            <h2>
                Combinamos ambientes virtuais imersivos para treinar equipes com
                mais segurança e eficiência.
            </h2>
            <h3>
                Criamos simulações realistas de máquinas, processos e cenários
                operacionais, permitindo que equipes pratiquem procedimentos
                quantas vezes for necessário e ganhem confiança antes da
                execução real.
            </h3>
        </div>

        <div class="youtube-wrapper" id="video-container">
            <div id="video-placeholder" class="video-placeholder">
                <img
                    src={VideoThumb.src}
                    alt="Thumbnail do vídeo"
                    class="video-thumb-custom"
                />
                <button class="play-button" aria-label="Play Video">
                    <span class="play-icon"></span>
                </button>
            </div>
        </div>
    </div>

    <div class="realidade-digital-section container-boxed">
        <div class="rd-top-row">
            <div class="rd-content">
                <div class="rd-badge">
                    <span>Tecnologia</span>
                    <Image
                        src={MagicBox}
                        alt="Magic Box"
                        class="rd-badge-img"
                    />
                </div>

                <h2>
                    O time visualiza em realidade virtual como cada atividade
                    deve ser executada diretamente sobre o equipamento real.
                </h2>
                <h3>
                    O colaborador recebe orientações passo a passo no próprio
                    contexto de trabalho, tornando o aprendizado mais intuitivo,
                    imersivo e prático.
                </h3>
                <p><b>Com Realidade Digital é possível:</b></p>
            </div>

            <div class="rd-video-wrapper">
                <video
                    src="/videos/realidade-digital/oculos.webm"
                    class="rd-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={MetaQuest.src}></video>
                <div class="rd-meta-quest-label">
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm-1.5 14.5c-1.381 0-2.5-1.567-2.5-3.5s1.119-3.5 2.5-3.5c.692 0 1.317.39 1.775 1.013L12 11.5l.225-.987C12.683 9.89 13.308 9.5 14 9.5c1.381 0 2.5 1.567 2.5 3.5s-1.119 3.5-2.5 3.5c-.692 0-1.317-.39-1.775-1.013L12 14.5l-.225.987c-.458.623-1.083 1.013-1.775 1.013z"
                            fill="white"></path>
                    </svg>
                    <span>Meta Quest 3</span>
                </div>
            </div>
        </div>

        <div class="rd-checklist">
            <div class="rd-checklist-item">
                <Icon name="check" size={24} />
                <span>Visualização clara de como executar cada tarefa</span>
            </div>
            <div class="rd-checklist-item">
                <Icon name="check" size={24} />
                <span>Aprendizado prático durante a execução</span>
            </div>
            <div class="rd-checklist-item">
                <Icon name="check" size={24} />
                <span>Execução correta e padronizada</span>
            </div>
            <div class="rd-checklist-item">
                <Icon name="check" size={24} />
                <span>Mais segurança no ambiente operacional</span>
            </div>
        </div>
    </div>

    <div class="rd-abordagem-integrada container-boxed">
        <div class="rd-abordagem-header">
            <h2>Utilizamos uma abordagem integrada de Realidade Digital</h2>
            <h3>
                Integramos tecnologias de Realidade Digital para acompanhar toda
                a jornada de aprendizado até a execução operacional.
            </h3>
        </div>

        <div class="rd-cards-grid">
            <div class="rd-card">
                <video
                    src="/videos/realidade-digital/realidade-virtual.webm"
                    class="rd-card-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={VRImg.src}></video>
                <div class="rd-card-overlay"></div>
                <div class="rd-card-bottom">
                    <h4>Realidade Virtual (VR)</h4>
                    <p>
                        Simulações digitais permitem praticar procedimentos e
                        fluxos de trabalho em ambientes controlados, preparando
                        equipes antes da execução real, sem riscos e sem impacto
                        na operação.
                    </p>
                </div>
            </div>
            <div class="rd-card">
                <video
                    src="/videos/realidade-digital/realidade-aumentada.webm"
                    class="rd-card-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={ARImg.src}></video>
                <div class="rd-card-overlay"></div>
                <div class="rd-card-bottom">
                    <h4>Realidade Aumentada (AR)</h4>
                    <p>
                        Informações e instruções digitais aparecem diretamente
                        sobre o ambiente físico, orientando a execução das
                        atividades no momento em que elas acontecem.
                    </p>
                </div>
            </div>
            <div class="rd-card">
                <Image src={MRImg} alt="Realidade Mista" class="rd-card-img" />
                <div class="rd-card-overlay"></div>
                <div class="rd-card-bottom">
                    <h4>Realidade Mista</h4>
                    <p>
                        Elementos digitais interagem com o ambiente real,
                        combinando visualização, dados e contexto para apoiar
                        decisões e a execução de tarefas mais complexas.
                    </p>
                </div>
            </div>
        </div>

        <div class="rd-btn-container">
            <ButtonArrowAnimation text="Preciso desse serviço" />
        </div>
    </div>

    <div class="rd-operacao-industrial container-boxed">
        <div class="rd-op-header">
            <h2>Realidade Digital aplicada à operação industrial</h2>
        </div>

        <div class="rd-op-cards-container">
            <div class="rd-op-card">
                <div class="rd-op-card-content">
                    <h3>Segurança</h3>
                    <p>
                        Treinamento seguro em ambientes simulados, permitindo
                        que equipes pratiquem procedimentos críticos antes de
                        atuar no chão de fábrica.
                    </p>
                </div>
                <div class="rd-op-card-img-wrapper">
                    <video
                        src="/videos/realidade-digital/segurança-vr.webm"
                        class="rd-op-card-img"
                        autoplay
                        loop
                        muted
                        playsinline></video>
                </div>
            </div>

            <div class="rd-op-card">
                <div class="rd-op-card-content">
                    <h3>Changeover</h3>
                    <p>
                        Trocas de setup mais rápidas e padronizadas, com
                        orientação digital que reduz erros e tempo de parada.
                    </p>
                </div>
                <div class="rd-op-card-img-wrapper">
                    <video
                        src="/videos/realidade-digital/changeover.webm"
                        class="rd-op-card-img"
                        autoplay
                        loop
                        muted
                        playsinline></video>
                </div>
            </div>

            <div class="rd-op-card">
                <div class="rd-op-card-content">
                    <h3>Manutenção</h3>
                    <p>
                        Manutenção guiada por instruções visuais interativas,
                        combinando informações digitais e o contexto real para
                        execução precisa.
                    </p>
                </div>
                <div class="rd-op-card-img-wrapper">
                    <video
                        src="/videos/realidade-digital/manutenção.webm"
                        class="rd-op-card-img"
                        autoplay
                        loop
                        muted
                        playsinline></video>
                </div>
            </div>

            <div class="rd-op-card">
                <div class="rd-op-card-content">
                    <h3>Suporte Remoto</h3>
                    <p>
                        Suporte remoto em tempo real visualizando o especialista
                        local para resolver problemas com mais agilidade.
                    </p>
                </div>
                <div class="rd-op-card-img-wrapper">
                    <video
                        src="/videos/realidade-digital/suporte-remoto.webm"
                        class="rd-op-card-img"
                        autoplay
                        loop
                        muted
                        playsinline></video>
                </div>
            </div>
        </div>
    </div>

    <div class="rd-pronto-transformar container-boxed">
        <div class="content">
            <h2>
                Pronto para transformar a forma como sua equipe aprende e
                executa?
            </h2>
            <h3>
                Traga os desafios da sua operação. Nós ajudamos a transformar
                capacitação técnica em performance real no dia a dia.
            </h3>
            <span class="button">
                <ButtonArrowWhite
                    text="Levar realidade digital para o meu negócio"
                />
            </span>
        </div>

        <div class="cubo-img-wrapper">
            <video
                src="/videos/cubo-hero.webm"
                class="cuboImg"
                autoplay
                loop
                muted
                playsinline
                poster={CuboImg.src}></video>
        </div>
    </div>
</Layout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        let mm = gsap.matchMedia();

        mm.add("(min-width: 801px)", () => {
            const cards = gsap.utils.toArray(".rd-op-card") as HTMLElement[];

            cards.forEach((card, index) => {
                // Determine scale based on position (cards stacked below get smaller as more stack on top)
                // We use ScrollTrigger to animate the scale down slightly when the next card touches it
                if (index < cards.length - 1) {
                    gsap.to(card, {
                        scale: 1 - 0.05 * (cards.length - 1 - index), // The lowest gets scaled down the most initially relative
                        ease: "none",
                        scrollTrigger: {
                            trigger: cards[index + 1],
                            start: `top bottom-=200`, // Start changing when the next card is scrolling into view
                            end: `top top+=${100 + (index + 1) * 30}`, // End when the next card locks
                            scrub: true,
                            invalidateOnRefresh: true,
                        },
                    });
                }
            });
        });

        mm.add("(min-width: 801px) and (max-width: 2399px)", () => {
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: ".hero",
                    start: "top top",
                    end: "+=150%",
                    scrub: 1,
                    pin: true,
                },
            });

            tl.to(".hero .content", { opacity: 0, y: -100, duration: 1 })
                .to(".arrow-down", { opacity: 0, duration: 0.2 }, "<")
                .to(
                    ".hero .cubo-img-wrapper",
                    { y: "10vh", x: "12vw", scale: 0.8, duration: 1 },
                    "<"
                )
                .fromTo(
                    ".ambientes-virtuais",
                    { opacity: 0, marginTop: "5vh" },
                    { opacity: 1, marginTop: "-50vh", duration: 0.8 },
                    "-=0.8"
                );
        });

        mm.add("(min-width: 2400px)", () => {
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: ".hero",
                    start: "top top",
                    end: "+=150%",
                    scrub: 1,
                    pin: true,
                },
            });

            tl.to(".hero .content", { opacity: 0, y: -80, duration: 1 })
                .to(".arrow-down", { opacity: 0, duration: 0.2 }, "<")
                .to(
                    ".hero .cubo-img-wrapper",
                    { y: "0vh", x: 350, scale: 0.7, duration: 1 },
                    "<"
                )
                .fromTo(
                    ".ambientes-virtuais",
                    { opacity: 0, marginTop: "5vh" },
                    { opacity: 1, marginTop: "-40vh", duration: 0.8 },
                    "-=0.8"
                );
        });

        mm.add("(max-width: 800px)", () => {
            const tlMobile = gsap.timeline({
                scrollTrigger: {
                    trigger: ".hero",
                    start: "top top",
                    end: "+=120%",
                    scrub: 1,
                    pin: true,
                },
            });

            tlMobile
                .to(".hero .content", { opacity: 0, y: -50, duration: 1 })
                .to(".arrow-down", { opacity: 0, duration: 0.2 }, "<")
                .to(".hero .cubo-img-wrapper", { y: "-10vh", duration: 1 }, "<")
                .fromTo(
                    ".ambientes-virtuais",
                    { opacity: 0, marginTop: "5vh" },
                    { opacity: 1, marginTop: "-20vh", duration: 0.8 },
                    "-=0.8"
                );
        });
    });

    const container = document.getElementById("video-container");
    const placeholder = document.getElementById("video-placeholder");

    placeholder?.addEventListener("click", () => {
        if (container) {
            container.innerHTML = `
                <iframe
                    width="100%"
                    height="100%"
                    src="https://www.youtube.com/embed/ScMzIvxBSi4?autoplay=1"
                    title="YouTube video player"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen>
                </iframe>
            `;
        }
    });
</script>
