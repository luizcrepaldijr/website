---
import Layout from "../../layouts/Layout.astro";
import "../../styles/pages/robotica.css";
import RoboticaHeroFallback from "../../images/robotica/robotica-hero.webp";
import ButtonArrowAnimation from "../../components/buttons/ButtonArrowAnimation.astro";
import ButtonArrowWhite from "../../components/buttons/ButtonArrowWhite.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Badge from "../../components/Badge.astro";
import IntegracaoTotalImg from "../../images/robotica/integracao-total.webp";
import RoboticaConectadaImg from "../../images/robotica/robotica-conectada-a-dados.webp";
import ManutencaoPreditivaImg from "../../images/robotica/manutencao-preditiva.webp";
---

<Layout title="Robótica">
    <div class="hero container-boxed">
        <div class="content">
            <h1>
                <b>Robótica:</b> automação industrial em um novo patamar
            </h1>
            <h3>
                Concepção à integração de sistemas robóticos em ambientes
                industriais para elevar produtividade, segurança e eficiência
                operacional.
            </h3>

            <ButtonArrowAnimation text="Preciso desse serviço" />
        </div>

        <div class="robotica-img-wrapper">
            <video
                src="/videos/robotica/robotica-hero.webm"
                class="roboticaImg"
                autoplay
                loop
                muted
                playsinline
                poster={RoboticaHeroFallback.src}></video>
        </div>
        <Icon name="arrow-down" class="arrow-down" />
    </div>

    <div class="robotica-section-2 container-boxed">
        <div class="content">
            <h2>
                Acreditamos que a robótica vai<br />muito além da automação.
            </h2>
            <h3>
                A robótica industrial é a nova camada de inteligência que
                conecta máquinas, pessoas e dados para elevar produtividade,
                segurança e previsibilidade operacional.
            </h3>
            <p><b>Com a robótica aplicada, é possível:</b></p>
        </div>

        <div class="robotica-checklist">
            <div class="robotica-checklist-item">
                <Icon name="check" size={24} />
                <span
                    >Integração de robôs aos sistemas e à lógica da produção</span
                >
            </div>
            <div class="robotica-checklist-item">
                <Icon name="check" size={24} />
                <span
                    >Automação flexível para otimizar processos industriais
                    críticos</span
                >
            </div>
            <div class="robotica-checklist-item">
                <Icon name="check" size={24} />
                <span
                    >Inspeção autônoma em áreas de risco e operação contínua</span
                >
            </div>
            <div class="robotica-checklist-item">
                <Icon name="check" size={24} />
                <span
                    >Medição contínua de produtividade e desempenho operacional</span
                >
            </div>
        </div>
    </div>

    <div class="robotica-solucoes container-boxed">
        <div class="robotica-solucoes-header">
            <Badge text="Tecnologias" />
            <h2>
                <b>Soluções de robótica sob medida</b>
                <span>para cada ambiente industrial</span>
            </h2>
        </div>

        <div class="robotica-cards-container">
            <div class="robotica-card">
                <div class="robotica-card-content">
                    <h3>Robôs <b>humanoides</b></h3>
                    <p>
                        Aplicados em cenários que exigem mobilidade e interação
                        com ambientes humanos, preparando as fábricas para a
                        automação flexível do futuro.
                    </p>
                    <div class="card-checklist">
                        <div>
                            <Icon name="check" size={18} />
                            <span>Interação segura com pessoas e sistemas</span>
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span
                                >Execução de tarefas multiuso e reconfiguráveis</span
                            >
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span
                                >Apoio a atividades logísticas e de manutenção</span
                            >
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span
                                >Mobilidade avançada em diferentes terrenos</span
                            >
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span
                                >Preparação da planta para automação de próxima
                                geração</span
                            >
                        </div>
                    </div>
                </div>
                <div class="robotica-card-img-wrapper">
                    <video
                        src="/videos/robotica/humanoid.webm"
                        class="robotica-card-img"
                        autoplay
                        loop
                        muted
                        playsinline></video>
                </div>
            </div>

            <div class="robotica-card">
                <div class="robotica-card-content">
                    <h3>Robôs <b>quadrúpedes</b></h3>
                    <p>
                        Robôs quadrúpedes para inspeção e monitoramento
                        autônomo. Mobilidade e sensoriamento avançado para
                        ambientes industriais complexos, como:
                    </p>
                    <div class="card-checklist">
                        <div>
                            <Icon name="check" size={18} />
                            <span
                                >Inspeção autônoma de máquinas e áreas de risco</span
                            >
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span>Detecção de vazamentos de ar e gases</span>
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span
                                >Monitoramento de uso de EPIs por colaboradores</span
                            >
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span>Medição de temperatura, ruído e vibração</span
                            >
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span>Rondas autônomas de segurança</span>
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span>Coleta contínua de dados em campo</span>
                        </div>
                    </div>
                </div>
                <div class="robotica-card-img-wrapper">
                    <video
                        src="/videos/robotica/cachorro.webm"
                        class="robotica-card-img"
                        autoplay
                        loop
                        muted
                        playsinline></video>
                </div>
            </div>

            <div class="robotica-card">
                <div class="robotica-card-content">
                    <h3>Robôs colaborativos (<b>cobots</b>)</h3>
                    <p>
                        Os cobots são aplicados principalmente em processos que
                        exigem repetitividade, precisão e redução de esforço
                        físico, como:
                    </p>
                    <div class="card-checklist">
                        <div>
                            <Icon name="check" size={18} />
                            <span
                                >Paletização e despaletização automatizada</span
                            >
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span>Montagem e submontagem de componentes</span>
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span>Manuseio e transferência de peças</span>
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span>Embalagem e final de linha</span>
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span>Apoio direto a operadores humanos</span>
                        </div>
                        <div>
                            <Icon name="check" size={18} />
                            <span
                                >Padronização do processo e ganho de velocidade</span
                            >
                        </div>
                    </div>
                </div>
                <div class="robotica-card-img-wrapper">
                    <video
                        src="/videos/robotica/cobot.webm"
                        class="robotica-card-img"
                        autoplay
                        loop
                        muted
                        playsinline></video>
                </div>
            </div>
        </div>

        <div class="robotica-btn-container">
            <ButtonArrowAnimation text="Preciso desse serviço" />
        </div>
    </div>

    <div class="robotica-engenharia container-boxed">
        <div class="reng-header">
            <h2>
                Mais do que robôs.<br /><span
                    >Engenharia para operar em escala.</span
                >
            </h2>
        </div>

        <div class="reng-row">
            <div class="reng-media">
                <video
                    src="/videos/robotica/integração-total-com-fabrica.webm"
                    class="reng-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={IntegracaoTotalImg.src}></video>
            </div>
            <div class="reng-content">
                <h3>Integração <b>total</b> com a fábrica</h3>
                <p>
                    Cada robô opera como parte ativa do fluxo produtivo,
                    totalmente sincronizado com os sistemas das plantas
                    industriais existentes.
                </p>
                <ul class="reng-list">
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span>Sistemas de produção (MES)</span>
                    </li>
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span>Automação e supervisão (SCADA, CLPs)</span>
                    </li>
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span>Comunicação com redes industriais e IoT</span>
                    </li>
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span
                            >Integração com sistemas de qualidade e manutenção</span
                        >
                    </li>
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span
                            >Operação sincronizada aos processos e sistemas de
                            controle da fábrica</span
                        >
                    </li>
                </ul>
            </div>
        </div>

        <div class="reng-row">
            <div class="reng-content">
                <h3>Robótica <b>conectada a dados</b></h3>
                <p>
                    Dados operacionais em tempo real para decisões melhores. A
                    robótica passa a gerar visibilidade contínua sobre
                    desempenho, qualidade e eficiência.
                </p>
                <ul class="reng-list">
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span
                            >Monitoramento de produtividade e tempos de ciclo</span
                        >
                    </li>
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span>Registro de paradas, falhas e anomalias</span>
                    </li>
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span>Controle de qualidade em processo</span>
                    </li>
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span
                            >Coleta de condições operacionais e ambientais</span
                        >
                    </li>
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span>Integração com plataformas analíticas</span>
                    </li>
                </ul>
            </div>
            <div class="reng-media">
                <Image
                    src={RoboticaConectadaImg}
                    alt="Robótica conectada a dados"
                    class="reng-img"
                />
            </div>
        </div>

        <div class="reng-row">
            <div class="reng-media">
                <video
                    src="/videos/robotica/manutencao-preditiva-melhoria-continua.webm"
                    class="reng-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={ManutencaoPreditivaImg.src}></video>
            </div>
            <div class="reng-content">
                <h3>Manutenção <b>preditiva</b> e melhoria contínua</h3>
                <p>
                    Da automação à inteligência operacional, transformamos robôs
                    em sensores estratégicos para evoluir a operação
                    continuamente.
                </p>
                <ul class="reng-list">
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span>Redução de falhas inesperadas</span>
                    </li>
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span>Aumento da disponibilidade dos ativos</span>
                    </li>
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span>Otimização do uso de recursos</span>
                    </li>
                    <li>
                        <Icon name="arrow-right-2" class="reng-list-icon" />
                        <span>Melhoria contínua dos processos</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="robotica-parceria container">
        <div class="container-boxed">
            <div class="content">
                <h2>Pronto para elevar sua <b>automação a outro nível?</b></h2>
                <h3>
                    Traga os desafios da sua planta. Nós ajudamos a integrar
                    robótica, dados e processos para elevar produtividade,
                    segurança e eficiência.
                </h3>
                <span class="button">
                    <ButtonArrowWhite
                        text="Levar robótica para o meu negócio"
                    />
                </span>
            </div>

            <div class="parceiros-img-wrapper">
                <video
                    src="/videos/robotica/robotica-hero.webm"
                    class="parceiros-img"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={RoboticaHeroFallback.src}></video>
            </div>
        </div>
    </div>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("DOMContentLoaded", () => {
            let mm = gsap.matchMedia();

            mm.add("(min-width: 801px) and (max-width: 2399px)", () => {
                const tl = gsap.timeline({
                    scrollTrigger: {
                        trigger: ".hero",
                        start: "top top",
                        end: "+=60%",
                        scrub: 0.5,
                        pin: true,
                        snap: {
                            snapTo: [0, 1],
                            duration: { min: 0.2, max: 0.4 },
                            delay: 0.02,
                            ease: "power1.inOut",
                        },
                    },
                });

                tl.to(".hero .content", { opacity: 0, y: -100, duration: 1 })
                    .to(".arrow-down", { opacity: 0, duration: 0.2 }, "<")
                    .to(
                        ".hero .robotica-img-wrapper",
                        { y: "15vh", x: "22vw", scale: 0.75, duration: 1 },
                        "<",
                    )
                    .fromTo(
                        ".robotica-section-2",
                        { opacity: 0, marginTop: "5vh" },
                        { opacity: 1, marginTop: "-50vh", duration: 0.8 },
                        "-=0.8",
                    );
            });

            mm.add("(min-width: 2400px)", () => {
                const tl = gsap.timeline({
                    scrollTrigger: {
                        trigger: ".hero",
                        start: "top top",
                        end: "+=60%",
                        scrub: 0.5,
                        pin: true,
                        snap: {
                            snapTo: [0, 1],
                            duration: { min: 0.2, max: 0.4 },
                            delay: 0.02,
                            ease: "power1.inOut",
                        },
                    },
                });

                tl.to(".hero .content", { opacity: 0, y: -80, duration: 1 })
                    .to(".arrow-down", { opacity: 0, duration: 0.2 }, "<")
                    .to(
                        ".hero .robotica-img-wrapper",
                        { y: "10vh", x: "12vw", scale: 0.85, duration: 1 },
                        "<",
                    )
                    .fromTo(
                        ".robotica-section-2",
                        { opacity: 0, marginTop: "5vh" },
                        { opacity: 1, marginTop: "-40vh", duration: 0.8 },
                        "-=0.8",
                    );
            });

            mm.add("(max-width: 800px)", () => {
                const tlMobile = gsap.timeline({
                    scrollTrigger: {
                        trigger: ".hero",
                        start: "top top",
                        end: "+=50%",
                        scrub: 0.5,
                        pin: true,
                        snap: {
                            snapTo: [0, 1],
                            duration: { min: 0.2, max: 0.4 },
                            delay: 0.02,
                            ease: "power1.inOut",
                        },
                    },
                });

                tlMobile
                    .to(".hero .content", { opacity: 0, y: -50, duration: 1 })
                    .to(".arrow-down", { opacity: 0, duration: 0.2 }, "<")
                    .to(
                        ".hero .robotica-img-wrapper",
                        { y: "-10vh", duration: 1 },
                        "<",
                    )
                    .fromTo(
                        ".robotica-section-2",
                        { opacity: 0, marginTop: "5vh" },
                        { opacity: 1, marginTop: "-5vh", duration: 0.8 },
                        "-=0.8",
                    );
            });
        });
    </script>
</Layout>
